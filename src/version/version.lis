//
// Version information for capp-build.
//
// Version and Commit are package-level variables injected at release build
// time via go build -ldflags:
//
//   -X capp-build/version.Version=0.1.0-beta.1
//   -X capp-build/version.Commit=abc1234
//
// Local development builds (lis build / lis run) receive the defaults
// and report "dev".
//
// **

// Version is the semver release string from VERSION.txt.
// Default "dev" indicates a local build without ldflags injection.
pub var Version: string = "dev"

// Commit is the short git commit hash at build time.
// Empty for local development builds.
pub var Commit: string = ""

// info returns the formatted version string:
//   - Release builds:     "<version> (<commit>)"
//   - Development builds: "dev"
pub fn info() -> string {
  if !Commit.is_empty() {
    f"{Version} ({Commit})"
  } else {
    Version
  }
}
