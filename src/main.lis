//
// CLI entry point. Thin consumer of the build, verify, and smoke library packages.
// Wires the cobra command surface and delegates all logic to sub-packages.
//
// Command surface:
//   capp-build build [--mode debug|release|clean] [--http2]
//   capp-build verify root [path]
//   capp-build verify model
//   capp-build smoke cobra
//   capp-build smoke capp
//   capp-build smoke boundary
//   capp-build smoke all
//   capp-build version
//
// VERSION is a generated constant in src/version_generated.lis, written by
// `make emit` before lis emit runs.  Local builds report "dev".
//
// **
import "go:fmt"
import "go:github.com/spf13/cobra"
import "go:os"

import "build"
import "smoke"
import "verify"

// ---------------------------------------------------------------------------
// Shared cobra scaffolding
// ---------------------------------------------------------------------------

type RunFn = fn(Ref<cobra.Command>, Slice<string>) -> ()

fn no_args(cmd: Ref<cobra.Command>, args: Slice<string>) -> Result<(), error> {
  cobra.NoArgs(cmd, args)
}

fn noop_run(_cmd: Ref<cobra.Command>, _args: Slice<string>) {}

fn completion_options() -> cobra.CompletionOptions {
  cobra.CompletionOptions {
    DisableDefaultCmd: false,
    DisableNoDescFlag: false,
    DisableDescriptions: false,
    HiddenDefaultCmd: false,
    DefaultShellCompDirective: Some(cobra.ShellCompDirectiveDefault),
    ..,
  }
}

fn fparse_err_whitelist() -> cobra.FParseErrWhitelist {
  cobra.FParseErrWhitelist { UnknownFlags: false }
}

fn make_command(use: string, short: string, run: RunFn) -> mut cobra.Command {
  cobra.Command {
    Use: use,
    Short: short,
    Args: Some(no_args as cobra.PositionalArgs),
    Annotations: Some(Map.new<string, string>()),
    PersistentPreRun: Some(noop_run as RunFn),
    PersistentPreRunE: None,
    PreRun: Some(noop_run as RunFn),
    PreRunE: None,
    Run: Some(run),
    RunE: None,
    PostRun: Some(noop_run as RunFn),
    PostRunE: None,
    PersistentPostRun: Some(noop_run as RunFn),
    PersistentPostRunE: None,
    ValidArgsFunction: None,
    FParseErrWhitelist: fparse_err_whitelist(),
    CompletionOptions: completion_options(),
    SilenceErrors: true,
    SilenceUsage: true,
    SuggestionsMinimumDistance: 2,
    ..,
  }
}

fn make_command_with_args(
  use: string,
  short: string,
  run: RunFn,
) -> mut cobra.Command {
  cobra.Command {
    Use: use,
    Short: short,
    Annotations: Some(Map.new<string, string>()),
    PersistentPreRun: Some(noop_run as RunFn),
    PersistentPreRunE: None,
    PreRun: Some(noop_run as RunFn),
    PreRunE: None,
    Run: Some(run),
    RunE: None,
    PostRun: Some(noop_run as RunFn),
    PostRunE: None,
    PersistentPostRun: Some(noop_run as RunFn),
    PersistentPostRunE: None,
    ValidArgsFunction: None,
    FParseErrWhitelist: fparse_err_whitelist(),
    CompletionOptions: completion_options(),
    SilenceErrors: true,
    SilenceUsage: true,
    SuggestionsMinimumDistance: 2,
    ..,
  }
}

fn make_group(use: string, short: string) -> mut cobra.Command {
  cobra.Command {
    Use: use,
    Short: short,
    Args: Some(no_args as cobra.PositionalArgs),
    Annotations: Some(Map.new<string, string>()),
    PersistentPreRun: Some(noop_run as RunFn),
    PersistentPreRunE: None,
    PreRun: None,
    PreRunE: None,
    Run: None,
    RunE: None,
    PostRun: None,
    PostRunE: None,
    PersistentPostRun: Some(noop_run as RunFn),
    PersistentPostRunE: None,
    ValidArgsFunction: None,
    FParseErrWhitelist: fparse_err_whitelist(),
    CompletionOptions: completion_options(),
    SilenceErrors: true,
    SilenceUsage: true,
    SuggestionsMinimumDistance: 2,
    ..,
  }
}

// ---------------------------------------------------------------------------
// build command
// ---------------------------------------------------------------------------

fn do_run_build(source_root: string, mode_str: string, http2_flag: bool) {
  let mode = match mode_str {
    "release" => build.BuildMode.Release,
    "clean" => build.BuildMode.Clean,
    "debug" => build.BuildMode.Debug,
    _ => {
      fmt.Println(
        f"unknown mode '{mode_str}': must be debug, release, or clean",
      )
      return
    },
  }
  let delivery = if http2_flag {
    build.DeliveryContext.HTTP2
  } else {
    build.DeliveryContext.HTTP1
  }
  let cfg = build.BuildConfig { mode, delivery, source_root, grammar: "" }

  match build.build(cfg) {
    Ok(result) => {
      if !result.ok {
        let mut seen_files: mut Map<string, int> = Map.new<string, int>()
        let mut suppressed = 0

        for d in result.diags {
          if d.level == build.DiagLevel.Error {
            let key = d.file.unwrap_or("<unknown>")
            if seen_files[key] > 0 {
              suppressed += 1
            } else {
              seen_files[key] = 1
              let loc = match (d.file, d.line, d.col) {
                (Some(f), Some(l), Some(c)) => f"{f}:{l}:{c}",
                (Some(f), Some(l), None) => f"{f}:{l}",
                (Some(f), None, _) => f,
                _ => "<unknown>",
              }
              let _ = fmt.Println(f"  error: {loc}: {d.message}")
            }
          }
        }

        if suppressed > 0 {
          fmt.Println(
            f"  ({suppressed} further error(s) suppressed — first error per file shown)",
          )
        }

        fmt.Println(f"build failed: {result.message}")
        os.Exit(1)
      }

      fmt.Println(f"build success: {result.message}")
    },
    Err(e) => {
      fmt.Println(f"build error: {e}")
      os.Exit(1)
    },
  }
}

fn new_build_cmd() -> mut cobra.Command {
  let mut mode_str = "debug"
  let mut http2_flag = false

  let mut cmd = make_command_with_args(
    "build [path]",
    "Compile Objective-J source",
    |_cmd: Ref<cobra.Command>, args: Slice<string>| {
      let source_root = if !args.is_empty() { args[0] } else { "." }
      do_run_build(source_root, mode_str, http2_flag)
    },
  )
  cmd
    .Flags()
    .StringVar(&mode_str, "mode", "debug", "build mode: debug, release, clean")
  cmd
    .Flags()
    .BoolVar(
      &http2_flag,
      "http2",
      false,
      "target HTTP/2 delivery (default: HTTP/1.x)",
    )
  cmd
}

// ---------------------------------------------------------------------------
// version command
// ---------------------------------------------------------------------------

fn run_version(_cmd: Ref<cobra.Command>, _args: Slice<string>) {
  fmt.Println(f"capp-build {VERSION}")
}

fn new_version_cmd() -> mut cobra.Command {
  make_command("version", "Print version information", run_version)
}

// ---------------------------------------------------------------------------
// verify commands
// ---------------------------------------------------------------------------

fn run_verify_root(_cmd: Ref<cobra.Command>, args: Slice<string>) {
  let start = if !args.is_empty() { args[0] } else { "." }
  let result = verify.verify_root(start)
  let icon = if result.ok { "✓" } else { "✗" }
  fmt.Println(f"{icon}  {result.label}: {result.detail}")
}

fn run_verify_model(_cmd: Ref<cobra.Command>, _args: Slice<string>) {
  let results = verify.verify_model()
  let mut failures = 0
  for result in results {
    let icon = if result.ok { "✓" } else { "✗" }
    fmt.Println(f"{icon}  {result.label}: {result.detail}")
    if !result.ok { failures += 1 }
  }
  let total = results.length()
  if failures > 0 {
    fmt.Println(f"{failures} of {total} model checks failed")
  } else {
    fmt.Println(f"all {total} model checks passed")
  }
}

fn new_verify_cmd() -> mut cobra.Command {
  let mut verify_cmd = make_group(
    "verify",
    "Verify Cappuccino project structure",
  )
  let mut root_cmd = make_command_with_args(
    "root [path]",
    "Locate the project root",
    run_verify_root,
  )
  let mut model_cmd = make_command(
    "model",
    "Exercise the typed CST model against hand-built values",
    run_verify_model,
  )
  verify_cmd.AddCommand(&root_cmd)
  verify_cmd.AddCommand(&model_cmd)
  verify_cmd
}

// ---------------------------------------------------------------------------
// smoke commands
// ---------------------------------------------------------------------------

fn run_smoke_cobra(_cmd: Ref<cobra.Command>, _args: Slice<string>) {
  let result = smoke.smoke_cobra()
  let icon = if result.ok { "✓" } else { "✗" }
  fmt.Println(f"{icon}  {result.name}: {result.note}")
}

fn new_smoke_cmd() -> mut cobra.Command {
  let mut smoke_cmd = make_group("smoke", "Run interop smoke tests")
  let mut cobra_cmd = make_command(
    "cobra",
    "Smoke-test cobra interop",
    run_smoke_cobra,
  )

  let mut capp_grammar = ""
  let mut capp_cmd = make_command(
    "capp",
    "Smoke-test capp-parse interop",
    |_c: Ref<cobra.Command>, _args: Slice<string>| {
      let result = smoke.smoke_capp(capp_grammar)
      let icon = if result.ok { "✓" } else { "✗" }
      fmt.Println(f"{icon}  {result.name}: {result.note}")
    },
  )
  capp_cmd
    .Flags()
    .StringVar(&capp_grammar, "grammar", "", "explicit path to grammar dylib")

  let mut boundary_grammar = ""
  let mut boundary_cmd = make_command(
    "boundary",
    "Verify the capp-parse surface matches BoundaryVersion 2",
    |_c: Ref<cobra.Command>, _args: Slice<string>| {
      let result = smoke.smoke_boundary(boundary_grammar)
      let icon = if result.ok { "✓" } else { "✗" }
      fmt.Println(f"{icon}  {result.name}: {result.note}")
    },
  )
  boundary_cmd
    .Flags()
    .StringVar(
      &boundary_grammar,
      "grammar",
      "",
      "explicit path to grammar dylib",
    )

  let mut all_grammar = ""
  let mut all_cmd = make_command(
    "all",
    "Run all smoke tests",
    |_c: Ref<cobra.Command>, _args: Slice<string>| {
      smoke.smoke_all(all_grammar)
    },
  )
  all_cmd
    .Flags()
    .StringVar(&all_grammar, "grammar", "", "explicit path to grammar dylib")

  smoke_cmd.AddCommand(&cobra_cmd)
  smoke_cmd.AddCommand(&capp_cmd)
  smoke_cmd.AddCommand(&boundary_cmd)
  smoke_cmd.AddCommand(&all_cmd)
  smoke_cmd
}

// ---------------------------------------------------------------------------
// root and main
// ---------------------------------------------------------------------------

fn main() {
  let mut root = make_group("capp-build", "Cappuccino source compiler")
  let mut build_cmd = new_build_cmd()
  let mut version_cmd = new_version_cmd()
  let mut verify_cmd = new_verify_cmd()
  let mut smoke_cmd = new_smoke_cmd()
  root.AddCommand(&build_cmd)
  root.AddCommand(&version_cmd)
  root.AddCommand(&verify_cmd)
  root.AddCommand(&smoke_cmd)
  if let Err(e) = root.Execute() { fmt.Println(f"error: {e}") }
}
