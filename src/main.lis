import "go:fmt"
import "go:github.com/spf13/cobra"

fn no_args(cmd: Ref<cobra.Command>, args: Slice<string>) -> Result<(), error> {
  cobra.NoArgs(cmd, args)
}

fn no_valid_args(
  _cmd: Ref<cobra.Command>,
  _args: Slice<string>,
  _to_complete: string,
) -> (Slice<string>, cobra.ShellCompDirective) {
  ([], cobra.ShellCompDirectiveDefault)
}

fn noop_run(_cmd: Ref<cobra.Command>, _args: Slice<string>) {}

fn noop_run_e(_cmd: Ref<cobra.Command>, _args: Slice<string>) -> Result<(), error> {
  Ok(())
}

fn run_root(cmd: Ref<cobra.Command>, _args: Slice<string>) {
  cmd.Println("capp-build cobra smoke test")
}

fn run_build(cmd: Ref<cobra.Command>, _args: Slice<string>) {
  cmd.Println("build subcommand wired through cobra")
}

fn completion_options() -> cobra.CompletionOptions {
  cobra.CompletionOptions { 
    DisableDefaultCmd: false,
    DisableNoDescFlag: false,
    DisableDescriptions: false,
    HiddenDefaultCmd: false,
    DefaultShellCompDirective: Some(cobra.ShellCompDirectiveDefault),
    ..,
  }
}

fn fparse_err_whitelist() -> cobra.FParseErrWhitelist {
  cobra.FParseErrWhitelist { UnknownFlags: false }
}

fn make_command(
  use: string,
  short: string,
  run: fn(Ref<cobra.Command>, Slice<string>) -> (),
) -> cobra.Command {
  cobra.Command { 
    Use: use,
    Aliases: [],
    SuggestFor: [],
    Short: short,
    GroupID: "",
    Long: "",
    Example: "",
    ValidArgs: [],
    ValidArgsFunction: Some(no_valid_args),
    Args: Some(no_args as cobra.PositionalArgs),
    ArgAliases: [],
    BashCompletionFunction: "",
    Deprecated: "",
    Annotations: Map.new<string, string>(),
    Version: "",
    PersistentPreRun: Some(noop_run),
    PersistentPreRunE: Some(noop_run_e),
    PreRun: Some(noop_run),
    PreRunE: Some(noop_run_e),
    Run: Some(run),
    RunE: Some(noop_run_e),
    PostRun: Some(noop_run),
    PostRunE: Some(noop_run_e),
    PersistentPostRun: Some(noop_run),
    PersistentPostRunE: Some(noop_run_e),
    FParseErrWhitelist: fparse_err_whitelist(),
    CompletionOptions: completion_options(),
    TraverseChildren: false,
    Hidden: false,
    SilenceErrors: true,
    SilenceUsage: true,
    DisableFlagParsing: false,
    DisableAutoGenTag: false,
    DisableFlagsInUseLine: false,
    DisableSuggestions: false,
    SuggestionsMinimumDistance: 2,
    ..,
  }
}

fn main() {
  let mut root = make_command(
    "capp-build",
    "Cappuccino source compiler",
    run_root,
  )
  let build = make_command("build", "Smoke-test build subcommand", run_build)

  root.AddCommand(&build)

  match root.Execute() {
    Ok(_) => (),
    Err(e) => fmt.Println(f"error: {e}"),
  }
}
