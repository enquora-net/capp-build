//
// Phase 8: Compile
//
// Transforms each dependency-ordered Objective-J source file into a
// per-file static record: the @STATIC;1.0; format consumed by phase 9.
// Each record encodes the file's import declarations followed by its
// compiled JavaScript payload.
//
// Tier A (June 12): the JavaScript printer (js_print.lis) is wired in.
// The payload is the printed program behind the debug-mode prologue;
// ObjJ constructs route through js_print's named deferral diagnostics
// (tiers B–D), so JS-only files — main.j among them — are byte-exact
// against the legacy oracle, and files containing ObjJ constructs are
// explicitly incomplete.  Per PHASE-8-BRIEF.md decision 2 the records
// carry no S (source map) record.
//
// Record framing: lengths are UTF-16 code units, not bytes (June 12
// correction in STATIC-BLOB-FORMAT.md).  record_length counts code
// points, which equals code units for every character in the BMP;
// supplementary-plane characters would each need one more unit.  None
// exist in any observed corpus, and payload_oracle.py check would
// expose one immediately.  (Recorded decision.)
//
// Output: each record is also written under
// Build/capp-build.build/<Mode>/Sources/ inside the project, mirroring
// the legacy layout under a distinct directory name so the legacy
// Build/<project>.build oracle is never overwritten.  The tier gate is:
//
//   payload_oracle.py diff \
//     <project>/Build/<project>.build/Debug/Browser.environment/Sources/main.j \
//     <project>/Build/capp-build.build/Debug/Sources/main.j
//
// Deferred within phase 8 (unchanged): source maps (S records), release
// optimisations, HTTP/2 delivery, #if evaluation, Clean-mode artefact
// removal.
//
// **
import "go:errors"
import "go:fmt"
import "go:os"
import "go:path/filepath"
import "go:unicode/utf8"

// CompileOutput is the input to phase 9 (Archive).
// Each entry in `records` is a complete per-file static record string
// in @STATIC;1.0; format, paired with the source-relative filename
// used as the `p` record in the enclosing bundle.
pub struct CompileOutput {
  pub records: Slice<CompiledRecord>,
  pub diags: Slice<Diagnostic>,
}

pub struct CompiledRecord {
  pub name: string, // source-relative filename, e.g. "CPObject.j"
  pub record: string, // complete @STATIC;1.0;... per-file record (no e;)
}

pub fn run_compile(ctx: Ref<BuildContext>) -> Result<CompileOutput, error> {
  let phase = BuildPhase.Compile
  fmt.Println("  compile")
  let mut diags: Slice<Diagnostic> = []

  if let BuildMode.Clean = ctx.config.mode {
    diags = diags.append(diag_info(
      phase,
      "clean mode: artefact-directory removal deferred",
    ))
    return Ok(CompileOutput { records: [], diags })
  }

  let parsed = match ctx.parsed {
    Some(p) => p,
    None => return Err(errors.New("compile: parsed units unavailable")),
  }
  let sorted = match ctx.sorted {
    Some(s) => s,
    None => return Err(errors.New("compile: sorted units unavailable")),
  }

  // The "\n\n" prologue is the legacy compiler's debug-mode artifact,
  // emitted iff source maps are enabled (PHASE-8-BRIEF.md, emitter law).
  // Our first target is the debug form without the S record, so the
  // prologue stays; release payloads have none.
  let prologue = match ctx.config.mode {
    Debug => "\n\n",
    Release => "",
    Clean => "",
  }

  let mut records: Slice<CompiledRecord> = []
  for path in sorted.order {
    let mut found: Option<ParsedUnit> = None
    for unit in parsed.units {
      if unit.source.path == path { found = Some(unit) }
    }
    let Some(unit) = found else {
      diags = diags.append(diag_warn(
        phase,
        f"compile: no parsed unit for {path}; skipped",
      ))
      continue
    }

    let debug_dispatch = match ctx.config.mode {
      Debug => true,
      Release => false,
      Clean => false,
    }
    let printed = print_js_program(
      unit.program,
      path,
      ctx.symbols,
      debug_dispatch,
    )
    diags = merge_diags(diags, printed.diags)
    let payload = prologue + printed.text

    let mut record = "@STATIC;1.0;"
    for raw_import in unit.imports {
      match raw_import {
        Framework(framework, file_path, _, _) => {
          let full = f"{framework}/{file_path}"
          record += f"I;{record_length(full)};{full}"
        },
        Local(local_path, _, _) => {
          record += f"i;{record_length(local_path)};{local_path}"
        },
      }
    }
    record += f"t;{record_length(payload)};{payload}"

    records = records.append(
      CompiledRecord { name: record_name(ctx, path), record },
    )
  }

  write_records(ctx, records)?
  Ok(CompileOutput { records, diags })
}

// record_length is the record-framing length: UTF-16 code units, counted
// as code points (exact for the BMP; see the header note).
fn record_length(content: string) -> int {
  utf8.RuneCountInString(content)
}

// record_name is the source-relative filename used for the bundle `p`
// record and the on-disk output path.
fn record_name(ctx: Ref<BuildContext>, path: string) -> string {
  filepath.Rel(ctx.root.path, path).unwrap_or_else(|_| filepath.Base(path))
}

// write_records materialises the per-file records under
// Build/capp-build.build/<Mode>/Sources/, the comparison surface for
// payload_oracle.py.
fn write_records(ctx: Ref<BuildContext>, records: Slice<CompiledRecord>) -> Result<(), error> {
  let mode_dir = match ctx.config.mode {
    Debug => "Debug",
    Release => "Release",
    Clean => "Clean",
  }
  let out_dir = filepath.Join(
    ctx.root.path,
    "Build",
    "capp-build.build",
    mode_dir,
    "Sources",
  )
  for compiled in records {
    write_record_file(filepath.Join(out_dir, compiled.name), compiled.record)?
  }
  fmt.Println(f"✓  compile: {records.length()} per-file records → {out_dir}")
  Ok(())
}

// write_record_file writes one per-file record.  WriteString returns a
// partial result (bytes written and error); a short write is an error,
// and a write error takes precedence over a close error.
fn write_record_file(out_path: string, record: string) -> Result<(), error> {
  os.MkdirAll(filepath.Dir(out_path), os.ModePerm)?
  let file = os.Create(out_path)?
  let written = file.WriteString(record)
  let closed = file.Close()
  match written {
    Ok(_) => closed,
    Err(e) => Err(e),
    Both(_, e) => Err(e),
  }
}
