//
// Phase 1: ValidateProjectStructure
//
// Validates the project root and constructs a ValidatedProject — the primary
// project type carried through the remainder of the pipeline.
//
// ValidatedProject is a proof object: its presence in BuildContext.project
// guarantees that the project is structurally valid.  It unifies project
// identity (PlistMeta) with kind-specific structural evidence (ProjectDetails).
//
// Identity keys are completed before validation proceeds:
//
//   ensure_plist_meta        — resolves CPBundlePackageType to a typed
//                              ProjectKind (declared, inferred, or
//                              unrecognised) and reads CPBundleName and
//                              CPBundleIdentifier, deriving any the plist omits
//                              (name from the project directory, identifier
//                              from a placeholder organisation).  The derived
//                              keys are written back into Info.plist so the
//                              descriptor is complete on disk; the plist stays
//                              ground truth wherever it declares a value.
//
// Two typed constructors enforce the kind-specific structural contracts:
//
//   validate_framework_roots — constructs FrameworkRoots only when both
//                              Frameworks/Foundation and Frameworks/AppKit
//                              exist on disk
//
//   validate_application     — constructs ApplicationDetails, which requires
//                              FrameworkRoots plus main.j and index.html;
//                              its existence proves an Application project
//                              is ready for compilation
//
// The structural constructors return Result<T, Slice<string>>, accumulating
// all defects before returning so the developer sees the full picture.
// No mutable references are threaded through helper functions.
//
// Info.plist is mandatory for all supported project types.
//
// **
import "go:errors"
import "go:fmt"
import "go:os"
import "go:path/filepath"
import "go:strings"

pub struct ValidationResult {
  pub diags: Slice<Diagnostic>,
}

// infer_package_type determines the project kind when the Info.plist does not
// declare it.  Application is the only kind with a definite structural
// signature today, and the dominant case, so it is the result; framework and
// theme inference is deferred to iterative tightening, which will reintroduce
// the structural parameters it needs.  The plist remains ground truth when it
// declares a type — this is consulted only to fill an absent
// CPBundlePackageType.
fn infer_package_type() -> ProjectKind {
  ProjectKind.Application
}

// derived_name is the default CPBundleName: the project directory basename.
fn derived_name(root: string) -> string {
  filepath.Base(root)
}

// derived_identifier is the default CPBundleIdentifier: a reverse-DNS string
// from a placeholder organisation and the project name.  Metadata only;
// nothing downstream parses it.  Subject to iterative improvement.
fn derived_identifier(root: string) -> string {
  f"com.yourorganization.{filepath.Base(root)}"
}

// PlistPair is one derived key/value written into Info.plist.
struct PlistPair { key: string, value: string }

// plist_insert_keys inserts the given key/value pairs into the plist's root
// <dict>, immediately after its opening tag, and returns the new content.
// The hand scanner matches plist_string's level of sophistication; a real
// plist library replaces both when plist editing becomes broadly
// load-bearing.  Pairs whose value is empty are skipped.
fn plist_insert_keys(content: string, pairs: Slice<PlistPair>) -> string {
  let Some(dict_idx) = strings.Index(content, "<dict>") else {
    return content
  }
  let insert_at = dict_idx + "<dict>".length()
  let mut block = ""
  for pair in pairs {
    if pair.value.is_empty() { continue }
    block += f"\n\t<key>{pair.key}</key>\n\t<string>{pair.value}</string>"
  }
  if block.is_empty() { return content }
  content.substring(..insert_at) + block + content.substring(insert_at..)
}

// write_plist overwrites Info.plist with the completed content.  It mirrors
// phase 8's write_record_file: WriteString returns a Partial (bytes written
// and error), so a short write is an error and a write error takes precedence
// over a close error.
fn write_plist(plist_path: string, content: string) -> Result<(), error> {
  let file = os.Create(plist_path)?
  let written = file.WriteString(content)
  let closed = file.Close()
  match written {
    Ok(_) => closed,
    Err(e) => Err(e),
    Both(_, e) => Err(e),
  }
}

// ---------------------------------------------------------------------------
// Plist string extraction
// ---------------------------------------------------------------------------

// plist_string searches an XML plist for <key>key</key> and returns the
// immediately following <string>value</string>, or None if absent.
//
// strings.Index returns Option<int> in Lisette, eliminating Go's -1 sentinel.
// The ? operator propagates None through the chain idiomatically.
//
// Cappuccino plists are well-formed XML produced by the scaffolding tool or
// Xcode.  howett.net/plist will replace this scanner when plist inspection
// becomes more broadly load-bearing across the toolchain.
fn plist_string(content: string, key: string) -> Option<string> {
  let key_tag = f"<key>{key}</key>"
  let key_idx = strings.Index(content, key_tag)?
  let after_key = content.substring((key_idx + key_tag.length())..)
  let open_idx = strings.Index(after_key, "<string>")?
  let after_open = after_key.substring((open_idx + 8)..)
  let close_idx = strings.Index(after_open, "</string>")?
  Some(strings.TrimSpace(after_open.substring(..close_idx)))
}

// ---------------------------------------------------------------------------
// Typed constructors
// ---------------------------------------------------------------------------

// PlistFixup carries the outcome of completing the plist's identity keys:
// the resolved kind, the name and identifier, and the pairs derived to fill
// absent keys.  kind is a PackageTypeResolution because a declared but
// unrecognised CPBundlePackageType is a distinct outcome from a valid or an
// inferred one, and the caller matches all three exhaustively.
struct PlistFixup {
  kind: PackageTypeResolution,
  name: string,
  identifier: string,
  filled: Slice<PlistPair>,
}

// PackageTypeResolution is the outcome of resolving CPBundlePackageType.
//   Declared  — the plist named a recognised kind.
//   Inferred  — the plist omitted the key; the kind was inferred and filled.
//   Unknown   — the plist named a string that is not a recognised kind; the
//               raw value is carried for the diagnostic.
enum PackageTypeResolution {
  Declared(ProjectKind),
  Inferred(ProjectKind),
  Unknown(string),
}

// resolve_package_type reads CPBundlePackageType and classifies it: a
// recognised declaration is Declared, an absent key is inferred and recorded
// for fill, an unrecognised declaration is Unknown.  The plist stays ground
// truth wherever it declares a recognised kind — inference fills only an
// absent key, never overrides a declaration.
fn resolve_package_type(content: string) -> (PackageTypeResolution, Slice<PlistPair>) {
  plist_string(content, "CPBundlePackageType").map_or_else(
    || {
      let kind = infer_package_type()
      let pair = PlistPair { 
        key: "CPBundlePackageType",
        value: package_type_string(kind),
      }
      (PackageTypeResolution.Inferred(kind), [pair])
    },
    |declared| parse_package_type(declared).map_or_else(
      || (PackageTypeResolution.Unknown(declared), []),
      |kind| (PackageTypeResolution.Declared(kind), []),
    ),
  )
}

// ensure_plist_meta resolves the three identity keys, deriving a value for any
// the plist omits: CPBundlePackageType by resolve_package_type, CPBundleName
// from the project directory, CPBundleIdentifier from a placeholder
// organisation and the project name.  It returns the resolved kind, the name
// and identifier, and the pairs to write back; the caller writes them and
// records what it filled.
fn ensure_plist_meta(content: string, root: string) -> PlistFixup {
  let (kind, kind_filled) = resolve_package_type(content)
  let mut filled = kind_filled

  let name = plist_string(content, "CPBundleName").unwrap_or_else(|| {
    let derived = derived_name(root)
    filled = filled.append(PlistPair { key: "CPBundleName", value: derived })
    derived
  })
  let identifier = plist_string(content, "CPBundleIdentifier").unwrap_or_else(|| {
    let derived = derived_identifier(root)
    filled = filled.append(
      PlistPair { key: "CPBundleIdentifier", value: derived },
    )
    derived
  })

  PlistFixup { kind, name, identifier, filled }
}

// validate_framework_roots constructs FrameworkRoots for an Application project.
// FrameworkRoots can only be constructed in the branch where both paths exist.
// Returns Err with all missing-path messages when either is absent.
fn validate_framework_roots(root: string) -> Result<FrameworkRoots, Slice<string>> {
  let foundation = filepath.Join(root, "Frameworks", "Foundation")
  let app_kit = filepath.Join(root, "Frameworks", "AppKit")

  let fnd_ok = os.Stat(foundation).is_ok()
  let ak_ok = os.Stat(app_kit).is_ok()

  match (fnd_ok, ak_ok) {
    (true, true) => Ok(FrameworkRoots { foundation, app_kit }),
    _ => {
      let mut errs: Slice<string> = []
      if !fnd_ok {
        errs = errs.append(
          "Frameworks/Foundation not found — required for Application projects",
        )
      }
      if !ak_ok {
        errs = errs.append(
          "Frameworks/AppKit not found — required for Application projects",
        )
      }
      Err(errs)
    },
  }
}

// validate_application constructs ApplicationDetails for an Application project.
// ApplicationDetails can only be constructed when FrameworkRoots is valid AND
// the required entry points exist.  All defects are accumulated before
// returning so the developer sees the full picture.
// Returns Err with all missing-element messages when any are absent.
fn validate_application(root: string) -> Result<ApplicationDetails, Slice<string>> {
  let mut errs: Slice<string> = []

  let fwk = match validate_framework_roots(root) {
    Ok(f) => Some(f),
    Err(errs2) => {
      for e in errs2 {
        errs = errs.append(e)
      }
      None
    },
  }

  let main_ok = os.Stat(filepath.Join(root, "main.j")).is_ok()
  let idx_ok = os.Stat(filepath.Join(root, "index.html")).is_ok()

  if !main_ok {
    errs = errs.append("main.j not found — required for Application projects")
  }
  if !idx_ok {
    errs = errs.append(
      "index.html not found — required for Application projects",
    )
  }

  if !errs.is_empty() { return Err(errs) }

  // All checks passed.  fwk is guaranteed Some: the only path to None is
  // through validate_framework_roots returning Err, which populates errs
  // and is caught by the early return above.
  match fwk {
    Some(frameworks) => Ok(ApplicationDetails { frameworks }),
    None => Err(["internal: framework roots unavailable after clean validation"]),
  }
}

// ---------------------------------------------------------------------------
// Phase entry point
// ---------------------------------------------------------------------------

pub fn run_validate_project_structure(ctx: Ref<BuildContext>) -> Result<ValidationResult, error> {
  let phase = BuildPhase.ValidateProjectStructure
  let mut diags: Slice<Diagnostic> = []
  let root = ctx.root.path

  // Info.plist — mandatory entry condition for all supported project types
  let plist_path = filepath.Join(root, "Info.plist")
  if let Err(_) = os.Stat(plist_path) {
    diags = diags.append(diag_error(
      phase,
      "Info.plist not found — required for all Cappuccino projects",
    ))
    return finish_validation(root, diags)
  }

  let content = match os.ReadFile(plist_path) {
    Ok(data) => data as string,
    Err(e) => {
      diags = diags.append(diag_error(phase, f"Info.plist unreadable: {e}"))
      return finish_validation(root, diags)
    },
  }

  // Resolve identity keys, deriving and filling any the plist omits.  A plist
  // that already declares all three is read unchanged and nothing is written.
  let fixup = ensure_plist_meta(content, root)

  // Resolve the package type to a typed ProjectKind.  A recognised
  // declaration and an inferred kind both yield a kind; an unrecognised
  // declaration is the one error path — the plist named a string that is not
  // a kind, which inference must not silently override.
  let kind = match fixup.kind {
    Declared(k) => k,
    Inferred(k) => k,
    Unknown(raw) => {
      diags = diags.append(diag_error(
        phase,
        f"Info.plist: unrecognised CPBundlePackageType \"{raw}\" — expected APPL, FMWK, or THME",
      ))
      return finish_validation(root, diags)
    },
  }

  let meta = PlistMeta { 
    package_type: package_type_string(kind),
    name: fixup.name,
    identifier: fixup.identifier,
  }

  // Write derived keys back into Info.plist so the descriptor is complete on
  // disk, then record each fill.  A write failure is non-fatal: validation
  // proceeds on the in-memory meta, with the failure surfaced as a warning.
  if !fixup.filled.is_empty() {
    let updated = plist_insert_keys(content, fixup.filled)
    match write_plist(plist_path, updated) {
      Ok(_) => {
        for pair in fixup.filled {
          diags = diags.append(diag_info(
            phase,
            f"Info.plist: filled absent {pair.key} with derived value \"{pair.value}\"",
          ))
        }
      },
      Err(e) => {
        diags = diags.append(diag_warn(
          phase,
          f"Info.plist: could not write derived keys ({e}); proceeding with in-memory values",
        ))
      },
    }
  }

  // Select the ProjectDetails constructor for the kind.  The match is
  // exhaustive over ProjectKind with no catch-all: a new kind is a compile
  // error here until its structural contract is given.  Construction succeeds
  // only when the evidence for that kind is present.
  let details = match kind {
    Application => match validate_application(root) {
      Ok(app) => Some(ProjectDetails.Application(app)),
      Err(errs) => {
        for e in errs {
          diags = diags.append(diag_error(phase, e))
        }
        None
      },
    },
    Framework => Some(ProjectDetails.Framework),
    Theme => Some(ProjectDetails.Theme),
  }

  // Construct ValidatedProject only when both meta and details are present.
  // Its presence in BuildContext.project is the guarantee that the project
  // is structurally valid and the pipeline may proceed.
  if let Some(d) = details {
    ctx.project = Some(ValidatedProject { meta, details: d })
  }

  finish_validation(root, diags)
}

// finish_validation prints every accumulated diagnostic, then a success line
// only when no Error diagnostic is present.  Phases surface their own
// diagnostics (the orchestrator gates on them but does not print them); a
// validation Error here halts the pipeline via build()'s diagnostic gate.
fn finish_validation(root: string, diags: Slice<Diagnostic>) -> Result<ValidationResult, error> {
  let mut errors = 0
  for d in diags {
    print_validation_diag(d)
    if let DiagLevel.Error = d.level { errors += 1 }
  }
  if errors == 0 {
    fmt.Println(f"✓  validate: {root}")
  } else {
    fmt.Println(f"✗  validate: {errors} error(s) — project structure invalid")
  }
  Ok(ValidationResult { diags })
}

// print_validation_diag surfaces one validation diagnostic.  Validation
// diagnostics are project-level and carry no source position; the message
// is self-contained and includes corrective guidance.
fn print_validation_diag(d: Diagnostic) {
  fmt.Println(f"   {d.message}")
}
