//
// Phase 5: ResolveImports
//
// Classifies every @import directive by its syntactic form and builds the
// intra-project dependency graph through fixed-point iteration over
// quote-form imports.
//
// The angle-bracket / quote-form distinction is the definitive semantic
// boundary, corresponding directly to Objective-C's #import convention:
//
//   @import "AppController.j"          — quote form: local, intra-project
//   @import <Foundation/CPObject.j>    — angle-bracket form: external framework
//
// Quote-form imports resolve to absolute paths within the source tree and
// are added to the dependency graph as ImportEdges.  Fixed-point iteration
// follows them transitively until no new files are discovered.  The resulting
// edge set is the sole input to phase 6 (TopologicalSort).
//
// Angle-bracket imports are recorded as FrameworkDeps without any attempt at
// source resolution.  They are passed forward to phase 9 (Archive), which
// locates the corresponding pre-built .sj bundles and incorporates them into
// the output.  They never enter the dependency graph or the parse frontier.
//
// **
import "go:errors"
import "go:fmt"
import "go:github.com/enquora-net/capp-parse"
import "go:os"
import "go:path/filepath"
import "go:strings"

// ImportEdge represents a resolved quote-form dependency between two source
// files within the project.  Both from and to are absolute paths.
// line and col are the 1-based source position of the @import directive in
// from — the location an editor should open when reporting this dependency
// as the site of a build error (unresolvable import, cycle entry).
// The edge set feeds phase 6 (TopologicalSort).
pub struct ImportEdge {
  pub from: string,
  pub to: string,
  pub line: int, // 1-based line of @import in from
  pub col: int, // 1-based column of @import in from
}

// FrameworkDep records a single angle-bracket import.  The framework name
// and intra-framework path are preserved separately to allow phase 9 to
// locate the correct .sj bundle and, in future, to support type checking
// against framework headers.
// The dep set feeds phase 9 (Archive).
pub struct FrameworkDep {
  pub framework: string, // e.g. "Foundation"
  pub path: string, // e.g. "CPObject.j" or "Foundation.j"
}

// ImportGraph is the output of phase 5 and the input to phases 6 and 9.
//
//   edges         — quote-form dependencies; define compilation order
//   framework_deps — angle-bracket dependencies; define link-time inputs
pub struct ImportGraph {
  pub edges: Slice<ImportEdge>,
  pub framework_deps: Slice<FrameworkDep>,
  pub diags: Slice<Diagnostic>,
}

// LocalResolution makes import lookup outcomes explicit.  Missing carries the
// direct relative candidate path; Ambiguous carries the matching project files.
enum LocalResolution {
  Resolved(string),
  Missing(string),
  Ambiguous(Slice<string>),
}

// path_known returns true when target already appears in the known slice.
fn path_known(known: Slice<string>, target: string) -> bool {
  known.filter(|p| p == target).length() > 0
}

// dep_known returns true when dep already appears in the framework_deps slice.
fn dep_known(deps: Slice<FrameworkDep>, framework: string, path: string) -> bool {
  deps.filter(|d| d.framework == framework && d.path == path).length() > 0
}

// local_candidate returns the direct path searched for a quote-form import:
// the import text relative to the importing file.
fn local_candidate(path: string, from_path: string) -> string {
  filepath.Join(filepath.Dir(from_path), path)
}

// resolve_local resolves a quote-form import.  Direct importer-relative paths
// win.  If that fails, the project source tree is searched so nested code
// directories can resolve by source-relative path or unique basename.
fn resolve_local(
  path: string,
  from_path: string,
  root_path: string,
  tree: SourceTree,
) -> LocalResolution {
  let candidate = local_candidate(path, from_path)
  if os.Stat(candidate).is_ok() { return LocalResolution.Resolved(candidate) }

  let matches = source_tree_matches(path, root_path, tree)
  if matches.length() == 1 { return LocalResolution.Resolved(matches[0]) }
  if matches.length() > 1 { return LocalResolution.Ambiguous(matches) }
  LocalResolution.Missing(candidate)
}

fn source_tree_matches(
  path: string,
  root_path: string,
  tree: SourceTree,
) -> Slice<string> {
  let clean = filepath.Clean(path)
  let single_name = filepath.Dir(clean) == "."
  let mut matches: Slice<string> = []
  for file in tree.files {
    if is_parseable_source(file) {
      let rel = filepath.Rel(root_path, file.path).unwrap_or(file.path)
      if single_name {
        if filepath.Base(file.path) == clean {
          matches = matches.append(file.path)
        }
      } else if rel == clean { matches = matches.append(file.path) }
    }
  }
  matches
}

fn is_parseable_source(file: SourceFile) -> bool {
  match file.kind {
    SourceKind.ObjectiveJ | SourceKind.Javascript => true,
    _ => false,
  }
}

fn candidate_list(paths: Slice<string>) -> string {
  strings.Join(paths, ", ")
}

pub fn run_resolve_imports(
  ctx: mut Ref<BuildContext>,
) -> Result<ImportGraph, error> {
  let phase = BuildPhase.ResolveImports
  let mut diags: Slice<Diagnostic> = []
  let mut edges: Slice<ImportEdge> = []
  let mut framework_deps: Slice<FrameworkDep> = []

  let parsed = match ctx.parsed {
    Some(p) => p,
    None => return Err(errors.New("resolve imports: parsed units unavailable")),
  }
  let tree = match ctx.tree {
    Some(t) => t,
    None => return Err(errors.New("resolve imports: source tree unavailable")),
  }

  // known tracks absolute paths already in the graph to prevent re-parsing.
  let mut known: Slice<string> = []
  let mut all_units: Slice<ParsedUnit> = []
  for unit in parsed.units {
    known = known.append(unit.source.path)
    all_units = all_units.append(unit)
  }

  // frontier holds units whose quote-form imports have not yet been followed.
  let mut frontier: Slice<ParsedUnit> = []
  for u in parsed.units {
    frontier = frontier.append(ParsedUnit { imports: u.imports.clone(), ..u })
  }

  loop {
    if frontier.is_empty() { break }

    let mut new_paths: Slice<string> = []

    for unit in frontier {
      for imp in unit.imports {
        match imp {
          RawImport.Local(path, raw_line, raw_col) => {
            match resolve_local(path, unit.source.path, ctx.root.path, tree) {
              LocalResolution.Resolved(to_path) => {
                edges = edges.append(
                  ImportEdge {
                    from: unit.source.path,
                    to: to_path,
                    line: raw_line + 1,
                    col: raw_col + 1,
                  },
                )
                if !path_known(known, to_path) {
                  known = known.append(to_path)
                  new_paths = new_paths.append(to_path)
                }
              },
              LocalResolution.Missing(candidate) => {
                diags = diags.append(diag_error_at(
                  phase,
                  f"unresolvable import \"{path}\"; searched {candidate}",
                  unit.source.path,
                  raw_line,
                  raw_col,
                ))
              },
              LocalResolution.Ambiguous(candidates) => {
                diags = diags.append(diag_error_at(
                  phase,
                  f"ambiguous import \"{path}\"; candidates: {candidate_list(candidates)}",
                  unit.source.path,
                  raw_line,
                  raw_col,
                ))
              },
            }
          },

          RawImport.Framework(framework, path, _, _) => {
            if !dep_known(framework_deps, framework, path) {
              framework_deps = framework_deps.append(
                FrameworkDep { framework, path },
              )
            }
          },
        }
      }
    }

    if new_paths.is_empty() { break }

    let cfg = capp.ProjectConfig {
      Root: "",
      Paths: new_paths,
      Mode: capp.ModeAuto,
      GrammarPath: ctx.config.grammar,
      Workers: 0,
      ..,
    }

    let mut next_frontier: Slice<ParsedUnit> = []

    match capp.ParseProject(cfg) {
      Ok(pr) => {
        for file_opt in pr.Files {
          if let Some(file) = file_opt {
            let source = SourceFile {
              path: file.Path,
              kind: classify(file.Path),
            }
            if file.HasError() {
              for e in file.Errors {
                diags = diags.append(diag_error_at(
                  phase,
                  e.Message,
                  file.Path,
                  e.Row as int,
                  e.Column as int,
                ))
              }
              let parsed_unit = ParsedUnit { source, imports: [], .. }
              next_frontier = next_frontier.append(parsed_unit)
              all_units = all_units.append(parsed_unit)
            } else {
              let imports = extract_imports(file.Root())
              let lowered = lower_program(file.Root(), source)
              for d in lowered.diags {
                diags = diags.append(d)
              }
              let parsed_unit = ParsedUnit {
                source,
                imports,
                program: lowered.program,
              }
              next_frontier = next_frontier.append(parsed_unit)
              all_units = all_units.append(parsed_unit)
            }
          }
        }
        pr.Close()
      },
      Err(e) => {
        diags = diags.append(diag_error(phase, f"batch parse error: {e}"))
        break
      },
    }

    frontier = []
    for u in next_frontier {
      frontier = frontier.append(ParsedUnit { imports: u.imports.clone(), ..u })
    }
  }
  ctx.parsed = Some(ParsedUnits { units: all_units, diags: parsed.diags })

  fmt.Println(
    f"✓  resolve imports: {edges.length()} edges  {framework_deps.length()} framework deps",
  )

  Ok(ImportGraph { edges, framework_deps, diags })
}
