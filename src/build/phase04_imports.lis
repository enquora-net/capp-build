//
// Phase 4: ResolveImports
//
// Classifies every @import directive by its syntactic form and builds the
// intra-project dependency graph through fixed-point iteration over
// quote-form imports.
//
// The angle-bracket / quote-form distinction is the definitive semantic
// boundary, corresponding directly to Objective-C's #import convention:
//
//   @import "AppController.j"          — quote form: local, intra-project
//   @import <Foundation/CPObject.j>    — angle-bracket form: external framework
//
// Quote-form imports resolve to absolute paths within the source tree and
// are added to the dependency graph as ImportEdges.  Fixed-point iteration
// follows them transitively until no new files are discovered.  The resulting
// edge set is the sole input to phase 5 (TopologicalSort).
//
// Angle-bracket imports are recorded as FrameworkDeps without any attempt at
// source resolution.  They are passed forward to phase 8 (Archive), which
// locates the corresponding pre-built .sj bundles and incorporates them into
// the output.  They never enter the dependency graph or the parse frontier.
//
// **
import "go:errors"
import "go:fmt"
import "go:os"
import "go:path/filepath"
import "go:github.com/enquora-net/capp-parse"

// ImportEdge represents a resolved quote-form dependency between two source
// files within the project.  Both fields are absolute paths.
// The edge set feeds phase 5 (TopologicalSort).
pub struct ImportEdge {
  pub from: string,
  pub to:   string,
}

// FrameworkDep records a single angle-bracket import.  The framework name
// and intra-framework path are preserved separately to allow phase 8 to
// locate the correct .sj bundle and, in future, to support type checking
// against framework headers.
// The dep set feeds phase 8 (Archive).
pub struct FrameworkDep {
  pub framework: string,  // e.g. "Foundation"
  pub path:      string,  // e.g. "CPObject.j" or "Foundation.j"
}

// ImportGraph is the output of phase 4 and the input to phases 5 and 8.
//
//   edges         — quote-form dependencies; define compilation order
//   framework_deps — angle-bracket dependencies; define link-time inputs
pub struct ImportGraph {
  pub edges:          Slice<ImportEdge>,
  pub framework_deps: Slice<FrameworkDep>,
  pub diags:          Slice<Diagnostic>,
}

// path_known returns true when target already appears in the known slice.
fn path_known(known: Slice<string>, target: string) -> bool {
  known.filter(|p| p == target).length() > 0
}

// dep_known returns true when dep already appears in the framework_deps slice.
fn dep_known(deps: Slice<FrameworkDep>, framework: string, path: string) -> bool {
  deps.filter(|d| d.framework == framework && d.path == path).length() > 0
}

// resolve_local resolves a quote-form import path relative to the importing
// file and confirms the result exists on disk.
fn resolve_local(path: string, from_path: string) -> Option<string> {
  let candidate = filepath.Join(filepath.Dir(from_path), path)
  match os.Stat(candidate) {
    Ok(_)  => Some(candidate),
    Err(_) => None,
  }
}

pub fn run_resolve_imports(ctx: Ref<BuildContext>) -> Result<ImportGraph, error> {
  let phase = BuildPhase.ResolveImports
  let mut diags:         Slice<Diagnostic>  = []
  let mut edges:         Slice<ImportEdge>  = []
  let mut framework_deps: Slice<FrameworkDep> = []

  let parsed = match ctx.parsed {
    Some(p) => p,
    None    => return Err(errors.New("resolve imports: parsed units unavailable")),
  }

  // known tracks absolute paths already in the graph to prevent re-parsing.
  let mut known: Slice<string> = []
  for unit in parsed.units {
    known = known.append(unit.source.path)
  }

  // frontier holds units whose quote-form imports have not yet been followed.
  let mut frontier: Slice<ParsedUnit> = parsed.units

  loop {
    if frontier.length() == 0 { break }

    let mut new_paths: Slice<string> = []

    for unit in frontier {
      for imp in unit.imports {
        match imp {

          // Quote-form: local dependency.  Resolve on disk, add to the
          // dependency graph, and schedule for transitive discovery.
          RawImport.Local(path) => {
            match resolve_local(path, unit.source.path) {
              Some(to_path) => {
                edges = edges.append(ImportEdge { from: unit.source.path, to: to_path })
                if !path_known(known, to_path) {
                  known     = known.append(to_path)
                  new_paths = new_paths.append(to_path)
                }
              },
              None => {
                diags = diags.append(diag_error_at(
                  phase,
                  f"unresolvable import \"{path}\"",
                  unit.source.path,
                  0,
                ))
              },
            }
          },

          // Angle-bracket form: external framework dependency.  Record for
          // phase 8; do not resolve to source or enter the parse frontier.
          RawImport.Framework(framework, path) => {
            if !dep_known(framework_deps, framework, path) {
              framework_deps = framework_deps.append(
                FrameworkDep { framework: framework, path: path }
              )
            }
          },

        }
      }
    }

    if new_paths.length() == 0 { break }

    let cfg = capp.ProjectConfig {
      Root:        "",
      Paths:       new_paths,
      Mode:        capp.ModeAuto,
      GrammarPath: ctx.config.grammar,
      Workers:     0,
      ..
    }

    let mut next_frontier: Slice<ParsedUnit> = []

    match capp.ParseProject(cfg) {
      Ok(pr) => {
        for file_opt in pr.Files {
          match file_opt {
            None => (),
            Some(file) => {
              let imports = if file.HasError() {
                diags = diags.append(diag_error_at(
                  phase,
                  "parse error in transitively imported file",
                  file.Path,
                  0,
                ))
                []
              } else {
                extract_imports(file.Root())
              }
              let source = SourceFile { path: file.Path, kind: classify(file.Path) }
              next_frontier = next_frontier.append(
                ParsedUnit { source: source, imports: imports }
              )
            },
          }
        }
        pr.Close()
      },
      Err(e) => {
        diags = diags.append(diag_error(phase, f"batch parse error: {e}"))
        break
      },
    }

    frontier = next_frontier
  }

  fmt.Println(f"✓  resolve imports: {edges.length()} edges  {framework_deps.length()} framework deps")

  Ok(ImportGraph { edges: edges, framework_deps: framework_deps, diags: diags })
}
