//
// Phase 7: CodeGenerate
//
// Transforms the type-checked, dependency-ordered units into output
// artefacts.  The form of the output is governed by the build mode:
// per-file JavaScript with source maps (Debug), concatenated and minified
// output (Release), or artefact removal (Clean).
//
// **
import "go:fmt"

// Input to phase08.
pub struct CodeGenOutput {
  pub files: Slice<string>,
  pub diags: Slice<Diagnostic>,
}

// run_code_generate transforms the type-checked, dependency-ordered units
// into output artefacts.  The form of the output is governed by
// ctx.config.mode:
//
//   Debug:   per-file JavaScript with inline source maps
//   Release: concatenated, minified JavaScript with external source maps
//   Clean:   no output; artefact directories are removed
pub fn run_code_generate(_ctx: Ref<BuildContext>) -> Result<CodeGenOutput, error> {
  let phase = BuildPhase.CodeGenerate
  fmt.Println("  code generate")
  let mut diags: Slice<Diagnostic> = []
  let files: Slice<string> = []

  // TODO: iterate ctx.sorted.order and emit JavaScript for each source file
  //       in dependency order
  diags = diags.append(diag_info(phase, "TODO: emit JavaScript output in sorted order"))

  // TODO: in Debug mode, generate inline source maps relating emitted
  //       JavaScript back to the original Objective-J source locations
  diags = diags.append(diag_info(phase, "TODO: generate source maps in debug mode"))

  // TODO: in Release mode, apply dead-code elimination, constant folding,
  //       and identifier minification
  diags = diags.append(diag_info(phase, "TODO: apply optimisations in release mode"))

  // TODO: in Clean mode, enumerate and remove build artefact directories
  diags = diags.append(diag_info(phase, "TODO: remove artefact directories in clean mode"))

  Ok(CodeGenOutput { files: files, diags: diags })
}
