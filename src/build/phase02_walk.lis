//
// Phase 2: WalkSourceTree
//
// Traverses the project directory, classifies every file by its role in the
// build pipeline, and produces the SourceTree consumed by all downstream phases.
//
// **
import "go:fmt"
import "go:github.com/enquora-net/capp-parse"
import "go:path/filepath"
import "go:strings"

// The classification drives which downstream phases consume the file:
// ObjectiveJ and Javascript are parsed; InterfaceBuilder compiled separately;
// graphics and resources are copied to the output.
pub enum SourceKind {
  ObjectiveJ,
  Javascript,
  InterfaceBuilder,
  Graphic,
  Resource,
}

pub struct SourceFile {
  pub path: string,
  pub kind: SourceKind,
}

// Downstream phases index into this rather than re-walking the filesystem.
pub struct SourceTree {
  pub files: Slice<SourceFile>,
  pub diags: Slice<Diagnostic>,
}

// classify returns the SourceKind for a file based on its extension.
fn classify(path: string) -> SourceKind {
  match strings.ToLower(filepath.Ext(path)) {
    ".j" => SourceKind.ObjectiveJ,
    ".sj" => SourceKind.ObjectiveJ,
    ".js" => SourceKind.Javascript,
    ".xib" => SourceKind.InterfaceBuilder,
    ".png" => SourceKind.Graphic,
    ".jpg" => SourceKind.Graphic,
    ".jpeg" => SourceKind.Graphic,
    ".svg" => SourceKind.Graphic,
    ".icns" => SourceKind.Graphic,
    ".tiff" => SourceKind.Graphic,
    ".gif" => SourceKind.Graphic,
    _ => SourceKind.Resource,
  }
}

// run_walk_source_tree traverses the source tree rooted at ctx.root.path,
// classifying each encountered file by its SourceKind and collecting the
// results into a SourceTree.
//
// Excluded from the walk:
//   Frameworks/          — framework source is consumed via import resolution only
//   Build/               — build artefact output directories
//   *.environment/       — compiled Cappuccino runtime bundle directories
//   .cappuccino/         — toolchain metadata directory
pub fn run_walk_source_tree(ctx: Ref<BuildContext>) -> Result<SourceTree, error> {
  let diags: Slice<Diagnostic> = []

  // Excluded directory names.  Cappuccino's convention capitalises the build
  // output directory (Build/Debug/..., as produced by jake and by phase 9),
  // so the skip entry must match that casing.  Frameworks/ is consumed via
  // import resolution only.  The *.environment entries exclude compiled
  // static-bundle directories such as AppKit/ObjJ.environment/AppKit.sj.
  //
  // NOTE: capp.SourcePaths matches these names against directory names as it
  // walks; if that match is case-sensitive (a capp-parse internal), a project
  // using a differently-cased output dir would leak through.  Author note for
  // capp-parse: case-insensitive skip matching would make this robust.
  let skip = [
    "Frameworks",
    "Build",
    "ObjJ.environment",
    "Browser.environment",
    "CommonJS.environment",
    ".cappuccino",
  ]
  let paths = capp.SourcePaths(ctx.root.path, capp.ModeAuto, skip)?

  let mut files: Slice<SourceFile> = []
  for path in paths {
    files = files.append(SourceFile { path, kind: classify(path) })
  }

  let objj_count = files
    .filter(|f| {
      match f.kind {
        SourceKind.ObjectiveJ => true,
        _ => false,
      }
    })
    .length()

  fmt.Println(
    f"✓  walk source tree: {files.length()} files ({objj_count} Objective-J)",
  )

  Ok(SourceTree { files, diags })
}
