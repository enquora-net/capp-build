//
// Phase 7: Compile
//
// Transforms each dependency-ordered Objective-J source file into a
// per-file static record: the @STATIC;1.0; format consumed by phase 8.
// Each record encodes the file's import declarations followed by its
// compiled JavaScript payload.
//
// The form of the JavaScript payload is governed by the build mode:
//
//   Debug:   compiled JavaScript with an S (source map) record per file
//   Release: compiled JavaScript, no source maps
//   Clean:   no output; artefact directories are removed
//
// During the bootstrap period this phase is satisfied externally: the
// existing jake toolchain produces the per-file static records manually.
// The native Objective-J to JavaScript compiler will replace that process
// when complete, without structural change to this phase or phase 8.
//
// **
import "go:fmt"

// CompileOutput is the input to phase 8 (Archive).
// Each entry in `records` is a complete per-file static record string
// in @STATIC;1.0; format, paired with the source-relative filename
// used as the `p` record in the enclosing bundle.
pub struct CompileOutput {
  pub records: Slice<CompiledRecord>,
  pub diags:   Slice<Diagnostic>,
}

pub struct CompiledRecord {
  pub name:   string,  // source-relative filename, e.g. "CPObject.j"
  pub record: string,  // complete @STATIC;1.0;...e; per-file record
}

pub fn run_compile(_ctx: Ref<BuildContext>) -> Result<CompileOutput, error> {
  let phase = BuildPhase.Compile
  fmt.Println("  compile")
  let mut diags: Slice<Diagnostic> = []
  let records: Slice<CompiledRecord> = []

  // TODO: iterate ctx.sorted.order and compile each source file in
  //       dependency order, producing one CompiledRecord per file
  diags = diags.append(diag_info(phase, "TODO: compile each source file to a per-file static record"))

  // TODO: in Debug mode, include an S record (base64 source map) in
  //       each per-file static record
  diags = diags.append(diag_info(phase, "TODO: include source map S records in debug mode"))

  // TODO: in Release mode, apply dead-code elimination, constant folding,
  //       and identifier minification to each JavaScript payload
  diags = diags.append(diag_info(phase, "TODO: apply optimisations in release mode"))

  // TODO: in Clean mode, enumerate and remove build artefact directories
  diags = diags.append(diag_info(phase, "TODO: remove artefact directories in clean mode"))

  Ok(CompileOutput { records: records, diags: diags })
}
