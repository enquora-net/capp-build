// build/lower.lis
// capp-build
//
// Created by David Richardson on Thursday, May 29, 2026.
// Copyright (c) 2026 David Richardson. All rights reserved.
//
// Lowering — the single pass that converts capp-parse's untyped CSTNode tree
// into the typed AST declared in cst.lis.
//
// This is the ONLY module permitted to inspect raw node kinds and field names.
// Dispatch here is necessarily string-domain: the CST discriminates nodes by
// node.Kind() (a string) and addresses fields by name (a string), because
// tree-sitter erases the grammar's closed node-kind set to strings at the C
// boundary.  Every consumer above this module pattern-matches over closed
// Lisette sum types with compiler-checked exhaustiveness; this module is the
// firebreak that converts strings into those types exactly once.  Kind and
// field strings come exclusively from capp-parse's constant surface, so a
// mistyped name is a compile error rather than a silent dispatch miss.
//
// Because the dispatch is not exhaustiveness-checked by the compiler, every
// dispatch carries a catch-all arm that records an unhandled node kind as a
// diagnostic rather than silently dropping it.  An unhandled kind is a
// coverage gap, surfaced, not a silent omission.
//
// Diagnostic discipline: lowering is purely functional.  Each helper RETURNS
// its diagnostics alongside its result; callers merge.  No shared mutable
// accumulator is threaded by reference.  The Lowering struct carries only the
// file path, read-only, so diagnostics attribute to the right file without
// threading a parameter through every signature.
//
// Wrapper nodes: several visible choice rules (objj_implementation_member,
// objj_instance_variable, objj_message_selector, objj_selector_identifier,
// objj_type) produce a wrapper node whose single meaning is its first named
// child; the corresponding helpers dispatch on that child.  This is grammar
// fact, confirmed against node-types.json, not convention.
//
// Coverage: the full JavaScript statement and expression surface, the
// Objective-J declarations (@import, @class, @global, @typedef, @protocol,
// class implementations and categories, methods, ivars with @accessors),
// the Objective-J expression literals (@"", @[], @{}, @selector, @ref,
// @deref) and message sends, and the preprocessor #if grammar.  Every
// dispatch that meets a node kind it does not implement records a named
// unhandled diagnostic rather than dropping it.
//
// Deferred behind visible diagnostics: the destructuring tier (object and
// array patterns in declarators, parameters, for-in bindings, and catch
// parameters), and template / optional-chain calls.
//
// **
import "go:github.com/enquora-net/capp-parse"
import "go:strings"

// ---------------------------------------------------------------------------
// Lowering result
// ---------------------------------------------------------------------------

// LoweredUnit pairs a file's typed AST root with any diagnostics raised while
// lowering it.  Diagnostics here are non-fatal: an unhandled or malformed node
// is recorded and lowering continues, so a single file yields one Program plus
// a complete list of what could not be lowered, rather than aborting at the
// first gap.
pub struct LoweredUnit {
  pub source: SourceFile,
  pub program: Program,
  pub diags: Slice<Diagnostic>,
}

// ---------------------------------------------------------------------------
// Module-level helpers (pure, no diagnostics)
// ---------------------------------------------------------------------------

// node_pos captures a node's 0-based start position.  Every lowered node's
// `pos` field is filled from here, so the 0-based convention is applied in
// exactly one place.  StartRow/StartColumn are uint32 (tree-sitter); cast once.
fn node_pos(node: capp.CSTNode) -> Position {
  Position { row: node.StartRow() as int, col: node.StartColumn() as int }
}

fn ident_of(node: capp.CSTNode) -> Identifier {
  Identifier { text: node.Text(), pos: node_pos(node) }
}

// selector_ident_of lowers an objj_selector_identifier wrapper.  The wrapper
// holds a single identifier child (the grammar aliases reserved words to
// identifier in selector position); Text() of the wrapper is that identifier's
// text, so no descent is needed.
fn selector_ident_of(node: capp.CSTNode) -> ObjjSelectorIdentifier {
  ObjjSelectorIdentifier { text: node.Text(), pos: node_pos(node) }
}

// has_anonymous_child reports whether node has a direct anonymous child of the
// given kind.  Anonymous tokens report their literal text as their kind, so
// this detects optional keywords ("async") and markers ("...").
fn has_anonymous_child(node: capp.CSTNode, kind: string) -> bool {
  for i in 0..node.ChildCount() {
    if node.Child(i).Kind() == kind { return true }
  }
  false
}

// skippable reports node kinds that are grammar extras and carry no AST
// content.  Comments are named nodes and so appear in named-child iteration;
// every structural loop consults this.  (html_comment is declared in the
// grammar's externals for scanner ABI compatibility but appears in no rule;
// the parser cannot produce it, so it is not checked here.)
fn skippable(kind: string) -> bool {
  kind == capp.NodeKindComment
}

fn merge_diags(into: Slice<Diagnostic>, from: Slice<Diagnostic>) -> Slice<Diagnostic> {
  let mut out = into.clone()
  for d in from {
    out = out.append(d)
  }
  out
}

// ---------------------------------------------------------------------------
// Entry point
// ---------------------------------------------------------------------------

// lower_program lowers the grammar root:
//   program: seq(optional(hash_bang_line), repeat(statement))
pub fn lower_program(root: capp.CSTNode, source: SourceFile) -> LoweredUnit {
  let lowering = Lowering { path: source.path }
  let mut diags: Slice<Diagnostic> = []
  let mut hash_bang: Option<HashBangLine> = None
  let mut body: Slice<Statement> = []

  for i in 0..root.NamedChildCount() {
    let child = root.NamedChild(i)
    let kind = child.Kind()

    if kind == capp.NodeKindHashBangLine {
      hash_bang = Some(
        HashBangLine { text: child.Text(), pos: node_pos(child) },
      )
    } else if skippable(kind) {
      ()
    } else {
      let (stmt_opt, stmt_diags) = lowering.statement(child)
      diags = merge_diags(diags, stmt_diags)
      if let Some(stmt) = stmt_opt { body = body.append(stmt) } // unhandled or malformed; diagnostic already recorded
    }
  }

  LoweredUnit { 
    source,
    program: Program { hash_bang, body, pos: node_pos(root) },
    diags,
  }
}

// ---------------------------------------------------------------------------
// Lowering context
// ---------------------------------------------------------------------------

// Lowering carries the read-only file path for diagnostic attribution.  All
// methods are pure functions of their node; none mutate shared state.
struct Lowering { path: string }

impl Lowering {
  // unhandled records a coverage gap: a node reached by a dispatch with no
  // implementing arm.  `what` names the dispatch site, so the diagnostic reads
  // "unhandled statement kind 'with_statement'" rather than a bare kind.
  fn unhandled(self, node: capp.CSTNode, what: string, kind: string) -> Slice<Diagnostic> {
    let pos = node_pos(node)
    [
      diag_warn_at(
        BuildPhase.BuildSymbolTable,
        f"lowering: unhandled {what} kind '{kind}'",
        self.path,
        pos.row,
        pos.col,
      ),
    ]
  }

  // malformed records a node that matched a handled kind but lacked a
  // component the grammar marks required.  Reaching this implies a parser or
  // lowering defect, not a user error; it is surfaced rather than asserted.
  fn malformed(self, node: capp.CSTNode, what: string) -> Slice<Diagnostic> {
    let pos = node_pos(node)
    [
      diag_warn_at(
        BuildPhase.BuildSymbolTable,
        f"lowering: malformed {what}",
        self.path,
        pos.row,
        pos.col,
      ),
    ]
  }

  // -------------------------------------------------------------------------
  // Statements
  // -------------------------------------------------------------------------

  fn statement(self, node: capp.CSTNode) -> (Option<Statement>, Slice<Diagnostic>) {
    let kind = node.Kind()
    let pos = node_pos(node)

    if kind == capp.NodeKindObjjImport { return self.objj_import(node) }
    if kind == capp.NodeKindFunctionDeclaration {
      let (decl_opt, diags) = self.function_declaration(node)
      let Some(decl) = decl_opt else {
        return (None, diags)
      }
      return (Some(Statement.Declaration(Declaration.Function(decl))), diags)
    }
    if kind == capp.NodeKindObjjClassImplementation {
      return self.class_implementation(node)
    }
    if kind == capp.NodeKindExpressionStatement {
      return self.expression_statement(node)
    }
    if kind == capp.NodeKindEmptyStatement {
      return (Some(Statement.Empty(EmptyStatement { pos })), [])
    }
    if kind == capp.NodeKindDebuggerStatement {
      return (Some(Statement.Debugger(DebuggerStatement { pos })), [])
    }
    if kind == capp.NodeKindReturnStatement {
      return self.return_statement(node)
    }
    if kind == capp.NodeKindIfStatement { return self.if_statement(node) }
    if kind == capp.NodeKindVariableDeclaration {
      let (decl_opt, diags) = self.variable_declaration(node)
      let Some(decl) = decl_opt else {
        return (None, diags)
      }
      return (Some(Statement.Declaration(Declaration.Variable(decl))), diags)
    }
    if kind == capp.NodeKindLexicalDeclaration {
      let (decl_opt, diags) = self.lexical_declaration(node)
      let Some(decl) = decl_opt else {
        return (None, diags)
      }
      return (Some(Statement.Declaration(Declaration.Lexical(decl))), diags)
    }
    if kind == capp.NodeKindForStatement { return self.for_statement(node) }
    if kind == capp.NodeKindWhileStatement { return self.while_statement(node) }
    if kind == capp.NodeKindSwitchStatement {
      return self.switch_statement(node)
    }
    if kind == capp.NodeKindForInStatement {
      return self.for_in_statement(node)
    }
    if kind == capp.NodeKindTryStatement { return self.try_statement(node) }
    if kind == capp.NodeKindDoStatement { return self.do_statement(node) }
    if kind == capp.NodeKindThrowStatement { return self.throw_statement(node) }
    if kind == capp.NodeKindWithStatement { return self.with_statement(node) }
    if kind == capp.NodeKindStatementBlock {
      let (block, diags) = self.statement_block(node)
      return (Some(Statement.BlockScope(block)), diags)
    }
    if kind == capp.NodeKindBreakStatement {
      let label = node.ChildByFieldName(capp.FieldLabel).map(ident_of)
      return (Some(Statement.Break(BreakStatement { label, pos })), [])
    }
    if kind == capp.NodeKindContinueStatement {
      let label = node.ChildByFieldName(capp.FieldLabel).map(ident_of)
      return (Some(Statement.Continue(ContinueStatement { label, pos })), [])
    }
    if kind == capp.NodeKindLabeledStatement {
      return self.labeled_statement(node)
    }
    if kind == capp.NodeKindObjjClassForwardDeclaration {
      return self.objj_class_forward_declaration(node)
    }
    if kind == capp.NodeKindObjjGlobalDeclaration {
      return self.objj_global_declaration(node)
    }
    if kind == capp.NodeKindObjjTypedef { return self.objj_typedef(node) }
    if kind == capp.NodeKindObjjProtocolDeclaration {
      return self.objj_protocol_declaration(node)
    }
    if kind == capp.NodeKindPreprocIfBlock {
      let (block_opt, diags) = self.preproc_if_block_struct(node)
      let Some(block) = block_opt else {
        return (None, diags)
      }
      return (Some(Statement.PreprocIf(block)), diags)
    }
    if kind == capp.NodeKindPreprocDirective {
      let directive = PreprocDirective { text: node.Text(), pos }
      return (Some(Statement.PreprocDirective(directive)), [])
    }

    (None, self.unhandled(node, "statement", kind))
  }

  fn objj_import(self, node: capp.CSTNode) -> (Option<Statement>, Slice<Diagnostic>) {
    let pos = node_pos(node)
    match node.ChildByFieldName(capp.FieldPath) {
      None => (None, self.malformed(node, "@import without path")),
      Some(path_node) => {
        let path_kind = path_node.Kind()
        if path_kind == capp.NodeKindSystemLibString {
          let lib = SystemLibString { 
            text: path_node.Text(),
            pos: node_pos(path_node),
          }
          let directive = ObjjImport { path: ObjjImportPath.System(lib), pos }
          return (Some(Statement.ObjjImport(directive)), [])
        }
        if path_kind == capp.NodeKindString {
          let (value, diags) = self.string_literal(path_node)
          let directive = ObjjImport { path: ObjjImportPath.Local(value), pos }
          return (Some(Statement.ObjjImport(directive)), diags)
        }
        (None, self.unhandled(path_node, "import path", path_kind))
      },
    }
  }

  fn expression_statement(self, node: capp.CSTNode) -> (Option<Statement>, Slice<Diagnostic>) {
    let pos = node_pos(node)
    // expression_statement holds exactly one named child: an expression or a
    // sequence_expression (the _expressions hidden choice).
    for i in 0..node.NamedChildCount() {
      let child = node.NamedChild(i)
      if skippable(child.Kind()) { continue }
      let (exprs_opt, diags) = self.expressions(child)
      let Some(exprs) = exprs_opt else {
        return (None, diags)
      }
      return (
        Some(Statement.Expression(
          ExpressionStatement { expression: &exprs, pos },
        )),
        diags,
      )
    }
    (None, self.malformed(node, "expression statement without expression"))
  }

  fn return_statement(self, node: capp.CSTNode) -> (Option<Statement>, Slice<Diagnostic>) {
    let pos = node_pos(node)
    let mut value: Option<Expressions> = None
    let mut diags: Slice<Diagnostic> = []
    for i in 0..node.NamedChildCount() {
      let child = node.NamedChild(i)
      if skippable(child.Kind()) { continue }
      let (exprs_opt, ds) = self.expressions(child)
      diags = merge_diags(diags, ds)
      if let Some(v) = exprs_opt { value = Some(v) } else { value = None }
      break
    }
    (Some(Statement.Return(ReturnStatement { value, pos })), diags)
  }

  fn statement_block(self, node: capp.CSTNode) -> (StatementBlock, Slice<Diagnostic>) {
    let mut body: Slice<Statement> = []
    let mut diags: Slice<Diagnostic> = []
    for i in 0..node.NamedChildCount() {
      let child = node.NamedChild(i)
      if skippable(child.Kind()) { continue }
      let (stmt_opt, ds) = self.statement(child)
      diags = merge_diags(diags, ds)
      if let Some(stmt) = stmt_opt { body = body.append(stmt) }
    }
    (StatementBlock { body, pos: node_pos(node) }, diags)
  }

  // -------------------------------------------------------------------------
  // Statements — control flow
  // -------------------------------------------------------------------------

  // paren_field lowers a required parenthesized_expression field — the
  // header shape shared by if/while/do/switch/with.  `what` names the
  // absence for the malformed diagnostic.
  fn paren_field(self, node: capp.CSTNode, field: string, what: string) -> (Option<ParenthesizedExpression>, Slice<Diagnostic>) {
    node
      .ChildByFieldName(field)
      .map_or_else(
        || (None, self.malformed(node, what)),
        |child| self.parenthesized(child),
      )
  }

  // statement_field lowers a required statement-valued field — loop and
  // clause bodies.
  fn statement_field(self, node: capp.CSTNode, field: string, what: string) -> (Option<Statement>, Slice<Diagnostic>) {
    node
      .ChildByFieldName(field)
      .map_or_else(
        || (None, self.malformed(node, what)),
        |child| self.statement(child),
      )
  }

  fn if_statement(self, node: capp.CSTNode) -> (Option<Statement>, Slice<Diagnostic>) {
    let pos = node_pos(node)
    let mut diags: Slice<Diagnostic> = []

    let (condition_opt, condition_diags) = self.paren_field(
      node,
      capp.FieldCondition,
      "if without condition",
    )
    diags = merge_diags(diags, condition_diags)
    let Some(condition) = condition_opt else {
      return (None, diags)
    }

    let (consequence_opt, consequence_diags) = self.statement_field(
      node,
      capp.FieldConsequence,
      "if without consequence",
    )
    diags = merge_diags(diags, consequence_diags)
    let Some(consequence) = consequence_opt else {
      return (None, diags)
    }

    let mut alternative: Option<ElseClause> = None
    if let Some(else_node) = node.ChildByFieldName(capp.FieldAlternative) {
      let (else_opt, else_diags) = self.else_clause(else_node)
      diags = merge_diags(diags, else_diags)
      alternative = else_opt
    }

    let lowered = IfStatement { 
      condition,
      consequence: &consequence,
      alternative,
      pos,
    }
    (Some(Statement.If(lowered)), diags)
  }

  // else_clause holds its statement as the single unfielded named child.
  fn else_clause(self, node: capp.CSTNode) -> (Option<ElseClause>, Slice<Diagnostic>) {
    let pos = node_pos(node)
    for i in 0..node.NamedChildCount() {
      let child = node.NamedChild(i)
      if skippable(child.Kind()) { continue }
      let (stmt_opt, diags) = self.statement(child)
      let Some(stmt) = stmt_opt else {
        return (None, diags)
      }
      return (Some(ElseClause { body: &stmt, pos }), diags)
    }
    (None, self.malformed(node, "else without body"))
  }

  fn while_statement(self, node: capp.CSTNode) -> (Option<Statement>, Slice<Diagnostic>) {
    let pos = node_pos(node)
    let mut diags: Slice<Diagnostic> = []

    let (condition_opt, condition_diags) = self.paren_field(
      node,
      capp.FieldCondition,
      "while without condition",
    )
    diags = merge_diags(diags, condition_diags)
    let Some(condition) = condition_opt else {
      return (None, diags)
    }

    let (body_opt, body_diags) = self.statement_field(
      node,
      capp.FieldBody,
      "while without body",
    )
    diags = merge_diags(diags, body_diags)
    let Some(body) = body_opt else {
      return (None, diags)
    }

    let lowered = WhileStatement { condition, body: &body, pos }
    (Some(Statement.While(lowered)), diags)
  }

  fn do_statement(self, node: capp.CSTNode) -> (Option<Statement>, Slice<Diagnostic>) {
    let pos = node_pos(node)
    let mut diags: Slice<Diagnostic> = []

    let (body_opt, body_diags) = self.statement_field(
      node,
      capp.FieldBody,
      "do without body",
    )
    diags = merge_diags(diags, body_diags)
    let Some(body) = body_opt else {
      return (None, diags)
    }

    let (condition_opt, condition_diags) = self.paren_field(
      node,
      capp.FieldCondition,
      "do without condition",
    )
    diags = merge_diags(diags, condition_diags)
    let Some(condition) = condition_opt else {
      return (None, diags)
    }

    let lowered = DoStatement { body: &body, condition, pos }
    (Some(Statement.Do(lowered)), diags)
  }

  fn with_statement(self, node: capp.CSTNode) -> (Option<Statement>, Slice<Diagnostic>) {
    let pos = node_pos(node)
    let mut diags: Slice<Diagnostic> = []

    let (object_opt, object_diags) = self.paren_field(
      node,
      capp.FieldObject,
      "with without object",
    )
    diags = merge_diags(diags, object_diags)
    let Some(object) = object_opt else {
      return (None, diags)
    }

    let (body_opt, body_diags) = self.statement_field(
      node,
      capp.FieldBody,
      "with without body",
    )
    diags = merge_diags(diags, body_diags)
    let Some(body) = body_opt else {
      return (None, diags)
    }

    let lowered = WithStatement { object, body: &body, pos }
    (Some(Statement.With(lowered)), diags)
  }

  fn labeled_statement(self, node: capp.CSTNode) -> (Option<Statement>, Slice<Diagnostic>) {
    let pos = node_pos(node)

    let label_node = match node.ChildByFieldName(capp.FieldLabel) {
      Some(n) => n,
      None => return (
        None,
        self.malformed(node, "labeled statement without label"),
      ),
    }

    let (body_opt, diags) = self.statement_field(
      node,
      capp.FieldBody,
      "labeled statement without body",
    )
    let Some(body) = body_opt else {
      return (None, diags)
    }

    let lowered = LabeledStatement { 
      label: ident_of(label_node),
      body: &body,
      pos,
    }
    (Some(Statement.Labeled(lowered)), diags)
  }

  // throw_statement holds its value as the single unfielded named child: an
  // expression or sequence.
  fn throw_statement(self, node: capp.CSTNode) -> (Option<Statement>, Slice<Diagnostic>) {
    let pos = node_pos(node)
    for i in 0..node.NamedChildCount() {
      let child = node.NamedChild(i)
      if skippable(child.Kind()) { continue }
      let (exprs_opt, diags) = self.expressions(child)
      let Some(exprs) = exprs_opt else {
        return (None, diags)
      }
      let lowered = ThrowStatement { value: &exprs, pos }
      return (Some(Statement.Throw(lowered)), diags)
    }
    (None, self.malformed(node, "throw without value"))
  }

  fn switch_statement(self, node: capp.CSTNode) -> (Option<Statement>, Slice<Diagnostic>) {
    let pos = node_pos(node)
    let mut diags: Slice<Diagnostic> = []

    let (value_opt, value_diags) = self.paren_field(
      node,
      capp.FieldValue,
      "switch without value",
    )
    diags = merge_diags(diags, value_diags)
    let Some(value) = value_opt else {
      return (None, diags)
    }

    let body_node = match node.ChildByFieldName(capp.FieldBody) {
      Some(n) => n,
      None => return (
        None,
        merge_diags(diags, self.malformed(node, "switch without body")),
      ),
    }
    let (body, body_diags) = self.switch_body(body_node)
    diags = merge_diags(diags, body_diags)

    (Some(Statement.Switch(SwitchStatement { value, body, pos })), diags)
  }

  fn switch_body(self, node: capp.CSTNode) -> (SwitchBody, Slice<Diagnostic>) {
    let mut entries: Slice<SwitchEntry> = []
    let mut diags: Slice<Diagnostic> = []
    for i in 0..node.NamedChildCount() {
      let child = node.NamedChild(i)
      let kind = child.Kind()
      if skippable(kind) { continue }
      if kind == capp.NodeKindSwitchCase {
        let (case_opt, ds) = self.switch_case(child)
        diags = merge_diags(diags, ds)
        if let Some(c) = case_opt {
          entries = entries.append(SwitchEntry.Case(c))
        }
      } else if kind == capp.NodeKindSwitchDefault {
        let (default_entry, ds) = self.switch_default(child)
        diags = merge_diags(diags, ds)
        entries = entries.append(SwitchEntry.Default(default_entry))
      } else {
        diags = merge_diags(diags, self.unhandled(child, "switch entry", kind))
      }
    }
    (SwitchBody { entries, pos: node_pos(node) }, diags)
  }

  // switch_case: the value is fielded and precedes the body statements in
  // tree order; the body is a multiple-valued field, so with first-match
  // field access the first non-comment named child is taken as the value
  // and the remainder as body statements.
  fn switch_case(self, node: capp.CSTNode) -> (Option<SwitchCase>, Slice<Diagnostic>) {
    let pos = node_pos(node)
    let mut diags: Slice<Diagnostic> = []
    let mut value: Option<Expressions> = None
    let mut body: Slice<Statement> = []

    for i in 0..node.NamedChildCount() {
      let child = node.NamedChild(i)
      if skippable(child.Kind()) { continue }
      if value.is_none() {
        let (exprs_opt, ds) = self.expressions(child)
        diags = merge_diags(diags, ds)
        match exprs_opt {
          Some(exprs) => value = Some(exprs),
          None => return (None, diags),
        }
      } else {
        let (stmt_opt, ds) = self.statement(child)
        diags = merge_diags(diags, ds)
        if let Some(stmt) = stmt_opt { body = body.append(stmt) }
      }
    }

    let Some(case_value) = value else {
      return (
        None,
        merge_diags(diags, self.malformed(node, "case without value")),
      )
    }
    (Some(SwitchCase { value: &case_value, body, pos }), diags)
  }

  fn switch_default(self, node: capp.CSTNode) -> (SwitchDefault, Slice<Diagnostic>) {
    let mut body: Slice<Statement> = []
    let mut diags: Slice<Diagnostic> = []
    for i in 0..node.NamedChildCount() {
      let child = node.NamedChild(i)
      if skippable(child.Kind()) { continue }
      let (stmt_opt, ds) = self.statement(child)
      diags = merge_diags(diags, ds)
      if let Some(stmt) = stmt_opt { body = body.append(stmt) }
    }
    (SwitchDefault { body, pos: node_pos(node) }, diags)
  }

  fn for_statement(self, node: capp.CSTNode) -> (Option<Statement>, Slice<Diagnostic>) {
    let pos = node_pos(node)
    let mut diags: Slice<Diagnostic> = []

    let initializer_node = match node.ChildByFieldName(capp.FieldInitializer) {
      Some(n) => n,
      None => return (None, self.malformed(node, "for without initializer")),
    }
    let (initializer_opt, initializer_diags) = self.for_initializer(
      initializer_node,
    )
    diags = merge_diags(diags, initializer_diags)
    let Some(initializer) = initializer_opt else {
      return (None, diags)
    }

    // The condition is a multiple-valued field covering both the expression
    // and its terminating ';'.  First-match field access therefore returns
    // the expression when present, an empty_statement, or — for an absent
    // condition — the bare anonymous ';' itself, whose kind is its literal
    // text.
    let condition_node = match node.ChildByFieldName(capp.FieldCondition) {
      Some(n) => n,
      None => return (
        None,
        merge_diags(diags, self.malformed(node, "for without condition")),
      ),
    }
    let condition_kind = condition_node.Kind()
    let condition_absent = condition_kind == ";" ||
    condition_kind == capp.NodeKindEmptyStatement
    let condition = if condition_absent {
      ForCondition.Empty(EmptyStatement { pos: node_pos(condition_node) })
    } else {
      let (exprs_opt, ds) = self.expressions(condition_node)
      diags = merge_diags(diags, ds)
      match exprs_opt {
        Some(exprs) => ForCondition.Expression(&exprs),
        None => return (None, diags),
      }
    }

    let mut increment: Option<Expressions> = None
    if let Some(increment_node) = node.ChildByFieldName(capp.FieldIncrement) {
      let (exprs_opt, ds) = self.expressions(increment_node)
      diags = merge_diags(diags, ds)

      if let Some(v) = exprs_opt {
        increment = Some(v)
      } else {
        increment = None
      }
    }

    let (body_opt, body_diags) = self.statement_field(
      node,
      capp.FieldBody,
      "for without body",
    )
    diags = merge_diags(diags, body_diags)
    let Some(body) = body_opt else {
      return (None, diags)
    }

    let lowered = ForStatement { 
      initializer,
      condition,
      increment,
      body: &body,
      pos,
    }
    (Some(Statement.For(lowered)), diags)
  }

  fn for_initializer(self, node: capp.CSTNode) -> (Option<ForInitializer>, Slice<Diagnostic>) {
    let kind = node.Kind()
    if kind == capp.NodeKindEmptyStatement {
      return (
        Some(ForInitializer.Empty(EmptyStatement { pos: node_pos(node) })),
        [],
      )
    }
    if kind == capp.NodeKindVariableDeclaration {
      let (decl_opt, diags) = self.variable_declaration(node)
      let Some(decl) = decl_opt else {
        return (None, diags)
      }
      return (Some(ForInitializer.Variable(decl)), diags)
    }
    if kind == capp.NodeKindLexicalDeclaration {
      let (decl_opt, diags) = self.lexical_declaration(node)
      let Some(decl) = decl_opt else {
        return (None, diags)
      }
      return (Some(ForInitializer.Lexical(decl)), diags)
    }

    let (exprs_opt, diags) = self.expressions(node)
    let Some(exprs) = exprs_opt else {
      return (None, diags)
    }
    (Some(ForInitializer.Expression(&exprs)), diags)
  }

  // for_in_statement covers both `for (x in y)` and `for (x of y)`.  The
  // declaration kind (var/let/const/using) and the `await` of `for await`
  // share a single multiple-valued `kind` field of anonymous tokens; with
  // first-match field access only, both are recovered by anonymous-child
  // scan, where each is unambiguous.  `await using` declarations inside
  // for-headers are not distinguished from `for await (using ...)`; the
  // corpus contains neither.
  fn for_in_statement(self, node: capp.CSTNode) -> (Option<Statement>, Slice<Diagnostic>) {
    let pos = node_pos(node)
    let mut diags: Slice<Diagnostic> = []

    let is_await = has_anonymous_child(node, "await")
    let mut declared_kind: Option<VariableKind> = None
    if has_anonymous_child(node, "var") {
      declared_kind = Some(VariableKind.Var)
    }
    if has_anonymous_child(node, "let") {
      declared_kind = Some(VariableKind.Let)
    }
    if has_anonymous_child(node, "const") {
      declared_kind = Some(VariableKind.Const)
    }
    if has_anonymous_child(node, "using") {
      declared_kind = Some(VariableKind.Using)
    }

    let operator_node = match node.ChildByFieldName(capp.FieldOperator) {
      Some(n) => n,
      None => return (None, self.malformed(node, "for-in without operator")),
    }
    let operator = if operator_node.Kind() == "of" {
      ForOperator.Of
    } else {
      ForOperator.In
    }

    let left_node = match node.ChildByFieldName(capp.FieldLeft) {
      Some(n) => n,
      None => return (None, self.malformed(node, "for-in without binding")),
    }
    let left_kind = left_node.Kind()

    let binding = match declared_kind {
      Some(kind) => {
        let left = if left_kind == capp.NodeKindIdentifier {
          ForDeclaredLeft.Identifier(ident_of(left_node))
        } else {
          // Destructuring bindings are deferred.
          return (
            None,
            merge_diags(
              diags,
              self.unhandled(left_node, "for-in declared binding", left_kind),
            ),
          )
        }
        // The legacy `for (var x = init in y)` initializer arrives in the
        // optional `value` field; Initializer.pos anchors at the value
        // expression, as the grammar has no initializer node.
        let mut initializer: Option<Initializer> = None
        if let Some(value_node) = node.ChildByFieldName(capp.FieldValue) {
          let (expr_opt, ds) = self.expression(value_node)
          diags = merge_diags(diags, ds)
          if let Some(expr) = expr_opt {
            initializer = Some(
              Initializer { value: &expr, pos: node_pos(value_node) },
            )
          }
        }
        ForBinding.Declared(
          ForDeclaredBinding { 
            kind,
            left,
            initializer,
            pos: node_pos(left_node),
          },
        )
      },
      None => {
        let left = if left_kind == capp.NodeKindIdentifier {
          ForLeft.Lhs(LhsExpression.Identifier(ident_of(left_node)))
        } else if left_kind == capp.NodeKindUndefined {
          ForLeft.Lhs(LhsExpression.Undefined(
            UndefinedLiteral { pos: node_pos(left_node) },
          ))
        } else {
          // member/subscript/parenthesized/destructuring bindings wait on
          // the expression tier's bare-struct helpers.
          return (
            None,
            merge_diags(
              diags,
              self.unhandled(left_node, "for-in binding", left_kind),
            ),
          )
        }
        ForBinding.Plain(ForPlainBinding { left, pos: node_pos(left_node) })
      },
    }

    let right_node = match node.ChildByFieldName(capp.FieldRight) {
      Some(n) => n,
      None => return (
        None,
        merge_diags(diags, self.malformed(node, "for-in without right side")),
      ),
    }
    let (right_opt, right_diags) = self.expressions(right_node)
    diags = merge_diags(diags, right_diags)
    let Some(right) = right_opt else {
      return (None, diags)
    }

    let (body_opt, body_diags) = self.statement_field(
      node,
      capp.FieldBody,
      "for-in without body",
    )
    diags = merge_diags(diags, body_diags)
    let Some(body) = body_opt else {
      return (None, diags)
    }

    // ForHeader spans binding through right side; its pos anchors at the
    // binding.
    let header = ForHeader { 
      binding,
      operator,
      right: &right,
      pos: node_pos(left_node),
    }
    let lowered = ForInStatement { is_await, header, body: &body, pos }
    (Some(Statement.ForIn(lowered)), diags)
  }

  fn try_statement(self, node: capp.CSTNode) -> (Option<Statement>, Slice<Diagnostic>) {
    let pos = node_pos(node)
    let mut diags: Slice<Diagnostic> = []

    let body_node = match node.ChildByFieldName(capp.FieldBody) {
      Some(n) => n,
      None => return (None, self.malformed(node, "try without body")),
    }
    let (body, body_diags) = self.statement_block(body_node)
    diags = merge_diags(diags, body_diags)

    let mut handler: Option<CatchClause> = None
    if let Some(handler_node) = node.ChildByFieldName(capp.FieldHandler) {
      let (handler_opt, ds) = self.catch_clause(handler_node)
      diags = merge_diags(diags, ds)
      if let Some(v) = handler_opt { handler = Some(v) } else { handler = None }
    }

    let mut finalizer: Option<FinallyClause> = None
    if let Some(finalizer_node) = node.ChildByFieldName(capp.FieldFinalizer) {
      let (finalizer_opt, ds) = self.finally_clause(finalizer_node)
      diags = merge_diags(diags, ds)
      if let Some(v) = finalizer_opt {
        finalizer = Some(v)
      } else {
        finalizer = None
      }
    }

    let lowered = TryStatement { body, handler, finalizer, pos }
    (Some(Statement.Try(lowered)), diags)
  }

  fn catch_clause(self, node: capp.CSTNode) -> (Option<CatchClause>, Slice<Diagnostic>) {
    let pos = node_pos(node)
    let mut diags: Slice<Diagnostic> = []

    let mut parameter: Option<CatchParameter> = None
    if let Some(parameter_node) = node.ChildByFieldName(capp.FieldParameter) {
      if parameter_node.Kind() == capp.NodeKindIdentifier {
        parameter = Some(CatchParameter.Identifier(ident_of(parameter_node)))
      } else {
        // Destructuring catch parameters are deferred; the clause itself
        // still lowers.
        diags = merge_diags(
          diags,
          self.unhandled(
            parameter_node,
            "catch parameter",
            parameter_node.Kind(),
          ),
        )
      }
    }

    let body_node = match node.ChildByFieldName(capp.FieldBody) {
      Some(n) => n,
      None => return (
        None,
        merge_diags(diags, self.malformed(node, "catch without body")),
      ),
    }
    let (body, body_diags) = self.statement_block(body_node)
    diags = merge_diags(diags, body_diags)

    (Some(CatchClause { parameter, body, pos }), diags)
  }

  fn finally_clause(self, node: capp.CSTNode) -> (Option<FinallyClause>, Slice<Diagnostic>) {
    let pos = node_pos(node)
    let body_node = match node.ChildByFieldName(capp.FieldBody) {
      Some(n) => n,
      None => return (None, self.malformed(node, "finally without body")),
    }
    let (body, diags) = self.statement_block(body_node)
    (Some(FinallyClause { body, pos }), diags)
  }

  // -------------------------------------------------------------------------
  // Declarations
  // -------------------------------------------------------------------------

  // function_declaration lowers to the bare FunctionDeclaration so that both
  // the statement arm and ObjjImplementationMember.Function can wrap it.
  fn function_declaration(self, node: capp.CSTNode) -> (Option<FunctionDeclaration>, Slice<Diagnostic>) {
    let pos = node_pos(node)
    let is_async = has_anonymous_child(node, "async")

    let name_node = match node.ChildByFieldName(capp.FieldName) {
      Some(n) => n,
      None => return (None, self.malformed(node, "function without name")),
    }
    let parameters_node = match node.ChildByFieldName(capp.FieldParameters) {
      Some(n) => n,
      None => return (None, self.malformed(node, "function without parameters")),
    }
    let body_node = match node.ChildByFieldName(capp.FieldBody) {
      Some(n) => n,
      None => return (None, self.malformed(node, "function without body")),
    }

    let (parameters, param_diags) = self.formal_parameters(parameters_node)
    let (body, body_diags) = self.statement_block(body_node)
    let diags = merge_diags(param_diags, body_diags)

    let decl = FunctionDeclaration { 
      is_async,
      name: ident_of(name_node),
      parameters,
      body,
      pos,
    }
    (Some(decl), diags)
  }

  fn formal_parameters(self, node: capp.CSTNode) -> (FormalParameters, Slice<Diagnostic>) {
    let mut parameters: Slice<FormalParameter> = []
    let mut diags: Slice<Diagnostic> = []
    for i in 0..node.NamedChildCount() {
      let child = node.NamedChild(i)
      let kind = child.Kind()
      if skippable(kind) { continue }
      if kind == capp.NodeKindIdentifier {
        let parameter = FormalParameter.Pattern(Pattern.Lhs(LhsExpression.Identifier(ident_of(
          child,
        ))))
        parameters = parameters.append(parameter)
      } else {
        // Destructuring, rest, and default parameters are deferred.
        diags = merge_diags(
          diags,
          self.unhandled(child, "formal parameter", kind),
        )
      }
    }
    (FormalParameters { parameters, pos: node_pos(node) }, diags)
  }

  // variable_declaration lowers `var d, d, ...;` — the declarators are the
  // named children.
  fn variable_declaration(self, node: capp.CSTNode) -> (Option<VariableDeclaration>, Slice<Diagnostic>) {
    let (declarators, diags) = self.declarators(node)
    if declarators.is_empty() {
      return (
        None,
        merge_diags(
          diags,
          self.malformed(node, "variable declaration without declarators"),
        ),
      )
    }
    (Some(VariableDeclaration { declarators, pos: node_pos(node) }), diags)
  }

  // lexical_declaration lowers `let|const d, d, ...;`.  The kind field holds
  // the anonymous keyword token.
  fn lexical_declaration(self, node: capp.CSTNode) -> (Option<LexicalDeclaration>, Slice<Diagnostic>) {
    let kind = match node.ChildByFieldName(capp.FieldKind) {
      Some(kind_node) => {
        if kind_node.Text() == "const" {
          LexicalKind.Const
        } else {
          LexicalKind.Let
        }
      },
      None => return (
        None,
        self.malformed(node, "lexical declaration without kind"),
      ),
    }
    let (declarators, diags) = self.declarators(node)
    if declarators.is_empty() {
      return (
        None,
        merge_diags(
          diags,
          self.malformed(node, "lexical declaration without declarators"),
        ),
      )
    }
    (Some(LexicalDeclaration { kind, declarators, pos: node_pos(node) }), diags)
  }

  fn declarators(self, node: capp.CSTNode) -> (Slice<VariableDeclarator>, Slice<Diagnostic>) {
    let mut declarators: Slice<VariableDeclarator> = []
    let mut diags: Slice<Diagnostic> = []
    for i in 0..node.NamedChildCount() {
      let child = node.NamedChild(i)
      let kind = child.Kind()
      if skippable(kind) { continue }
      if kind != capp.NodeKindVariableDeclarator {
        diags = merge_diags(diags, self.unhandled(child, "declarator", kind))
        continue
      }
      let (declarator_opt, ds) = self.variable_declarator(child)
      diags = merge_diags(diags, ds)
      if let Some(declarator) = declarator_opt {
        declarators = declarators.append(declarator)
      }
    }
    (declarators, diags)
  }

  // variable_declarator: the initializer arrives in the `value` field; the
  // grammar has no initializer node, so Initializer.pos anchors at the value
  // expression.  An unhandled initializer expression records its diagnostic
  // and leaves the declarator bare rather than discarding it.
  fn variable_declarator(self, node: capp.CSTNode) -> (Option<VariableDeclarator>, Slice<Diagnostic>) {
    let pos = node_pos(node)
    let mut diags: Slice<Diagnostic> = []

    let name_node = match node.ChildByFieldName(capp.FieldName) {
      Some(n) => n,
      None => return (None, self.malformed(node, "declarator without name")),
    }
    if name_node.Kind() != capp.NodeKindIdentifier {
      // object_pattern / array_pattern — destructuring declarators deferred.
      return (
        None,
        self.unhandled(name_node, "declarator name", name_node.Kind()),
      )
    }
    let name = VariableDeclaratorName.Identifier(ident_of(name_node))

    let mut initializer: Option<Initializer> = None
    if let Some(value_node) = node.ChildByFieldName(capp.FieldValue) {
      let (expr_opt, ds) = self.expression(value_node)
      diags = merge_diags(diags, ds)
      if let Some(expr) = expr_opt {
        initializer = Some(
          Initializer { value: &expr, pos: node_pos(value_node) },
        )
      }
    }

    (Some(VariableDeclarator { name, initializer, pos }), diags)
  }

  // -------------------------------------------------------------------------
  // Expressions
  // -------------------------------------------------------------------------

  // expressions lowers the _expressions position: one expression or a comma
  // sequence.
  fn expressions(self, node: capp.CSTNode) -> (Option<Expressions>, Slice<Diagnostic>) {
    if node.Kind() == capp.NodeKindSequenceExpression {
      let mut items: Slice<Expression> = []
      let mut diags: Slice<Diagnostic> = []
      for i in 0..node.NamedChildCount() {
        let child = node.NamedChild(i)
        if skippable(child.Kind()) { continue }
        let (expr_opt, ds) = self.expression(child)
        diags = merge_diags(diags, ds)
        if let Some(expr) = expr_opt { items = items.append(expr) }
      }
      let sequence = SequenceExpression { items, pos: node_pos(node) }
      return (Some(Expressions.Sequence(sequence)), diags)
    }

    let (expr_opt, diags) = self.expression(node)
    let Some(expr) = expr_opt else {
      return (None, diags)
    }
    (Some(Expressions.Single(expr)), diags)
  }

  fn expression(self, node: capp.CSTNode) -> (Option<Expression>, Slice<Diagnostic>) {
    let kind = node.Kind()
    let pos = node_pos(node)

    if kind == capp.NodeKindIdentifier {
      return (
        Some(Expression.Primary(PrimaryExpression.Identifier(ident_of(node)))),
        [],
      )
    }
    if kind == capp.NodeKindNumber {
      let literal = NumberLiteral { text: node.Text(), pos }
      return (Some(Expression.Primary(PrimaryExpression.Number(literal))), [])
    }
    if kind == capp.NodeKindString {
      let (literal, diags) = self.string_literal(node)
      return (
        Some(Expression.Primary(PrimaryExpression.String(literal))),
        diags,
      )
    }
    if kind == capp.NodeKindTrue {
      return (
        Some(Expression.Primary(PrimaryExpression.True(TrueLiteral { pos }))),
        [],
      )
    }
    if kind == capp.NodeKindFalse {
      return (
        Some(Expression.Primary(PrimaryExpression.False(FalseLiteral { pos }))),
        [],
      )
    }
    if kind == capp.NodeKindNull {
      return (
        Some(Expression.Primary(PrimaryExpression.Null(NullLiteral { pos }))),
        [],
      )
    }
    if kind == capp.NodeKindUndefined {
      return (
        Some(Expression.Primary(PrimaryExpression.Undefined(
          UndefinedLiteral { pos },
        ))),
        [],
      )
    }
    if kind == capp.NodeKindThis {
      return (
        Some(Expression.Primary(PrimaryExpression.This(ThisLiteral { pos }))),
        [],
      )
    }
    if kind == capp.NodeKindSuper {
      return (
        Some(Expression.Primary(PrimaryExpression.Super(SuperLiteral { pos }))),
        [],
      )
    }
    if kind == capp.NodeKindCallExpression { return self.call_expression(node) }
    if kind == capp.NodeKindMemberExpression {
      return self.member_expression(node)
    }
    if kind == capp.NodeKindParenthesizedExpression {
      let (paren_opt, diags) = self.parenthesized(node)
      let Some(paren) = paren_opt else {
        return (None, diags)
      }
      return (
        Some(Expression.Primary(PrimaryExpression.Parenthesized(paren))),
        diags,
      )
    }
    if kind == capp.NodeKindObjjMessageExpression {
      return self.message_expression(node)
    }
    if kind == capp.NodeKindSubscriptExpression {
      let (subscript_opt, diags) = self.subscript_expr_struct(node)
      let Some(subscript) = subscript_opt else {
        return (None, diags)
      }
      return (
        Some(Expression.Primary(PrimaryExpression.Subscript(subscript))),
        diags,
      )
    }
    if kind == capp.NodeKindAssignmentExpression {
      return self.assignment_expression(node)
    }
    if kind == capp.NodeKindAugmentedAssignmentExpression {
      return self.augmented_assignment_expression(node)
    }
    if kind == capp.NodeKindBinaryExpression {
      return self.binary_expression(node)
    }
    if kind == capp.NodeKindUnaryExpression {
      return self.unary_expression(node)
    }
    if kind == capp.NodeKindTernaryExpression {
      return self.ternary_expression(node)
    }
    if kind == capp.NodeKindUpdateExpression {
      return self.update_expression(node)
    }
    if kind == capp.NodeKindNewExpression {
      let (new_opt, diags) = self.new_expr_struct(node)
      let Some(new_expr) = new_opt else {
        return (None, diags)
      }
      return (Some(Expression.New(new_expr)), diags)
    }
    if kind == capp.NodeKindAwaitExpression {
      return self.await_expression(node)
    }
    if kind == capp.NodeKindYieldExpression {
      return self.yield_expression(node)
    }
    if kind == capp.NodeKindObject {
      let (object_opt, diags) = self.object_literal(node)
      let Some(object) = object_opt else {
        return (None, diags)
      }
      return (Some(Expression.Primary(PrimaryExpression.Object(object))), diags)
    }
    if kind == capp.NodeKindNativeArray {
      let (array_opt, diags) = self.native_array(node)
      let Some(array) = array_opt else {
        return (None, diags)
      }
      return (
        Some(Expression.Primary(PrimaryExpression.NativeArray(array))),
        diags,
      )
    }
    if kind == capp.NodeKindFunctionExpression {
      let (func_opt, diags) = self.function_expression(node)
      let Some(func) = func_opt else {
        return (None, diags)
      }
      return (Some(Expression.Primary(PrimaryExpression.Function(func))), diags)
    }
    if kind == capp.NodeKindRegex {
      let (regex_opt, diags) = self.regex_literal(node)
      let Some(regex) = regex_opt else {
        return (None, diags)
      }
      return (Some(Expression.Primary(PrimaryExpression.Regex(regex))), [])
    }
    if kind == capp.NodeKindObjjRefExpression {
      return self.objj_ref_expression(node)
    }
    if kind == capp.NodeKindObjjDerefExpression {
      let (deref_opt, diags) = self.objj_deref_struct(node)
      let Some(deref) = deref_opt else {
        return (None, diags)
      }
      return (
        Some(Expression.Primary(PrimaryExpression.ObjjDeref(deref))),
        diags,
      )
    }
    if kind == capp.NodeKindObjjStringLiteral {
      let (literal_opt, diags) = self.objj_string_literal(node)
      let Some(literal) = literal_opt else {
        return (None, diags)
      }
      return (
        Some(Expression.Primary(PrimaryExpression.ObjjString(literal))),
        diags,
      )
    }
    if kind == capp.NodeKindObjjSelectorExpression {
      let (selector_opt, diags) = self.objj_selector_expression(node)
      let Some(selector) = selector_opt else {
        return (None, diags)
      }
      return (
        Some(Expression.Primary(PrimaryExpression.ObjjSelector(selector))),
        diags,
      )
    }
    if kind == capp.NodeKindObjjDictionaryLiteral {
      let (dictionary_opt, diags) = self.objj_dictionary_literal(node)
      let Some(dictionary) = dictionary_opt else {
        return (None, diags)
      }
      return (
        Some(Expression.Primary(PrimaryExpression.ObjjDictionary(dictionary))),
        diags,
      )
    }
    if kind == capp.NodeKindObjjArrayLiteral {
      let (array_opt, diags) = self.objj_array_literal(node)
      let Some(array) = array_opt else {
        return (None, diags)
      }
      return (
        Some(Expression.Primary(PrimaryExpression.ObjjArray(array))),
        diags,
      )
    }
    if kind == capp.NodeKindTemplateString {
      let (template_opt, diags) = self.template_string(node)
      let Some(template) = template_opt else {
        return (None, diags)
      }
      return (
        Some(Expression.Primary(PrimaryExpression.Template(template))),
        diags,
      )
    }
    if kind == capp.NodeKindArrowFunction {
      let (arrow_opt, diags) = self.arrow_function(node)
      let Some(arrow) = arrow_opt else {
        return (None, diags)
      }
      return (Some(Expression.Primary(PrimaryExpression.Arrow(arrow))), diags)
    }
    if kind == capp.NodeKindGeneratorFunction {
      let (generator_opt, diags) = self.generator_function(node)
      let Some(generator) = generator_opt else {
        return (None, diags)
      }
      return (
        Some(Expression.Primary(PrimaryExpression.Generator(generator))),
        diags,
      )
    }

    (None, self.unhandled(node, "expression", kind))
  }

  fn parenthesized(self, node: capp.CSTNode) -> (Option<ParenthesizedExpression>, Slice<Diagnostic>) {
    let pos = node_pos(node)
    for i in 0..node.NamedChildCount() {
      let child = node.NamedChild(i)
      if skippable(child.Kind()) { continue }
      let (exprs_opt, diags) = self.expressions(child)
      let Some(exprs) = exprs_opt else {
        return (None, diags)
      }
      return (Some(ParenthesizedExpression { expression: &exprs, pos }), diags)
    }
    (None, self.malformed(node, "parenthesized expression without content"))
  }

  fn string_literal(self, node: capp.CSTNode) -> (StringLiteral, Slice<Diagnostic>) {
    let mut parts: Slice<StringPart> = []
    let mut diags: Slice<Diagnostic> = []
    for i in 0..node.NamedChildCount() {
      let child = node.NamedChild(i)
      let kind = child.Kind()
      if kind == capp.NodeKindStringFragment {
        let fragment = StringFragment { 
          text: child.Text(),
          pos: node_pos(child),
        }
        parts = parts.append(StringPart.Fragment(fragment))
      } else if kind == capp.NodeKindEscapeSequence {
        let escape = EscapeSequence { text: child.Text(), pos: node_pos(child) }
        parts = parts.append(StringPart.Escape(escape))
      } else if skippable(kind) {
        ()
      } else {
        diags = merge_diags(diags, self.unhandled(child, "string part", kind))
      }
    }
    (StringLiteral { parts, text: node.Text(), pos: node_pos(node) }, diags)
  }

  fn call_expression(self, node: capp.CSTNode) -> (Option<Expression>, Slice<Diagnostic>) {
    let pos = node_pos(node)

    // Optional-chain calls (f?.()) and template calls (f`...`) are distinct
    // CallExpression variants; both deferred.
    if let Some(_) = node.ChildByFieldName(capp.FieldOptionalChain) {
      return (None, self.unhandled(node, "call form", "optional-chain call"))
    }
    let arguments_node = match node.ChildByFieldName(capp.FieldArguments) {
      Some(n) => n,
      None => return (None, self.malformed(node, "call without arguments")),
    }
    if arguments_node.Kind() == capp.NodeKindTemplateString {
      return (None, self.unhandled(node, "call form", "template call"))
    }

    let function_node = match node.ChildByFieldName(capp.FieldFunction) {
      Some(n) => n,
      None => return (None, self.malformed(node, "call without callee")),
    }

    let mut diags: Slice<Diagnostic> = []
    let callee = if function_node.Kind() == capp.NodeKindImport {
      CallTarget.Import(ImportToken { pos: node_pos(function_node) })
    } else {
      let (callee_opt, ds) = self.expression(function_node)
      diags = merge_diags(diags, ds)
      match callee_opt {
        Some(callee_expr) => CallTarget.Expression(&callee_expr),
        None => return (None, diags),
      }
    }

    let (arguments, arg_diags) = self.arguments(arguments_node)
    diags = merge_diags(diags, arg_diags)

    let call = PlainCall { callee, arguments, pos }
    (
      Some(Expression.Primary(PrimaryExpression.Call(CallExpression.Call(call)))),
      diags,
    )
  }

  fn arguments(self, node: capp.CSTNode) -> (Arguments, Slice<Diagnostic>) {
    let mut items: Slice<Argument> = []
    let mut diags: Slice<Diagnostic> = []
    for i in 0..node.NamedChildCount() {
      let child = node.NamedChild(i)
      let kind = child.Kind()
      if skippable(kind) { continue }
      if kind == capp.NodeKindSpreadElement {
        let (spread_opt, ds) = self.spread(child)
        diags = merge_diags(diags, ds)
        if let Some(spread) = spread_opt {
          items = items.append(Argument.Spread(spread))
        }
      } else {
        let (expr_opt, ds) = self.expression(child)
        diags = merge_diags(diags, ds)
        if let Some(expr) = expr_opt {
          items = items.append(Argument.Expression(&expr))
        }
      }
    }
    (Arguments { items, pos: node_pos(node) }, diags)
  }

  fn spread(self, node: capp.CSTNode) -> (Option<SpreadElement>, Slice<Diagnostic>) {
    let pos = node_pos(node)
    for i in 0..node.NamedChildCount() {
      let child = node.NamedChild(i)
      if skippable(child.Kind()) { continue }
      let (expr_opt, diags) = self.expression(child)
      let Some(expr) = expr_opt else {
        return (None, diags)
      }
      return (Some(SpreadElement { argument: &expr, pos }), diags)
    }
    (None, self.malformed(node, "spread without argument"))
  }

  // member_expression is the dispatch wrapper; member_expr_struct is the
  // bare producer reused by assignment targets, new constructors, and for-in
  // bindings, which need MemberExpression rather than the wrapped Expression.
  fn member_expression(self, node: capp.CSTNode) -> (Option<Expression>, Slice<Diagnostic>) {
    let (member_opt, diags) = self.member_expr_struct(node)
    let Some(member) = member_opt else {
      return (None, diags)
    }
    (Some(Expression.Primary(PrimaryExpression.Member(member))), diags)
  }

  fn member_expr_struct(self, node: capp.CSTNode) -> (Option<MemberExpression>, Slice<Diagnostic>) {
    let pos = node_pos(node)

    let object_node = match node.ChildByFieldName(capp.FieldObject) {
      Some(n) => n,
      None => return (
        None,
        self.malformed(node, "member access without object"),
      ),
    }
    let property_node = match node.ChildByFieldName(capp.FieldProperty) {
      Some(n) => n,
      None => return (
        None,
        self.malformed(node, "member access without property"),
      ),
    }

    let mut diags: Slice<Diagnostic> = []
    let object = if object_node.Kind() == capp.NodeKindImport {
      MemberObject.Import(ImportToken { pos: node_pos(object_node) })
    } else {
      let (object_opt, ds) = self.expression(object_node)
      diags = merge_diags(diags, ds)
      match object_opt {
        Some(object_expr) => MemberObject.Expression(&object_expr),
        None => return (None, diags),
      }
    }

    let optional_chain = node
      .ChildByFieldName(capp.FieldOptionalChain)
      .is_some()

    let property = if property_node.Kind() ==
    capp.NodeKindPrivatePropertyIdentifier {
      MemberProperty.Private(
        PrivatePropertyIdentifier { 
          text: property_node.Text(),
          pos: node_pos(property_node),
        },
      )
    } else {
      MemberProperty.Property(ident_of(property_node))
    }

    (Some(MemberExpression { object, optional_chain, property, pos }), diags)
  }

  // subscript_expr_struct is the bare producer for o[i].  index is an
  // expression or sequence, so it lowers through `expressions`.
  fn subscript_expr_struct(self, node: capp.CSTNode) -> (Option<SubscriptExpression>, Slice<Diagnostic>) {
    let pos = node_pos(node)
    let mut diags: Slice<Diagnostic> = []

    let object_node = match node.ChildByFieldName(capp.FieldObject) {
      Some(n) => n,
      None => return (None, self.malformed(node, "subscript without object")),
    }
    let (object_opt, object_diags) = self.expression(object_node)
    diags = merge_diags(diags, object_diags)
    let Some(object) = object_opt else {
      return (None, diags)
    }

    let optional_chain = node
      .ChildByFieldName(capp.FieldOptionalChain)
      .is_some()

    let index_node = match node.ChildByFieldName(capp.FieldIndex) {
      Some(n) => n,
      None => return (
        None,
        merge_diags(diags, self.malformed(node, "subscript without index")),
      ),
    }
    let (index_opt, index_diags) = self.expressions(index_node)
    diags = merge_diags(diags, index_diags)
    let Some(index) = index_opt else {
      return (None, diags)
    }

    (
      Some(
        SubscriptExpression { 
          object: &object,
          optional_chain,
          index: &index,
          pos,
        },
      ),
      diags,
    )
  }

  // -------------------------------------------------------------------------
  // Expressions — operators
  // -------------------------------------------------------------------------

  // binary_op maps the anonymous operator token's kind (its literal text) to
  // the BinaryOp enum.  The grammar's `in` operator is the membership test,
  // distinct from for-in.
  fn binary_op(self, node: capp.CSTNode) -> Option<BinaryOp> {
    match node.Kind() {
      "&&" => Some(BinaryOp.LogicalAnd),
      "||" => Some(BinaryOp.LogicalOr),
      ">>" => Some(BinaryOp.ShiftRight),
      ">>>" => Some(BinaryOp.UnsignedShiftRight),
      "<<" => Some(BinaryOp.ShiftLeft),
      "&" => Some(BinaryOp.BitAnd),
      "^" => Some(BinaryOp.BitXor),
      "|" => Some(BinaryOp.BitOr),
      "+" => Some(BinaryOp.Add),
      "-" => Some(BinaryOp.Sub),
      "*" => Some(BinaryOp.Mul),
      "/" => Some(BinaryOp.Div),
      "%" => Some(BinaryOp.Mod),
      "**" => Some(BinaryOp.Exp),
      "<" => Some(BinaryOp.LessThan),
      "<=" => Some(BinaryOp.LessEqual),
      "==" => Some(BinaryOp.Equal),
      "===" => Some(BinaryOp.StrictEqual),
      "!=" => Some(BinaryOp.NotEqual),
      "!==" => Some(BinaryOp.StrictNotEqual),
      ">=" => Some(BinaryOp.GreaterEqual),
      ">" => Some(BinaryOp.GreaterThan),
      "??" => Some(BinaryOp.NullishCoalesce),
      "instanceof" => Some(BinaryOp.Instanceof),
      "in" => Some(BinaryOp.In),
      _ => None,
    }
  }

  fn unary_op(self, node: capp.CSTNode) -> Option<UnaryOp> {
    match node.Kind() {
      "!" => Some(UnaryOp.Not),
      "~" => Some(UnaryOp.BitNot),
      "-" => Some(UnaryOp.Negate),
      "+" => Some(UnaryOp.Plus),
      "typeof" => Some(UnaryOp.Typeof),
      "void" => Some(UnaryOp.Void),
      "delete" => Some(UnaryOp.Delete),
      _ => None,
    }
  }

  // assignment_op maps the compound operators permitted on @deref targets.
  // Bare '=' is Assign; the rest mirror the +=-family without the '='.
  fn assignment_op(self, node: capp.CSTNode) -> Option<AssignmentOp> {
    match node.Kind() {
      "=" => Some(AssignmentOp.Assign),
      "+=" => Some(AssignmentOp.Add),
      "-=" => Some(AssignmentOp.Sub),
      "*=" => Some(AssignmentOp.Mul),
      "/=" => Some(AssignmentOp.Div),
      "%=" => Some(AssignmentOp.Mod),
      "&=" => Some(AssignmentOp.BitAnd),
      "|=" => Some(AssignmentOp.BitOr),
      "^=" => Some(AssignmentOp.BitXor),
      "<<=" => Some(AssignmentOp.ShiftLeft),
      ">>=" => Some(AssignmentOp.ShiftRight),
      ">>>=" => Some(AssignmentOp.UnsignedShiftRight),
      _ => None,
    }
  }

  fn augmented_op(self, node: capp.CSTNode) -> Option<AugmentedAssignmentOp> {
    match node.Kind() {
      "+=" => Some(AugmentedAssignmentOp.Add),
      "-=" => Some(AugmentedAssignmentOp.Sub),
      "*=" => Some(AugmentedAssignmentOp.Mul),
      "/=" => Some(AugmentedAssignmentOp.Div),
      "%=" => Some(AugmentedAssignmentOp.Mod),
      "^=" => Some(AugmentedAssignmentOp.BitXor),
      "&=" => Some(AugmentedAssignmentOp.BitAnd),
      "|=" => Some(AugmentedAssignmentOp.BitOr),
      ">>=" => Some(AugmentedAssignmentOp.ShiftRight),
      ">>>=" => Some(AugmentedAssignmentOp.UnsignedShiftRight),
      "<<=" => Some(AugmentedAssignmentOp.ShiftLeft),
      "**=" => Some(AugmentedAssignmentOp.Exp),
      "&&=" => Some(AugmentedAssignmentOp.LogicalAnd),
      "||=" => Some(AugmentedAssignmentOp.LogicalOr),
      "??=" => Some(AugmentedAssignmentOp.NullishCoalesce),
      _ => None,
    }
  }

  fn binary_expression(self, node: capp.CSTNode) -> (Option<Expression>, Slice<Diagnostic>) {
    let pos = node_pos(node)
    let mut diags: Slice<Diagnostic> = []

    let left_node = match node.ChildByFieldName(capp.FieldLeft) {
      Some(n) => n,
      None => return (None, self.malformed(node, "binary without left")),
    }
    // The left side may be a private property identifier (the `#x in obj`
    // brand check), which is not an expression.
    let left = if left_node.Kind() == capp.NodeKindPrivatePropertyIdentifier {
      BinaryLeft.PrivateProperty(
        PrivatePropertyIdentifier { 
          text: left_node.Text(),
          pos: node_pos(left_node),
        },
      )
    } else {
      let (left_opt, ds) = self.expression(left_node)
      diags = merge_diags(diags, ds)
      match left_opt {
        Some(left_expr) => BinaryLeft.Expression(&left_expr),
        None => return (None, diags),
      }
    }

    let operator_node = match node.ChildByFieldName(capp.FieldOperator) {
      Some(n) => n,
      None => return (
        None,
        merge_diags(diags, self.malformed(node, "binary without operator")),
      ),
    }
    let Some(operator) = self.binary_op(operator_node) else {
      return (
        None,
        merge_diags(
          diags,
          self.unhandled(operator_node, "binary operator", operator_node.Kind()),
        ),
      )
    }

    let right_node = match node.ChildByFieldName(capp.FieldRight) {
      Some(n) => n,
      None => return (
        None,
        merge_diags(diags, self.malformed(node, "binary without right")),
      ),
    }
    let (right_opt, right_diags) = self.expression(right_node)
    diags = merge_diags(diags, right_diags)
    let Some(right) = right_opt else {
      return (None, diags)
    }

    let lowered = BinaryExpression { left, operator, right: &right, pos }
    (Some(Expression.Binary(lowered)), diags)
  }

  fn unary_expression(self, node: capp.CSTNode) -> (Option<Expression>, Slice<Diagnostic>) {
    let pos = node_pos(node)

    let operator_node = match node.ChildByFieldName(capp.FieldOperator) {
      Some(n) => n,
      None => return (None, self.malformed(node, "unary without operator")),
    }
    let Some(operator) = self.unary_op(operator_node) else {
      return (
        None,
        self.unhandled(operator_node, "unary operator", operator_node.Kind()),
      )
    }

    let argument_node = match node.ChildByFieldName(capp.FieldArgument) {
      Some(n) => n,
      None => return (None, self.malformed(node, "unary without argument")),
    }
    let (argument_opt, diags) = self.expression(argument_node)
    let Some(argument) = argument_opt else {
      return (None, diags)
    }

    let lowered = UnaryExpression { operator, argument: &argument, pos }
    (Some(Expression.Unary(lowered)), diags)
  }

  fn ternary_expression(self, node: capp.CSTNode) -> (Option<Expression>, Slice<Diagnostic>) {
    let pos = node_pos(node)
    let mut diags: Slice<Diagnostic> = []

    let condition_node = match node.ChildByFieldName(capp.FieldCondition) {
      Some(n) => n,
      None => return (None, self.malformed(node, "ternary without condition")),
    }
    let (condition_opt, condition_diags) = self.expression(condition_node)
    diags = merge_diags(diags, condition_diags)
    let Some(condition) = condition_opt else {
      return (None, diags)
    }

    let consequence_node = match node.ChildByFieldName(capp.FieldConsequence) {
      Some(n) => n,
      None => return (
        None,
        merge_diags(diags, self.malformed(node, "ternary without consequence")),
      ),
    }
    let (consequence_opt, consequence_diags) = self.expression(consequence_node)
    diags = merge_diags(diags, consequence_diags)
    let Some(consequence) = consequence_opt else {
      return (None, diags)
    }

    let alternative_node = match node.ChildByFieldName(capp.FieldAlternative) {
      Some(n) => n,
      None => return (
        None,
        merge_diags(diags, self.malformed(node, "ternary without alternative")),
      ),
    }
    let (alternative_opt, alternative_diags) = self.expression(alternative_node)
    diags = merge_diags(diags, alternative_diags)
    let Some(alternative) = alternative_opt else {
      return (None, diags)
    }

    let lowered = TernaryExpression { 
      condition: &condition,
      consequence: &consequence,
      alternative: &alternative,
      pos,
    }
    (Some(Expression.Ternary(lowered)), diags)
  }

  // update_expression: ++x / x++.  The grammar does not field prefix/postfix;
  // it falls out of whether the argument begins after the node's own start.
  fn update_expression(self, node: capp.CSTNode) -> (Option<Expression>, Slice<Diagnostic>) {
    let pos = node_pos(node)

    let operator_node = match node.ChildByFieldName(capp.FieldOperator) {
      Some(n) => n,
      None => return (None, self.malformed(node, "update without operator")),
    }
    let operator = if operator_node.Kind() == "--" {
      UpdateOp.Decrement
    } else {
      UpdateOp.Increment
    }

    let argument_node = match node.ChildByFieldName(capp.FieldArgument) {
      Some(n) => n,
      None => return (None, self.malformed(node, "update without argument")),
    }
    // The boundary exposes only row/column, not byte offset.  For ++x the
    // operator precedes the argument, so the node starts strictly before the
    // argument; for x++ the argument starts at the node's own start.
    let node_row = node.StartRow()
    let arg_row = argument_node.StartRow()
    let is_prefix = node_row < arg_row ||
    (node_row == arg_row && node.StartColumn() < argument_node.StartColumn())

    let (argument_opt, diags) = self.expression(argument_node)
    let Some(argument) = argument_opt else {
      return (None, diags)
    }

    let lowered = UpdateExpression { 
      operator,
      argument: &argument,
      is_prefix,
      pos,
    }
    (Some(Expression.Update(lowered)), diags)
  }

  fn await_expression(self, node: capp.CSTNode) -> (Option<Expression>, Slice<Diagnostic>) {
    let pos = node_pos(node)
    for i in 0..node.NamedChildCount() {
      let child = node.NamedChild(i)
      if skippable(child.Kind()) { continue }
      let (expr_opt, diags) = self.expression(child)
      let Some(expr) = expr_opt else {
        return (None, diags)
      }
      let lowered = AwaitExpression { argument: &expr, pos }
      return (Some(Expression.Await(lowered)), diags)
    }
    (None, self.malformed(node, "await without argument"))
  }

  // yield_expression: the argument is optional (bare `yield` is valid) and
  // the anonymous '*' marks the delegating `yield*` form.
  fn yield_expression(self, node: capp.CSTNode) -> (Option<Expression>, Slice<Diagnostic>) {
    let pos = node_pos(node)
    let is_delegate = has_anonymous_child(node, "*")
    for i in 0..node.NamedChildCount() {
      let child = node.NamedChild(i)
      if skippable(child.Kind()) { continue }
      let (expr_opt, diags) = self.expression(child)
      let Some(expr) = expr_opt else {
        return (None, diags)
      }
      let lowered = YieldExpression { argument: Some(&expr), is_delegate, pos }
      return (Some(Expression.Yield(lowered)), diags)
    }
    let lowered = YieldExpression { argument: None, is_delegate, pos }
    (Some(Expression.Yield(lowered)), [])
  }

  // -------------------------------------------------------------------------
  // Expressions — assignment
  // -------------------------------------------------------------------------

  // assignment_expression splits on the left side: an @deref target routes to
  // ObjjDerefAssignment with its compound operator; everything else is a
  // StandardAssignment whose target is a parenthesized expression or an lhs.
  fn assignment_expression(self, node: capp.CSTNode) -> (Option<Expression>, Slice<Diagnostic>) {
    let pos = node_pos(node)
    let mut diags: Slice<Diagnostic> = []

    let left_node = match node.ChildByFieldName(capp.FieldLeft) {
      Some(n) => n,
      None => return (None, self.malformed(node, "assignment without target")),
    }
    let right_node = match node.ChildByFieldName(capp.FieldRight) {
      Some(n) => n,
      None => return (None, self.malformed(node, "assignment without value")),
    }

    let (right_opt, right_diags) = self.expression(right_node)
    diags = merge_diags(diags, right_diags)
    let Some(right) = right_opt else {
      return (None, diags)
    }

    if left_node.Kind() == capp.NodeKindObjjDerefExpression {
      let (deref_opt, deref_diags) = self.objj_deref_struct(left_node)
      diags = merge_diags(diags, deref_diags)
      let Some(deref) = deref_opt else {
        return (None, diags)
      }
      // The @deref assignment operator is an unfielded anonymous choice; it is
      // recovered by scanning for the operator token between target and value.
      let operator = self.scan_assignment_op(node)
      let lowered = ObjjDerefAssignment { 
        left: deref,
        operator,
        right: &right,
        pos,
      }
      return (
        Some(Expression.Assignment(AssignmentExpression.ObjjDeref(lowered))),
        diags,
      )
    }

    let (target_opt, target_diags) = self.assignment_target(left_node)
    diags = merge_diags(diags, target_diags)
    let Some(target) = target_opt else {
      return (None, diags)
    }
    let lowered = StandardAssignment { left: target, right: &right, pos }
    (Some(Expression.Assignment(AssignmentExpression.Standard(lowered))), diags)
  }

  // scan_assignment_op recovers the @deref-assignment operator from the
  // unfielded anonymous token between target and value.  Absent a match the
  // bare '=' is assumed, which is the dominant case.
  fn scan_assignment_op(self, node: capp.CSTNode) -> AssignmentOp {
    for i in 0..node.ChildCount() {
      let child = node.Child(i)
      if let Some(op) = self.assignment_op(child) { return op }
    }
    AssignmentOp.Assign
  }

  // assignment_target lowers the StandardAssignment left side: a parenthesized
  // expression, or an lhs (identifier / member / subscript / undefined).
  // Destructuring patterns are deferred.
  fn assignment_target(self, node: capp.CSTNode) -> (Option<AssignmentTarget>, Slice<Diagnostic>) {
    if node.Kind() == capp.NodeKindParenthesizedExpression {
      let (paren_opt, diags) = self.parenthesized(node)
      let Some(paren) = paren_opt else {
        return (None, diags)
      }
      return (Some(AssignmentTarget.Parenthesized(&paren)), diags)
    }
    let (lhs_opt, diags) = self.lhs_expression(node)
    let Some(lhs) = lhs_opt else {
      return (None, diags)
    }
    (Some(AssignmentTarget.Lhs(&lhs)), diags)
  }

  // lhs_expression lowers an assignment / binding target to LhsExpression.
  // Member and subscript draw on the bare-struct producers.  Destructuring
  // patterns (object_pattern / array_pattern) are deferred behind the
  // unhandled catch-all.
  fn lhs_expression(self, node: capp.CSTNode) -> (Option<LhsExpression>, Slice<Diagnostic>) {
    let kind = node.Kind()
    if kind == capp.NodeKindIdentifier {
      return (Some(LhsExpression.Identifier(ident_of(node))), [])
    }
    if kind == capp.NodeKindUndefined {
      return (
        Some(LhsExpression.Undefined(UndefinedLiteral { pos: node_pos(node) })),
        [],
      )
    }
    if kind == capp.NodeKindMemberExpression {
      let (member_opt, diags) = self.member_expr_struct(node)
      let Some(member) = member_opt else {
        return (None, diags)
      }
      return (Some(LhsExpression.Member(&member)), diags)
    }
    if kind == capp.NodeKindSubscriptExpression {
      let (subscript_opt, diags) = self.subscript_expr_struct(node)
      let Some(subscript) = subscript_opt else {
        return (None, diags)
      }
      return (Some(LhsExpression.Subscript(&subscript)), diags)
    }
    (None, self.unhandled(node, "assignment target", kind))
  }

  fn augmented_assignment_expression(self, node: capp.CSTNode) -> (Option<Expression>, Slice<Diagnostic>) {
    let pos = node_pos(node)
    let mut diags: Slice<Diagnostic> = []

    let left_node = match node.ChildByFieldName(capp.FieldLeft) {
      Some(n) => n,
      None => return (
        None,
        self.malformed(node, "augmented assignment without target"),
      ),
    }
    let (target_opt, target_diags) = self.augmented_target(left_node)
    diags = merge_diags(diags, target_diags)
    let Some(target) = target_opt else {
      return (None, diags)
    }

    let operator_node = match node.ChildByFieldName(capp.FieldOperator) {
      Some(n) => n,
      None => return (
        None,
        merge_diags(
          diags,
          self.malformed(node, "augmented assignment without operator"),
        ),
      ),
    }
    let Some(operator) = self.augmented_op(operator_node) else {
      return (
        None,
        merge_diags(
          diags,
          self.unhandled(
            operator_node,
            "augmented operator",
            operator_node.Kind(),
          ),
        ),
      )
    }

    let right_node = match node.ChildByFieldName(capp.FieldRight) {
      Some(n) => n,
      None => return (
        None,
        merge_diags(
          diags,
          self.malformed(node, "augmented assignment without value"),
        ),
      ),
    }
    let (right_opt, right_diags) = self.expression(right_node)
    diags = merge_diags(diags, right_diags)
    let Some(right) = right_opt else {
      return (None, diags)
    }

    let lowered = AugmentedAssignmentExpression { 
      left: target,
      operator,
      right: &right,
      pos,
    }
    (Some(Expression.AugmentedAssignment(lowered)), diags)
  }

  // augmented_target: the narrower target set permitted on +=-family
  // assignment — identifier, member, subscript, or parenthesized.  No
  // destructuring or deref here, per the grammar.
  fn augmented_target(self, node: capp.CSTNode) -> (Option<AugmentedAssignmentTarget>, Slice<Diagnostic>) {
    let kind = node.Kind()
    if kind == capp.NodeKindIdentifier {
      return (Some(AugmentedAssignmentTarget.Identifier(ident_of(node))), [])
    }
    if kind == capp.NodeKindMemberExpression {
      let (member_opt, diags) = self.member_expr_struct(node)
      let Some(member) = member_opt else {
        return (None, diags)
      }
      return (Some(AugmentedAssignmentTarget.Member(&member)), diags)
    }
    if kind == capp.NodeKindSubscriptExpression {
      let (subscript_opt, diags) = self.subscript_expr_struct(node)
      let Some(subscript) = subscript_opt else {
        return (None, diags)
      }
      return (Some(AugmentedAssignmentTarget.Subscript(&subscript)), diags)
    }
    if kind == capp.NodeKindParenthesizedExpression {
      let (paren_opt, diags) = self.parenthesized(node)
      let Some(paren) = paren_opt else {
        return (None, diags)
      }
      return (Some(AugmentedAssignmentTarget.Parenthesized(&paren)), diags)
    }
    (None, self.unhandled(node, "augmented target", kind))
  }

  // -------------------------------------------------------------------------
  // Expressions — new / object / array / function / regex
  // -------------------------------------------------------------------------

  // new_expr_struct is recursive: `new new C()()` nests, with the constructor
  // either another new_expression or a primary.  The constructor field is the
  // hidden primary_expression supertype, surfacing as its concrete primary.
  fn new_expr_struct(self, node: capp.CSTNode) -> (Option<NewExpression>, Slice<Diagnostic>) {
    let pos = node_pos(node)
    let mut diags: Slice<Diagnostic> = []

    let constructor_node = match node.ChildByFieldName(capp.FieldConstructor) {
      Some(n) => n,
      None => return (None, self.malformed(node, "new without constructor")),
    }
    let constructor = if constructor_node.Kind() == capp.NodeKindNewExpression {
      let (inner_opt, ds) = self.new_expr_struct(constructor_node)
      diags = merge_diags(diags, ds)
      match inner_opt {
        Some(inner) => NewConstructor.New(&inner),
        None => return (None, diags),
      }
    } else {
      let (primary_opt, ds) = self.primary_struct(constructor_node)
      diags = merge_diags(diags, ds)
      match primary_opt {
        Some(primary) => NewConstructor.Primary(&primary),
        None => return (None, diags),
      }
    }

    let mut arguments: Option<Arguments> = None
    if let Some(arguments_node) = node.ChildByFieldName(capp.FieldArguments) {
      let (args, args_diags) = self.arguments(arguments_node)
      diags = merge_diags(diags, args_diags)
      arguments = Some(args)
    }

    (Some(NewExpression { constructor, arguments, pos }), diags)
  }

  // primary_struct unwraps a lowered Expression to its bare PrimaryExpression,
  // for the one position — new's constructor — that requires it.  A
  // non-primary expression in constructor position is a grammar impossibility;
  // it is reported rather than silently wrapped.
  fn primary_struct(self, node: capp.CSTNode) -> (Option<PrimaryExpression>, Slice<Diagnostic>) {
    let (expr_opt, diags) = self.expression(node)
    let Some(expr) = expr_opt else {
      return (None, diags)
    }
    match expr {
      Expression.Primary(primary) => (Some(primary), diags),
      _ => (
        None,
        merge_diags(
          diags,
          self.malformed(node, "new constructor is not a primary expression"),
        ),
      ),
    }
  }

  fn object_literal(self, node: capp.CSTNode) -> (Option<Object>, Slice<Diagnostic>) {
    let mut members: Slice<ObjectMember> = []
    let mut diags: Slice<Diagnostic> = []
    for i in 0..node.NamedChildCount() {
      let child = node.NamedChild(i)
      let kind = child.Kind()
      if skippable(kind) { continue }
      if kind == capp.NodeKindPair {
        let (pair_opt, ds) = self.pair(child)
        diags = merge_diags(diags, ds)
        if let Some(pair) = pair_opt {
          members = members.append(ObjectMember.Pair(pair))
        }
      } else if kind == capp.NodeKindSpreadElement {
        let (spread_opt, ds) = self.spread(child)
        diags = merge_diags(diags, ds)
        if let Some(spread) = spread_opt {
          members = members.append(ObjectMember.Spread(spread))
        }
      } else if kind == capp.NodeKindMethodDefinition {
        // The ECMAScript object-method shorthand { foo() {} } is distinct
        // from the Objective-J method form and absent from the corpus; it is
        // deferred until a corpus exercises it.
        diags = merge_diags(diags, self.unhandled(child, "object member", kind))
      } else if kind == capp.NodeKindShorthandPropertyIdentifier {
        members = members.append(ObjectMember.Shorthand(ident_of(child)))
      } else {
        diags = merge_diags(diags, self.unhandled(child, "object member", kind))
      }
    }
    (Some(Object { members, pos: node_pos(node) }), diags)
  }

  fn pair(self, node: capp.CSTNode) -> (Option<Pair>, Slice<Diagnostic>) {
    let pos = node_pos(node)
    let mut diags: Slice<Diagnostic> = []

    let key_node = match node.ChildByFieldName(capp.FieldKey) {
      Some(n) => n,
      None => return (None, self.malformed(node, "pair without key")),
    }
    let (key_opt, key_diags) = self.property_name(key_node)
    diags = merge_diags(diags, key_diags)
    let Some(key) = key_opt else {
      return (None, diags)
    }

    let value_node = match node.ChildByFieldName(capp.FieldValue) {
      Some(n) => n,
      None => return (
        None,
        merge_diags(diags, self.malformed(node, "pair without value")),
      ),
    }
    let (value_opt, value_diags) = self.expression(value_node)
    diags = merge_diags(diags, value_diags)
    let Some(value) = value_opt else {
      return (None, diags)
    }

    (Some(Pair { key, value: &value, pos }), diags)
  }

  // property_name lowers the _property_name supertype plus its Objective-J
  // objj_string_literal addition.
  fn property_name(self, node: capp.CSTNode) -> (Option<PropertyName>, Slice<Diagnostic>) {
    let kind = node.Kind()
    if kind == capp.NodeKindPropertyIdentifier {
      return (Some(PropertyName.Identifier(ident_of(node))), [])
    }
    if kind == capp.NodeKindPrivatePropertyIdentifier {
      return (
        Some(PropertyName.Private(
          PrivatePropertyIdentifier { text: node.Text(), pos: node_pos(node) },
        )),
        [],
      )
    }
    if kind == capp.NodeKindString {
      let (literal, diags) = self.string_literal(node)
      return (Some(PropertyName.String(literal)), diags)
    }
    if kind == capp.NodeKindNumber {
      return (
        Some(PropertyName.Number(
          NumberLiteral { text: node.Text(), pos: node_pos(node) },
        )),
        [],
      )
    }
    if kind == capp.NodeKindComputedPropertyName {
      let (computed_opt, diags) = self.computed_property_name(node)
      let Some(computed) = computed_opt else {
        return (None, diags)
      }
      return (Some(PropertyName.Computed(computed)), diags)
    }
    if kind == capp.NodeKindObjjStringLiteral {
      let (literal_opt, diags) = self.objj_string_literal(node)
      let Some(literal) = literal_opt else {
        return (None, diags)
      }
      return (Some(PropertyName.ObjjString(literal)), diags)
    }
    (None, self.unhandled(node, "property name", kind))
  }

  fn computed_property_name(self, node: capp.CSTNode) -> (Option<ComputedPropertyName>, Slice<Diagnostic>) {
    let pos = node_pos(node)
    for i in 0..node.NamedChildCount() {
      let child = node.NamedChild(i)
      if skippable(child.Kind()) { continue }
      let (expr_opt, diags) = self.expression(child)
      let Some(expr) = expr_opt else {
        return (None, diags)
      }
      return (Some(ComputedPropertyName { expression: &expr, pos }), diags)
    }
    (None, self.malformed(node, "computed property name without expression"))
  }

  fn native_array(self, node: capp.CSTNode) -> (Option<NativeArray>, Slice<Diagnostic>) {
    let mut elements: Slice<ArrayElement> = []
    let mut diags: Slice<Diagnostic> = []
    for i in 0..node.NamedChildCount() {
      let child = node.NamedChild(i)
      let kind = child.Kind()
      if skippable(kind) { continue }
      if kind == capp.NodeKindSpreadElement {
        let (spread_opt, ds) = self.spread(child)
        diags = merge_diags(diags, ds)
        if let Some(spread) = spread_opt {
          elements = elements.append(ArrayElement.Spread(spread))
        }
      } else {
        let (expr_opt, ds) = self.expression(child)
        diags = merge_diags(diags, ds)
        if let Some(expr) = expr_opt {
          elements = elements.append(ArrayElement.Expression(&expr))
        }
      }
    }
    (Some(NativeArray { elements, pos: node_pos(node) }), diags)
  }

  fn function_expression(self, node: capp.CSTNode) -> (Option<FunctionExpression>, Slice<Diagnostic>) {
    let pos = node_pos(node)
    let is_async = has_anonymous_child(node, "async")
    let name = node.ChildByFieldName(capp.FieldName).map(ident_of)

    let parameters_node = match node.ChildByFieldName(capp.FieldParameters) {
      Some(n) => n,
      None => return (
        None,
        self.malformed(node, "function expression without parameters"),
      ),
    }
    let (parameters, param_diags) = self.formal_parameters(parameters_node)
    let mut diags = param_diags.clone()

    let body_node = match node.ChildByFieldName(capp.FieldBody) {
      Some(n) => n,
      None => return (
        None,
        merge_diags(
          diags,
          self.malformed(node, "function expression without body"),
        ),
      ),
    }
    let (body, body_diags) = self.statement_block(body_node)
    diags = merge_diags(diags, body_diags)

    (Some(FunctionExpression { is_async, name, parameters, body, pos }), diags)
  }

  // regex carries pattern and optional flags as named fields of literal text.
  fn regex_literal(self, node: capp.CSTNode) -> (Option<Regex>, Slice<Diagnostic>) {
    let pos = node_pos(node)
    let pattern_node = match node.ChildByFieldName(capp.FieldPattern) {
      Some(n) => n,
      None => return (None, self.malformed(node, "regex without pattern")),
    }
    let pattern = RegexPattern { 
      text: pattern_node.Text(),
      pos: node_pos(pattern_node),
    }
    let mut flags: Option<RegexFlags> = None
    if let Some(flags_node) = node.ChildByFieldName(capp.FieldFlags) {
      flags = Some(
        RegexFlags { text: flags_node.Text(), pos: node_pos(flags_node) },
      )
    }
    (Some(Regex { pattern, flags, pos }), [])
  }

  fn template_string(self, node: capp.CSTNode) -> (Option<TemplateString>, Slice<Diagnostic>) {
    let mut parts: Slice<TemplatePart> = []
    let mut diags: Slice<Diagnostic> = []
    for i in 0..node.NamedChildCount() {
      let child = node.NamedChild(i)
      let kind = child.Kind()
      if kind == capp.NodeKindStringFragment {
        let fragment = StringFragment { 
          text: child.Text(),
          pos: node_pos(child),
        }
        parts = parts.append(TemplatePart.Fragment(fragment))
      } else if kind == capp.NodeKindEscapeSequence {
        let escape = EscapeSequence { text: child.Text(), pos: node_pos(child) }
        parts = parts.append(TemplatePart.Escape(escape))
      } else if kind == capp.NodeKindTemplateSubstitution {
        let (substitution_opt, ds) = self.template_substitution(child)
        diags = merge_diags(diags, ds)
        if let Some(substitution) = substitution_opt {
          parts = parts.append(TemplatePart.Substitution(substitution))
        }
      } else if skippable(kind) {
        ()
      } else {
        diags = merge_diags(diags, self.unhandled(child, "template part", kind))
      }
    }
    (Some(TemplateString { parts, pos: node_pos(node) }), diags)
  }

  fn template_substitution(self, node: capp.CSTNode) -> (Option<TemplateSubstitution>, Slice<Diagnostic>) {
    let pos = node_pos(node)
    for i in 0..node.NamedChildCount() {
      let child = node.NamedChild(i)
      if skippable(child.Kind()) { continue }
      let (exprs_opt, diags) = self.expressions(child)
      let Some(exprs) = exprs_opt else {
        return (None, diags)
      }
      return (Some(TemplateSubstitution { expression: exprs, pos }), diags)
    }
    (None, self.malformed(node, "template substitution without expression"))
  }

  // arrow_function: a bare identifier parameter arrives in the `parameter`
  // field, a parenthesized list in `parameters`; the body is an expression
  // or a statement block.
  fn arrow_function(self, node: capp.CSTNode) -> (Option<ArrowFunction>, Slice<Diagnostic>) {
    let pos = node_pos(node)
    let is_async = has_anonymous_child(node, "async")
    let mut diags: Slice<Diagnostic> = []

    let parameters = match node.ChildByFieldName(capp.FieldParameter) {
      Some(parameter_node) => ArrowParameters.Single(ident_of(parameter_node)),
      None => {
        let parameters_node = match node.ChildByFieldName(capp.FieldParameters) {
          Some(n) => n,
          None => return (
            None,
            self.malformed(node, "arrow function without parameters"),
          ),
        }
        let (list, ds) = self.formal_parameters(parameters_node)
        diags = merge_diags(diags, ds)
        ArrowParameters.List(list)
      },
    }

    let body_node = match node.ChildByFieldName(capp.FieldBody) {
      Some(n) => n,
      None => return (
        None,
        merge_diags(diags, self.malformed(node, "arrow function without body")),
      ),
    }
    let body = if body_node.Kind() == capp.NodeKindStatementBlock {
      let (block, ds) = self.statement_block(body_node)
      diags = merge_diags(diags, ds)
      ArrowBody.Block(block)
    } else {
      let (expr_opt, ds) = self.expression(body_node)
      diags = merge_diags(diags, ds)
      match expr_opt {
        Some(expr) => ArrowBody.Expression(&expr),
        None => return (None, diags),
      }
    }

    (Some(ArrowFunction { is_async, parameters, body, pos }), diags)
  }

  fn generator_function(self, node: capp.CSTNode) -> (Option<GeneratorFunction>, Slice<Diagnostic>) {
    let pos = node_pos(node)
    let is_async = has_anonymous_child(node, "async")
    let name = node.ChildByFieldName(capp.FieldName).map(ident_of)

    let parameters_node = match node.ChildByFieldName(capp.FieldParameters) {
      Some(n) => n,
      None => return (
        None,
        self.malformed(node, "generator function without parameters"),
      ),
    }
    let (parameters, param_diags) = self.formal_parameters(parameters_node)
    let mut diags = param_diags.clone()

    let body_node = match node.ChildByFieldName(capp.FieldBody) {
      Some(n) => n,
      None => return (
        None,
        merge_diags(
          diags,
          self.malformed(node, "generator function without body"),
        ),
      ),
    }
    let (body, body_diags) = self.statement_block(body_node)
    diags = merge_diags(diags, body_diags)

    (Some(GeneratorFunction { is_async, name, parameters, body, pos }), diags)
  }

  fn generator_function_declaration(self, node: capp.CSTNode) -> (Option<GeneratorFunctionDeclaration>, Slice<Diagnostic>) {
    let pos = node_pos(node)
    let is_async = has_anonymous_child(node, "async")

    let name_node = match node.ChildByFieldName(capp.FieldName) {
      Some(n) => n,
      None => return (
        None,
        self.malformed(node, "generator declaration without name"),
      ),
    }

    let parameters_node = match node.ChildByFieldName(capp.FieldParameters) {
      Some(n) => n,
      None => return (
        None,
        self.malformed(node, "generator declaration without parameters"),
      ),
    }
    let (parameters, param_diags) = self.formal_parameters(parameters_node)
    let mut diags = param_diags.clone()

    let body_node = match node.ChildByFieldName(capp.FieldBody) {
      Some(n) => n,
      None => return (
        None,
        merge_diags(
          diags,
          self.malformed(node, "generator declaration without body"),
        ),
      ),
    }
    let (body, body_diags) = self.statement_block(body_node)
    diags = merge_diags(diags, body_diags)

    let declaration = GeneratorFunctionDeclaration { 
      is_async,
      name: ident_of(name_node),
      parameters,
      body,
      pos,
    }
    (Some(declaration), diags)
  }

  // -------------------------------------------------------------------------
  // Objective-J — ref / deref
  // -------------------------------------------------------------------------

  fn objj_ref_expression(self, node: capp.CSTNode) -> (Option<Expression>, Slice<Diagnostic>) {
    let pos = node_pos(node)
    for i in 0..node.NamedChildCount() {
      let child = node.NamedChild(i)
      if skippable(child.Kind()) { continue }
      let (expr_opt, diags) = self.expression(child)
      let Some(expr) = expr_opt else {
        return (None, diags)
      }
      let lowered = ObjjRefExpression { argument: &expr, pos }
      return (
        Some(Expression.Primary(PrimaryExpression.ObjjRef(lowered))),
        diags,
      )
    }
    (None, self.malformed(node, "@ref without argument"))
  }

  fn objj_deref_struct(self, node: capp.CSTNode) -> (Option<ObjjDerefExpression>, Slice<Diagnostic>) {
    let pos = node_pos(node)
    for i in 0..node.NamedChildCount() {
      let child = node.NamedChild(i)
      if skippable(child.Kind()) { continue }
      let (expr_opt, diags) = self.expression(child)
      let Some(expr) = expr_opt else {
        return (None, diags)
      }
      return (Some(ObjjDerefExpression { argument: &expr, pos }), diags)
    }
    (None, self.malformed(node, "@deref without argument"))
  }

  // -------------------------------------------------------------------------
  // Objective-J — literals
  // -------------------------------------------------------------------------

  // objj_string_literal wraps a single string node: @"...".
  fn objj_string_literal(self, node: capp.CSTNode) -> (Option<ObjjStringLiteral>, Slice<Diagnostic>) {
    let pos = node_pos(node)
    for i in 0..node.NamedChildCount() {
      let child = node.NamedChild(i)
      if child.Kind() != capp.NodeKindString { continue }
      let (value, diags) = self.string_literal(child)
      return (Some(ObjjStringLiteral { value, pos }), diags)
    }
    (None, self.malformed(node, "objj string without string"))
  }

  fn objj_selector_expression(self, node: capp.CSTNode) -> (Option<ObjjSelectorExpression>, Slice<Diagnostic>) {
    let pos = node_pos(node)
    for i in 0..node.NamedChildCount() {
      let child = node.NamedChild(i)
      if child.Kind() != capp.NodeKindObjjSelectorName { continue }
      let (name_opt, diags) = self.objj_selector_name(child)
      let Some(name) = name_opt else {
        return (None, diags)
      }
      return (Some(ObjjSelectorExpression { name, pos }), diags)
    }
    (None, self.malformed(node, "@selector without name"))
  }

  // objj_selector_name: the named children are the selector identifiers and
  // the colons are anonymous.  A colon anywhere makes it a keyword selector;
  // otherwise the single identifier is the unary form.
  fn objj_selector_name(self, node: capp.CSTNode) -> (Option<ObjjSelectorName>, Slice<Diagnostic>) {
    if has_anonymous_child(node, ":") {
      let mut parts: Slice<ObjjSelectorNamePart> = []
      for i in 0..node.NamedChildCount() {
        let child = node.NamedChild(i)
        if child.Kind() != capp.NodeKindObjjSelectorIdentifier { continue }
        let part = ObjjSelectorNamePart { 
          name: selector_ident_of(child),
          pos: node_pos(child),
        }
        parts = parts.append(part)
      }
      if parts.is_empty() {
        return (None, self.malformed(node, "selector without identifiers"))
      }
      return (Some(ObjjSelectorName.Keyword(parts)), [])
    }
    for i in 0..node.NamedChildCount() {
      let child = node.NamedChild(i)
      if child.Kind() != capp.NodeKindObjjSelectorIdentifier { continue }
      return (Some(ObjjSelectorName.Unary(selector_ident_of(child))), [])
    }
    (None, self.malformed(node, "selector without identifiers"))
  }

  fn objj_dictionary_literal(self, node: capp.CSTNode) -> (Option<ObjjDictionaryLiteral>, Slice<Diagnostic>) {
    let mut pairs: Slice<ObjjDictionaryPair> = []
    let mut diags: Slice<Diagnostic> = []
    for i in 0..node.NamedChildCount() {
      let child = node.NamedChild(i)
      let kind = child.Kind()
      if skippable(kind) { continue }
      if kind != capp.NodeKindObjjDictionaryPair {
        diags = merge_diags(
          diags,
          self.unhandled(child, "dictionary entry", kind),
        )
        continue
      }
      let (pair_opt, ds) = self.objj_dictionary_pair(child)
      diags = merge_diags(diags, ds)
      if let Some(pair) = pair_opt { pairs = pairs.append(pair) }
    }
    (Some(ObjjDictionaryLiteral { pairs, pos: node_pos(node) }), diags)
  }

  // key and value arrive in single-purpose wrapper nodes (objj_dictionary_key
  // / objj_dictionary_value) whose meaning is the single named child.
  fn objj_dictionary_pair(self, node: capp.CSTNode) -> (Option<ObjjDictionaryPair>, Slice<Diagnostic>) {
    let pos = node_pos(node)
    let mut diags: Slice<Diagnostic> = []

    let key_node = match node.ChildByFieldName(capp.FieldKey) {
      Some(n) => n,
      None => return (None, self.malformed(node, "dictionary pair without key")),
    }
    let (key_opt, key_diags) = self.wrapped_expression(
      key_node,
      "dictionary key without expression",
    )
    diags = merge_diags(diags, key_diags)
    let Some(key) = key_opt else {
      return (None, diags)
    }

    let value_node = match node.ChildByFieldName(capp.FieldValue) {
      Some(n) => n,
      None => return (
        None,
        merge_diags(
          diags,
          self.malformed(node, "dictionary pair without value"),
        ),
      ),
    }
    let (value_opt, value_diags) = self.wrapped_expression(
      value_node,
      "dictionary value without expression",
    )
    diags = merge_diags(diags, value_diags)
    let Some(value) = value_opt else {
      return (None, diags)
    }

    (Some(ObjjDictionaryPair { key: &key, value: &value, pos }), diags)
  }

  // wrapped_expression descends through a single-purpose wrapper node to its
  // one named child and lowers it as an expression.  `what` is the complete
  // malformed message for an empty wrapper.
  fn wrapped_expression(self, node: capp.CSTNode, what: string) -> (Option<Expression>, Slice<Diagnostic>) {
    for i in 0..node.NamedChildCount() {
      let child = node.NamedChild(i)
      if skippable(child.Kind()) { continue }
      return self.expression(child)
    }
    (None, self.malformed(node, what))
  }

  // objj_array_literal wraps a single native_array: @[...].
  fn objj_array_literal(self, node: capp.CSTNode) -> (Option<ObjjArrayLiteral>, Slice<Diagnostic>) {
    let pos = node_pos(node)
    for i in 0..node.NamedChildCount() {
      let child = node.NamedChild(i)
      if child.Kind() != capp.NodeKindNativeArray { continue }
      let (array_opt, diags) = self.native_array(child)
      let Some(array) = array_opt else {
        return (None, diags)
      }
      return (Some(ObjjArrayLiteral { array, pos }), diags)
    }
    (None, self.malformed(node, "objj array without array"))
  }

  // -------------------------------------------------------------------------
  // Objective-J — declarations
  // -------------------------------------------------------------------------

  fn objj_class_forward_declaration(self, node: capp.CSTNode) -> (Option<Statement>, Slice<Diagnostic>) {
    let name_node = match node.ChildByFieldName(capp.FieldName) {
      Some(n) => n,
      None => return (None, self.malformed(node, "@class without name")),
    }
    let declaration = ObjjClassForwardDeclaration { 
      name: ident_of(name_node),
      pos: node_pos(node),
    }
    (Some(Statement.ObjjClassForward(declaration)), [])
  }

  fn objj_global_struct(self, node: capp.CSTNode) -> (Option<ObjjGlobalDeclaration>, Slice<Diagnostic>) {
    let name_node = match node.ChildByFieldName(capp.FieldName) {
      Some(n) => n,
      None => return (None, self.malformed(node, "@global without name")),
    }
    let declaration = ObjjGlobalDeclaration { 
      name: ident_of(name_node),
      pos: node_pos(node),
    }
    (Some(declaration), [])
  }

  fn objj_global_declaration(self, node: capp.CSTNode) -> (Option<Statement>, Slice<Diagnostic>) {
    let (global_opt, diags) = self.objj_global_struct(node)
    let Some(global) = global_opt else {
      return (None, diags)
    }
    (Some(Statement.ObjjGlobal(global)), diags)
  }

  fn objj_typedef(self, node: capp.CSTNode) -> (Option<Statement>, Slice<Diagnostic>) {
    let name_node = match node.ChildByFieldName(capp.FieldName) {
      Some(n) => n,
      None => return (None, self.malformed(node, "@typedef without name")),
    }
    let declaration = ObjjTypedef { 
      name: ident_of(name_node),
      pos: node_pos(node),
    }
    (Some(Statement.ObjjTypedef(declaration)), [])
  }

  // The protocol body interleaves anonymous @optional/@required markers with
  // objj_method_declaration members; ordering matters, so the walk covers all
  // children rather than only named ones.
  fn objj_protocol_declaration(self, node: capp.CSTNode) -> (Option<Statement>, Slice<Diagnostic>) {
    let pos = node_pos(node)
    let mut diags: Slice<Diagnostic> = []

    let name_node = match node.ChildByFieldName(capp.FieldName) {
      Some(n) => n,
      None => return (None, self.malformed(node, "@protocol without name")),
    }

    let mut protocols: Option<ObjjProtocolReferenceList> = None
    if let Some(list_node) = node.ChildByFieldName(capp.FieldProtocols) {
      protocols = Some(protocol_list(list_node))
    }

    let mut members: Slice<ObjjProtocolMember> = []
    for i in 0..node.ChildCount() {
      let child = node.Child(i)
      let kind = child.Kind()
      if kind == "@optional" {
        members = members.append(ObjjProtocolMember.Optional(node_pos(child)))
        continue
      }
      if kind == "@required" {
        members = members.append(ObjjProtocolMember.Required(node_pos(child)))
        continue
      }
      if kind != capp.NodeKindObjjMethodDeclaration { continue }
      let (method_opt, ds) = self.objj_method_declaration(child)
      diags = merge_diags(diags, ds)
      if let Some(method) = method_opt {
        members = members.append(ObjjProtocolMember.Method(method))
      }
    }

    let declaration = ObjjProtocolDeclaration { 
      name: ident_of(name_node),
      protocols,
      members,
      pos,
    }
    (Some(Statement.ObjjProtocol(declaration)), diags)
  }

  // objj_method_declaration is the bodiless protocol form of
  // objj_method_definition; scope, return type, and selector lower
  // identically.
  fn objj_method_declaration(self, node: capp.CSTNode) -> (Option<ObjjMethodDeclaration>, Slice<Diagnostic>) {
    let pos = node_pos(node)
    let mut diags: Slice<Diagnostic> = []

    // The method_type field holds the anonymous '+' or '-' token.
    let scope = match node.ChildByFieldName(capp.FieldMethodType) {
      Some(scope_node) => {
        if scope_node.Text() == "+" {
          ObjjMethodScope.Class
        } else {
          ObjjMethodScope.Instance
        }
      },
      None => return (
        None,
        self.malformed(node, "method declaration without +/- indicator"),
      ),
    }

    let return_type_node = match node.ChildByFieldName(capp.FieldReturnType) {
      Some(n) => n,
      None => return (
        None,
        self.malformed(node, "method declaration without return type"),
      ),
    }
    let (return_type_opt, return_diags) = self.method_type(return_type_node)
    diags = merge_diags(diags, return_diags)
    let return_type = match return_type_opt {
      Some(t) => t,
      None => return (None, diags),
    }

    // Unary methods carry a fielded method_name; keyword methods carry one or
    // more unfielded objj_method_parameter_part children.
    let selector = match node.ChildByFieldName(capp.FieldMethodName) {
      Some(name_node) => ObjjMethodSelector.Unary(selector_ident_of(name_node)),
      None => {
        let mut parts: Slice<ObjjMethodParameterPart> = []
        for i in 0..node.NamedChildCount() {
          let child = node.NamedChild(i)
          if child.Kind() != capp.NodeKindObjjMethodParameterPart { continue }
          let (part_opt, ds) = self.parameter_part(child)
          diags = merge_diags(diags, ds)
          if let Some(part) = part_opt { parts = parts.append(part) }
        }
        if parts.is_empty() {
          return (
            None,
            merge_diags(
              diags,
              self.malformed(node, "method declaration without selector"),
            ),
          )
        }
        ObjjMethodSelector.Keyword(parts)
      },
    }

    let declaration = ObjjMethodDeclaration { 
      scope,
      return_type,
      selector,
      pos,
    }
    (Some(declaration), diags)
  }

  // -------------------------------------------------------------------------
  // Objective-J — accessors
  // -------------------------------------------------------------------------

  fn accessors_directive(self, node: capp.CSTNode) -> (Option<ObjjAccessorsDirective>, Slice<Diagnostic>) {
    let mut attributes: Slice<ObjjAccessorAttribute> = []
    let mut diags: Slice<Diagnostic> = []
    for i in 0..node.NamedChildCount() {
      let child = node.NamedChild(i)
      let kind = child.Kind()
      if skippable(kind) { continue }
      if kind != capp.NodeKindObjjAccessorAttribute {
        diags = merge_diags(
          diags,
          self.unhandled(child, "accessor attribute", kind),
        )
        continue
      }
      let (attribute_opt, ds) = self.accessor_attribute(child)
      diags = merge_diags(diags, ds)
      if let Some(attribute) = attribute_opt {
        attributes = attributes.append(attribute)
      }
    }
    (Some(ObjjAccessorsDirective { attributes, pos: node_pos(node) }), diags)
  }

  // objj_accessor_attribute: `key = name` (the '=' is anonymous) or a bare
  // flag identifier.  Presence of an objj_accessor_name child selects the
  // key-value form.
  fn accessor_attribute(self, node: capp.CSTNode) -> (Option<ObjjAccessorAttribute>, Slice<Diagnostic>) {
    let pos = node_pos(node)
    let mut diags: Slice<Diagnostic> = []
    let mut key: Option<Identifier> = None
    let mut name: Option<ObjjAccessorName> = None

    for i in 0..node.NamedChildCount() {
      let child = node.NamedChild(i)
      let kind = child.Kind()
      if kind == capp.NodeKindIdentifier {
        key = Some(ident_of(child))
        continue
      }
      if kind == capp.NodeKindObjjAccessorName {
        let (name_opt, ds) = self.accessor_name(child)
        diags = merge_diags(diags, ds)
        let Some(value) = name_opt else {
          return (None, diags)
        }
        name = Some(value)
      }
    }

    let Some(attribute_key) = key else {
      return (
        None,
        merge_diags(
          diags,
          self.malformed(node, "accessor attribute without key"),
        ),
      )
    }
    name.map_or_else(
      || (Some(ObjjAccessorAttribute.Flag(attribute_key)), diags),
      |value| (
        Some(ObjjAccessorAttribute.KeyValue(
          ObjjAccessorKeyValue { key: attribute_key, value, pos },
        )),
        diags,
      ),
    )
  }

  // objj_accessor_name: identifiers with anonymous colons.  No colon is the
  // simple form; a colon with a single identifier is a setter; further
  // identifiers make the keyword form.
  fn accessor_name(self, node: capp.CSTNode) -> (Option<ObjjAccessorName>, Slice<Diagnostic>) {
    let pos = node_pos(node)
    let mut head: Option<Identifier> = None
    let mut parts: Slice<Identifier> = []
    for i in 0..node.NamedChildCount() {
      let child = node.NamedChild(i)
      if child.Kind() != capp.NodeKindIdentifier { continue }
      match head {
        None => head = Some(ident_of(child)),
        Some(_) => parts = parts.append(ident_of(child)),
      }
    }
    let Some(name_head) = head else {
      return (None, self.malformed(node, "accessor name without identifier"))
    }
    if has_anonymous_child(node, ":") {
      if parts.is_empty() {
        return (
          Some(ObjjAccessorName.Setter(
            ObjjAccessorSetter { name: name_head, pos },
          )),
          [],
        )
      }
      return (
        Some(ObjjAccessorName.Keyword(
          ObjjAccessorKeyword { head: name_head, parts, pos },
        )),
        [],
      )
    }
    (Some(ObjjAccessorName.Simple(name_head)), [])
  }

  // -------------------------------------------------------------------------
  // Preprocessor
  // -------------------------------------------------------------------------

  // The if/else/endif lines are fielded; the body items are unfielded
  // children appearing in order, with the else line splitting body from the
  // else branch.  The walk covers all children, switching accumulation at
  // the else line.
  fn preproc_if_block_struct(self, node: capp.CSTNode) -> (Option<PreprocIfBlock>, Slice<Diagnostic>) {
    let pos = node_pos(node)
    let mut diags: Slice<Diagnostic> = []

    let if_line_node = match node.ChildByFieldName(capp.FieldIf) {
      Some(n) => n,
      None => return (None, self.malformed(node, "#if block without #if line")),
    }
    let (if_line_opt, if_diags) = self.preproc_if_line(if_line_node)
    diags = merge_diags(diags, if_diags)
    let Some(if_line) = if_line_opt else {
      return (None, diags)
    }

    let endif_node = match node.ChildByFieldName(capp.FieldEndif) {
      Some(n) => n,
      None => return (
        None,
        merge_diags(diags, self.malformed(node, "#if block without #endif")),
      ),
    }
    let endif = PreprocEndifLine { 
      text: endif_node.Text(),
      pos: node_pos(endif_node),
    }

    let mut body: Slice<PreprocBlockItem> = []
    let mut else_body: Slice<PreprocBlockItem> = []
    let mut else_node: Option<capp.CSTNode> = None
    let mut in_else = false
    for i in 0..node.ChildCount() {
      let child = node.Child(i)
      let kind = child.Kind()
      if kind == capp.NodeKindPreprocIfLine { continue }
      if kind == capp.NodeKindPreprocEndifLine { continue }
      if skippable(kind) { continue }
      // The grammar tolerates bare 'else' / 'else if' keyword tokens here —
      // its accommodation for if/else statements split across preprocessor
      // branches.  The model deliberately carries no representation for them.
      if kind == "else" { continue }
      if kind == "else if" { continue }
      if kind == capp.NodeKindPreprocElseLine {
        else_node = Some(child)
        in_else = true
        continue
      }
      let (item_opt, ds) = self.preproc_block_item(child)
      diags = merge_diags(diags, ds)
      if let Some(item) = item_opt {
        if in_else {
          else_body = else_body.append(item)
        } else {
          body = body.append(item)
        }
      }
    }

    let mut else_branch: Option<PreprocElseBranch> = None
    if let Some(line_node) = else_node {
      let else_line = PreprocElseLine { 
        text: line_node.Text(),
        pos: node_pos(line_node),
      }
      else_branch = Some(
        PreprocElseBranch { 
          else_line,
          body: else_body,
          pos: node_pos(line_node),
        },
      )
    }

    let block = PreprocIfBlock { if_line, body, else_branch, endif, pos }
    (Some(block), diags)
  }

  fn preproc_block_item(self, node: capp.CSTNode) -> (Option<PreprocBlockItem>, Slice<Diagnostic>) {
    let kind = node.Kind()
    if kind == capp.NodeKindPreprocIfBlock {
      let (nested_opt, diags) = self.preproc_if_block_struct(node)
      let Some(nested) = nested_opt else {
        return (None, diags)
      }
      return (Some(PreprocBlockItem.Nested(nested)), diags)
    }
    if kind == capp.NodeKindPreprocDirective {
      let directive = PreprocDirective { 
        text: node.Text(),
        pos: node_pos(node),
      }
      return (Some(PreprocBlockItem.Directive(directive)), [])
    }
    let (stmt_opt, diags) = self.statement(node)
    let Some(stmt) = stmt_opt else {
      return (None, diags)
    }
    (Some(PreprocBlockItem.Statement(stmt)), diags)
  }

  // preproc_ivar_if_block mirrors preproc_if_block over ivar items, with
  // recursive nesting.
  fn preproc_ivar_if_block_struct(self, node: capp.CSTNode) -> (Option<PreprocIvarIfBlock>, Slice<Diagnostic>) {
    let pos = node_pos(node)
    let mut diags: Slice<Diagnostic> = []

    let if_line_node = match node.ChildByFieldName(capp.FieldIf) {
      Some(n) => n,
      None => return (
        None,
        self.malformed(node, "#if ivar block without #if line"),
      ),
    }
    let (if_line_opt, if_diags) = self.preproc_if_line(if_line_node)
    diags = merge_diags(diags, if_diags)
    let Some(if_line) = if_line_opt else {
      return (None, diags)
    }

    let endif_node = match node.ChildByFieldName(capp.FieldEndif) {
      Some(n) => n,
      None => return (
        None,
        merge_diags(
          diags,
          self.malformed(node, "#if ivar block without #endif"),
        ),
      ),
    }
    let endif = PreprocEndifLine { 
      text: endif_node.Text(),
      pos: node_pos(endif_node),
    }

    let mut body: Slice<PreprocIvarItem> = []
    let mut else_body: Slice<PreprocIvarItem> = []
    let mut else_node: Option<capp.CSTNode> = None
    let mut in_else = false
    for i in 0..node.ChildCount() {
      let child = node.Child(i)
      let kind = child.Kind()
      if kind == capp.NodeKindPreprocIfLine { continue }
      if kind == capp.NodeKindPreprocEndifLine { continue }
      if skippable(kind) { continue }
      if kind == capp.NodeKindPreprocElseLine {
        else_node = Some(child)
        in_else = true
        continue
      }
      let (item_opt, ds) = self.preproc_ivar_item(child)
      diags = merge_diags(diags, ds)
      if let Some(item) = item_opt {
        if in_else {
          else_body = else_body.append(item)
        } else {
          body = body.append(item)
        }
      }
    }

    let mut else_branch: Option<PreprocIvarElseBranch> = None
    if let Some(line_node) = else_node {
      let else_line = PreprocElseLine { 
        text: line_node.Text(),
        pos: node_pos(line_node),
      }
      else_branch = Some(
        PreprocIvarElseBranch { 
          else_line,
          body: else_body,
          pos: node_pos(line_node),
        },
      )
    }

    let block = PreprocIvarIfBlock { if_line, body, else_branch, endif, pos }
    (Some(block), diags)
  }

  fn preproc_ivar_item(self, node: capp.CSTNode) -> (Option<PreprocIvarItem>, Slice<Diagnostic>) {
    let kind = node.Kind()
    if kind == capp.NodeKindObjjInstanceVariable {
      let (variable_opt, diags) = self.instance_variable(node)
      let Some(variable) = variable_opt else {
        return (None, diags)
      }
      return (Some(PreprocIvarItem.Variable(variable)), diags)
    }
    if kind == capp.NodeKindPreprocIvarIfBlock {
      let (nested_opt, diags) = self.preproc_ivar_if_block_struct(node)
      let Some(nested) = nested_opt else {
        return (None, diags)
      }
      return (Some(PreprocIvarItem.Nested(nested)), diags)
    }
    if kind == capp.NodeKindPreprocDirective {
      let directive = PreprocDirective { 
        text: node.Text(),
        pos: node_pos(node),
      }
      return (Some(PreprocIvarItem.Directive(directive)), [])
    }
    (None, self.unhandled(node, "preprocessor ivar item", kind))
  }

  fn preproc_if_line(self, node: capp.CSTNode) -> (Option<PreprocIfLine>, Slice<Diagnostic>) {
    let pos = node_pos(node)
    let condition_node = match node.ChildByFieldName(capp.FieldCondition) {
      Some(n) => n,
      None => return (None, self.malformed(node, "#if without condition")),
    }
    let (condition_opt, diags) = self.preproc_condition(condition_node)
    let Some(condition) = condition_opt else {
      return (None, diags)
    }
    (Some(PreprocIfLine { condition, pos }), diags)
  }

  fn preproc_condition(self, node: capp.CSTNode) -> (Option<PreprocCondition>, Slice<Diagnostic>) {
    let pos = node_pos(node)
    for i in 0..node.NamedChildCount() {
      let child = node.NamedChild(i)
      if child.Kind() != capp.NodeKindPreprocDisjunction { continue }
      let (disjunction_opt, diags) = self.preproc_disjunction(child)
      let Some(disjunction) = disjunction_opt else {
        return (None, diags)
      }
      return (Some(PreprocCondition { disjunction, pos }), diags)
    }
    (None, self.malformed(node, "preprocessor condition without content"))
  }

  fn preproc_disjunction(self, node: capp.CSTNode) -> (Option<PreprocDisjunction>, Slice<Diagnostic>) {
    let mut conjunctions: Slice<PreprocConjunction> = []
    let mut diags: Slice<Diagnostic> = []
    for i in 0..node.NamedChildCount() {
      let child = node.NamedChild(i)
      if child.Kind() != capp.NodeKindPreprocConjunction { continue }
      let (conjunction_opt, ds) = self.preproc_conjunction(child)
      diags = merge_diags(diags, ds)
      match conjunction_opt {
        Some(conjunction) => conjunctions = conjunctions.append(conjunction),
        None => return (None, diags),
      }
    }
    if conjunctions.is_empty() {
      return (
        None,
        merge_diags(
          diags,
          self.malformed(node, "preprocessor disjunction without terms"),
        ),
      )
    }
    (Some(PreprocDisjunction { conjunctions, pos: node_pos(node) }), diags)
  }

  fn preproc_conjunction(self, node: capp.CSTNode) -> (Option<PreprocConjunction>, Slice<Diagnostic>) {
    let mut negations: Slice<PreprocNegation> = []
    let mut diags: Slice<Diagnostic> = []
    for i in 0..node.NamedChildCount() {
      let child = node.NamedChild(i)
      if child.Kind() != capp.NodeKindPreprocNegation { continue }
      let (negation_opt, ds) = self.preproc_negation(child)
      diags = merge_diags(diags, ds)
      match negation_opt {
        Some(negation) => negations = negations.append(negation),
        None => return (None, diags),
      }
    }
    if negations.is_empty() {
      return (
        None,
        merge_diags(
          diags,
          self.malformed(node, "preprocessor conjunction without terms"),
        ),
      )
    }
    (Some(PreprocConjunction { negations, pos: node_pos(node) }), diags)
  }

  // preproc_negation holds either a nested negation (the '!' form, with the
  // bang anonymous) or a primary.
  fn preproc_negation(self, node: capp.CSTNode) -> (Option<PreprocNegation>, Slice<Diagnostic>) {
    for i in 0..node.NamedChildCount() {
      let child = node.NamedChild(i)
      let kind = child.Kind()
      if kind == capp.NodeKindPreprocNegation {
        let (inner_opt, diags) = self.preproc_negation(child)
        let Some(inner) = inner_opt else {
          return (None, diags)
        }
        return (
          Some(PreprocNegation.Not(
            PreprocNegationInner { operand: &inner, pos: node_pos(node) },
          )),
          diags,
        )
      }
      if kind == capp.NodeKindPreprocPrimary {
        let (primary_opt, diags) = self.preproc_primary(child)
        let Some(primary) = primary_opt else {
          return (None, diags)
        }
        return (Some(PreprocNegation.Primary(primary)), diags)
      }
    }
    (None, self.malformed(node, "preprocessor negation without operand"))
  }

  // preproc_primary discriminates four ways: a callee field marks the call
  // form; a nested condition marks grouping; an anonymous comparison
  // operator marks comparison; otherwise the single identifier stands alone.
  fn preproc_primary(self, node: capp.CSTNode) -> (Option<PreprocPrimary>, Slice<Diagnostic>) {
    let pos = node_pos(node)

    if let Some(callee_node) = node.ChildByFieldName(capp.FieldCallee) {
      // The callee is itself an identifier among identifier children; it
      // is excluded from the arguments by position.
      let callee_row = callee_node.StartRow()
      let callee_column = callee_node.StartColumn()
      let mut arguments: Slice<Identifier> = []
      for i in 0..node.NamedChildCount() {
        let child = node.NamedChild(i)
        if child.Kind() != capp.NodeKindIdentifier { continue }
        if child.StartRow() == callee_row &&
        child.StartColumn() == callee_column {
          continue
        }
        arguments = arguments.append(ident_of(child))
      }
      return (
        Some(PreprocPrimary.Call(
          PreprocCall { callee: ident_of(callee_node), arguments, pos },
        )),
        [],
      )
    }

    for i in 0..node.NamedChildCount() {
      let child = node.NamedChild(i)
      if child.Kind() != capp.NodeKindPreprocCondition { continue }
      let (condition_opt, diags) = self.preproc_condition(child)
      let Some(condition) = condition_opt else {
        return (None, diags)
      }
      return (
        Some(PreprocPrimary.Grouped(
          PreprocGrouped { condition: &condition, pos },
        )),
        diags,
      )
    }

    let mut compare_op: Option<PreprocCompareOp> = None
    if has_anonymous_child(node, "==") {
      compare_op = Some(PreprocCompareOp.Equal)
    }
    if has_anonymous_child(node, "!=") {
      compare_op = Some(PreprocCompareOp.NotEqual)
    }
    if has_anonymous_child(node, "<=") {
      compare_op = Some(PreprocCompareOp.LessEqual)
    }
    if has_anonymous_child(node, ">=") {
      compare_op = Some(PreprocCompareOp.GreaterEqual)
    }
    if has_anonymous_child(node, "<") {
      compare_op = Some(PreprocCompareOp.LessThan)
    }
    if has_anonymous_child(node, ">") {
      compare_op = Some(PreprocCompareOp.GreaterThan)
    }
    if let Some(operator) = compare_op {
      let mut left: Option<Identifier> = None
      let mut right: Option<PreprocOperand> = None
      for i in 0..node.NamedChildCount() {
        let child = node.NamedChild(i)
        let kind = child.Kind()
        if kind == capp.NodeKindIdentifier {
          match left {
            None => left = Some(ident_of(child)),
            Some(_) => {
              if right.is_none() {
                right = Some(PreprocOperand.Identifier(ident_of(child)))
              }
            },
          }
          continue
        }
        if kind == capp.NodeKindNumber && right.is_none() {
          let number = NumberLiteral { 
            text: child.Text(),
            pos: node_pos(child),
          }
          right = Some(PreprocOperand.Number(number))
        }
      }
      let Some(compare_left) = left else {
        return (
          None,
          self.malformed(node, "preprocessor comparison without left side"),
        )
      }
      let Some(compare_right) = right else {
        return (
          None,
          self.malformed(node, "preprocessor comparison without right side"),
        )
      }
      let comparison = PreprocComparison { 
        left: compare_left,
        operator,
        right: compare_right,
        pos,
      }
      return (Some(PreprocPrimary.Comparison(comparison)), [])
    }

    for i in 0..node.NamedChildCount() {
      let child = node.NamedChild(i)
      if child.Kind() != capp.NodeKindIdentifier { continue }
      return (Some(PreprocPrimary.Identifier(ident_of(child))), [])
    }
    (None, self.malformed(node, "preprocessor primary without content"))
  }

  // -------------------------------------------------------------------------
  // Objective-J — message expressions
  // -------------------------------------------------------------------------

  fn message_expression(self, node: capp.CSTNode) -> (Option<Expression>, Slice<Diagnostic>) {
    let pos = node_pos(node)

    let receiver_node = match node.ChildByFieldName(capp.FieldReceiver) {
      Some(n) => n,
      None => return (None, self.malformed(node, "message without receiver")),
    }
    let selector_node = match node.ChildByFieldName(capp.FieldSelector) {
      Some(n) => n,
      None => return (None, self.malformed(node, "message without selector")),
    }

    let (receiver_opt, receiver_diags) = self.expression(receiver_node)
    let mut diags = receiver_diags.clone()
    let receiver = match receiver_opt {
      Some(receiver_expr) => receiver_expr,
      None => return (None, diags),
    }

    let (selector_opt, selector_diags) = self.message_selector(selector_node)
    diags = merge_diags(diags, selector_diags)
    let selector = match selector_opt {
      Some(sel) => sel,
      None => return (None, diags),
    }

    let message = ObjjMessageExpression { receiver: &receiver, selector, pos }
    (Some(Expression.Primary(PrimaryExpression.ObjjMessage(message))), diags)
  }

  // message_selector lowers the objj_message_selector wrapper: its named
  // children are either a single objj_selector_identifier (unary send) or one
  // or more objj_message_keyword_argument nodes (keyword send).
  fn message_selector(self, node: capp.CSTNode) -> (Option<ObjjMessageSelector>, Slice<Diagnostic>) {
    if node.NamedChildCount() == 0 {
      return (None, self.malformed(node, "message selector without content"))
    }

    let first = node.NamedChild(0)
    if first.Kind() == capp.NodeKindObjjSelectorIdentifier {
      return (Some(ObjjMessageSelector.Unary(selector_ident_of(first))), [])
    }

    let mut arguments: Slice<ObjjMessageKeywordArgument> = []
    let mut diags: Slice<Diagnostic> = []
    for i in 0..node.NamedChildCount() {
      let child = node.NamedChild(i)
      let kind = child.Kind()
      if skippable(kind) { continue }
      if kind == capp.NodeKindObjjMessageKeywordArgument {
        let (argument_opt, ds) = self.keyword_argument(child)
        diags = merge_diags(diags, ds)
        if let Some(argument) = argument_opt {
          arguments = arguments.append(argument)
        }
      } else {
        diags = merge_diags(
          diags,
          self.unhandled(child, "message selector part", kind),
        )
      }
    }

    if arguments.is_empty() {
      return (
        None,
        merge_diags(
          diags,
          self.malformed(node, "keyword selector lowered no arguments"),
        ),
      )
    }
    (Some(ObjjMessageSelector.Keyword(arguments)), diags)
  }

  // keyword_argument lowers one `name: expr` (or anonymous `: expr`) part of a
  // keyword message send.  The keyword is the fielded objj_selector_identifier
  // child; the argument expressions are the remaining named children.
  fn keyword_argument(self, node: capp.CSTNode) -> (Option<ObjjMessageKeywordArgument>, Slice<Diagnostic>) {
    let pos = node_pos(node)
    let keyword = node
      .ChildByFieldName(capp.FieldKeyword)
      .map(selector_ident_of)

    let mut arguments: Slice<Expression> = []
    let mut diags: Slice<Diagnostic> = []
    for i in 0..node.NamedChildCount() {
      let child = node.NamedChild(i)
      let kind = child.Kind()
      // The keyword child carries the objj_selector_identifier kind; argument
      // expressions are concrete expression kinds and can never carry it.
      if kind == capp.NodeKindObjjSelectorIdentifier || skippable(kind) {
        continue
      }
      let (expr_opt, ds) = self.expression(child)
      diags = merge_diags(diags, ds)
      if let Some(expr) = expr_opt { arguments = arguments.append(expr) }
    }

    if arguments.is_empty() {
      return (
        None,
        merge_diags(
          diags,
          self.malformed(node, "keyword argument without expression"),
        ),
      )
    }
    (Some(ObjjMessageKeywordArgument { keyword, arguments, pos }), diags)
  }

  // -------------------------------------------------------------------------
  // Objective-J — class implementation
  // -------------------------------------------------------------------------

  fn class_implementation(self, node: capp.CSTNode) -> (Option<Statement>, Slice<Diagnostic>) {
    let pos = node_pos(node)

    let name_node = match node.ChildByFieldName(capp.FieldName) {
      Some(n) => n,
      None => return (
        None,
        self.malformed(node, "@implementation without name"),
      ),
    }

    let superclass = node.ChildByFieldName(capp.FieldSuperclass).map(ident_of)
    let category = node.ChildByFieldName(capp.FieldCategory).map(ident_of)
    let protocols = node
      .ChildByFieldName(capp.FieldProtocols)
      .map(protocol_list)

    let mut ivars: Option<ObjjInstanceVariables> = None
    let mut members: Slice<ObjjImplementationMember> = []
    let mut diags: Slice<Diagnostic> = []

    for i in 0..node.NamedChildCount() {
      let child = node.NamedChild(i)
      let kind = child.Kind()
      // Fielded children (name, superclass, category, protocols) also appear
      // in named-child iteration; they are captured above and skipped here.
      if kind == capp.NodeKindIdentifier ||
      kind == capp.NodeKindObjjProtocolReferenceList ||
      skippable(kind) {
        continue
      }
      if kind == capp.NodeKindObjjInstanceVariables {
        let (block, ds) = self.instance_variables(child)
        diags = merge_diags(diags, ds)
        ivars = Some(block)
      } else if kind == capp.NodeKindObjjImplementationMember {
        let (member_opt, ds) = self.implementation_member(child)
        diags = merge_diags(diags, ds)
        if let Some(member) = member_opt { members = members.append(member) }
      } else {
        diags = merge_diags(
          diags,
          self.unhandled(child, "class body item", kind),
        )
      }
    }

    let class_impl = ObjjClassImplementation { 
      name: ident_of(name_node),
      superclass,
      category,
      protocols,
      ivars,
      members,
      pos,
    }
    (Some(Statement.ObjjClassImpl(class_impl)), diags)
  }

  // implementation_member lowers the objj_implementation_member wrapper: a
  // single named child carrying the member proper.
  fn implementation_member(self, node: capp.CSTNode) -> (Option<ObjjImplementationMember>, Slice<Diagnostic>) {
    if node.NamedChildCount() == 0 {
      return (
        None,
        self.malformed(node, "implementation member without content"),
      )
    }
    let child = node.NamedChild(0)
    let kind = child.Kind()

    if kind == capp.NodeKindObjjMethodDefinition {
      let (method_opt, diags) = self.method_definition(child)
      let Some(method) = method_opt else {
        return (None, diags)
      }
      return (Some(ObjjImplementationMember.Method(method)), diags)
    }
    if kind == capp.NodeKindFunctionDeclaration {
      let (decl_opt, diags) = self.function_declaration(child)
      let Some(decl) = decl_opt else {
        return (None, diags)
      }
      return (Some(ObjjImplementationMember.Function(decl)), diags)
    }
    if kind == capp.NodeKindEmptyStatement {
      return (
        Some(ObjjImplementationMember.Empty(
          EmptyStatement { pos: node_pos(child) },
        )),
        [],
      )
    }
    if kind == capp.NodeKindPreprocDirective {
      let directive = PreprocDirective { 
        text: child.Text(),
        pos: node_pos(child),
      }
      return (Some(ObjjImplementationMember.PreprocDirective(directive)), [])
    }
    if kind == capp.NodeKindObjjGlobalDeclaration {
      let (global_opt, diags) = self.objj_global_struct(child)
      let Some(global) = global_opt else {
        return (None, diags)
      }
      return (Some(ObjjImplementationMember.Global(global)), diags)
    }
    if kind == capp.NodeKindVariableDeclaration {
      let (decl_opt, diags) = self.variable_declaration(child)
      let Some(decl) = decl_opt else {
        return (None, diags)
      }
      return (Some(ObjjImplementationMember.Variable(decl)), diags)
    }
    if kind == capp.NodeKindGeneratorFunctionDeclaration {
      let (decl_opt, diags) = self.generator_function_declaration(child)
      let Some(decl) = decl_opt else {
        return (None, diags)
      }
      return (Some(ObjjImplementationMember.GeneratorFunction(decl)), diags)
    }

    (None, self.unhandled(child, "implementation member", kind))
  }

  // -------------------------------------------------------------------------
  // Objective-J — instance variables
  // -------------------------------------------------------------------------

  fn instance_variables(self, node: capp.CSTNode) -> (ObjjInstanceVariables, Slice<Diagnostic>) {
    let mut members: Slice<ObjjIvarMember> = []
    let mut diags: Slice<Diagnostic> = []

    for i in 0..node.NamedChildCount() {
      let child = node.NamedChild(i)
      let kind = child.Kind()
      if skippable(kind) { continue }
      if kind == capp.NodeKindObjjInstanceVariable {
        let (variable_opt, ds) = self.instance_variable(child)
        diags = merge_diags(diags, ds)
        if let Some(variable) = variable_opt {
          members = members.append(ObjjIvarMember.Variable(variable))
        }
      } else if kind == capp.NodeKindPreprocIvarIfBlock {
        let (block_opt, ds) = self.preproc_ivar_if_block_struct(child)
        diags = merge_diags(diags, ds)
        if let Some(block) = block_opt {
          members = members.append(ObjjIvarMember.PreprocIf(block))
        }
      } else {
        diags = merge_diags(
          diags,
          self.unhandled(child, "ivar block item", kind),
        )
      }
    }

    (ObjjInstanceVariables { members, pos: node_pos(node) }, diags)
  }

  // instance_variable lowers the objj_instance_variable wrapper: a single
  // named child that is either a visibility specifier or a field definition.
  fn instance_variable(self, node: capp.CSTNode) -> (Option<ObjjInstanceVariable>, Slice<Diagnostic>) {
    if node.NamedChildCount() == 0 {
      return (None, self.malformed(node, "instance variable without content"))
    }
    let child = node.NamedChild(0)
    let kind = child.Kind()

    if kind == capp.NodeKindObjjVisibilitySpecifier {
      let (visibility_opt, diags) = self.visibility_specifier(child)
      let Some(visibility) = visibility_opt else {
        return (None, diags)
      }
      return (Some(ObjjInstanceVariable.Visibility(visibility)), diags)
    }
    if kind == capp.NodeKindObjjFieldDefinition {
      let (field_opt, diags) = self.field_definition(child)
      let Some(field) = field_opt else {
        return (None, diags)
      }
      return (Some(ObjjInstanceVariable.Field(field)), diags)
    }

    (None, self.unhandled(child, "instance variable", kind))
  }

  // visibility_specifier carries only anonymous token children; the node's
  // text is the specifier itself.
  fn visibility_specifier(self, node: capp.CSTNode) -> (Option<ObjjVisibilitySpecifier>, Slice<Diagnostic>) {
    let pos = node_pos(node)
    let text = node.Text()
    if text == "@private" {
      return (Some(ObjjVisibilitySpecifier.Private(pos)), [])
    }
    if text == "@protected" {
      return (Some(ObjjVisibilitySpecifier.Protected(pos)), [])
    }
    if text == "@package" {
      return (Some(ObjjVisibilitySpecifier.Package(pos)), [])
    }
    if text == "@public" {
      return (Some(ObjjVisibilitySpecifier.Public(pos)), [])
    }
    (None, self.unhandled(node, "visibility specifier", text))
  }

  fn field_definition(self, node: capp.CSTNode) -> (Option<ObjjFieldDefinition>, Slice<Diagnostic>) {
    let pos = node_pos(node)
    let mut diags: Slice<Diagnostic> = []

    // Modifiers are an optional unfielded objj_ivar_modifiers child.
    let mut modifiers: Slice<ObjjIvarModifier> = []
    for i in 0..node.NamedChildCount() {
      let child = node.NamedChild(i)
      if child.Kind() == capp.NodeKindObjjIvarModifiers {
        let (mods, ds) = self.ivar_modifiers(child)
        diags = merge_diags(diags, ds)
        modifiers = mods.clone()
      }
    }

    let type_node = match node.ChildByFieldName(capp.FieldType) {
      Some(n) => n,
      None => return (
        None,
        merge_diags(diags, self.malformed(node, "ivar without type")),
      ),
    }
    let name_node = match node.ChildByFieldName(capp.FieldName) {
      Some(n) => n,
      None => return (
        None,
        merge_diags(diags, self.malformed(node, "ivar without name")),
      ),
    }

    let (field_type_opt, type_diags) = self.objj_type(type_node)
    diags = merge_diags(diags, type_diags)
    let field_type = match field_type_opt {
      Some(t) => t,
      None => return (None, diags),
    }

    let mut accessors: Option<ObjjAccessorsDirective> = None
    if let Some(accessors_node) = node.ChildByFieldName(capp.FieldAccessors) {
      let (accessors_opt, ds) = self.accessors_directive(accessors_node)
      diags = merge_diags(diags, ds)

      if let Some(v) = accessors_opt {
        accessors = Some(v)
      } else {
        accessors = None
      }
    }

    let field = ObjjFieldDefinition { 
      modifiers,
      field_type,
      name: ident_of(name_node),
      accessors,
      pos,
    }
    (Some(field), diags)
  }

  fn ivar_modifiers(self, node: capp.CSTNode) -> (Slice<ObjjIvarModifier>, Slice<Diagnostic>) {
    let mut modifiers: Slice<ObjjIvarModifier> = []
    let mut diags: Slice<Diagnostic> = []
    for i in 0..node.NamedChildCount() {
      let child = node.NamedChild(i)
      if child.Kind() != capp.NodeKindObjjIvarModifier { continue }
      let pos = node_pos(child)
      let text = child.Text()
      if text == "@outlet" {
        modifiers = modifiers.append(ObjjIvarModifier.Outlet(pos))
      } else if text == "@IBOutlet" {
        modifiers = modifiers.append(ObjjIvarModifier.IBOutlet(pos))
      } else if text == "@weak" {
        modifiers = modifiers.append(ObjjIvarModifier.Weak(pos))
      } else if text == "@strong" {
        modifiers = modifiers.append(ObjjIvarModifier.Strong(pos))
      } else {
        diags = merge_diags(diags, self.unhandled(child, "ivar modifier", text))
      }
    }
    (modifiers, diags)
  }

  // -------------------------------------------------------------------------
  // Objective-J — methods
  // -------------------------------------------------------------------------

  fn method_definition(self, node: capp.CSTNode) -> (Option<ObjjMethodDefinition>, Slice<Diagnostic>) {
    let pos = node_pos(node)
    let mut diags: Slice<Diagnostic> = []

    // The method_type field holds the anonymous '+' or '-' token.
    let scope = match node.ChildByFieldName(capp.FieldMethodType) {
      Some(scope_node) => {
        if scope_node.Text() == "+" {
          ObjjMethodScope.Class
        } else {
          ObjjMethodScope.Instance
        }
      },
      None => return (
        None,
        self.malformed(node, "method without +/- indicator"),
      ),
    }

    let return_type_node = match node.ChildByFieldName(capp.FieldReturnType) {
      Some(n) => n,
      None => return (None, self.malformed(node, "method without return type")),
    }
    let (return_type_opt, return_diags) = self.method_type(return_type_node)
    diags = merge_diags(diags, return_diags)
    let return_type = match return_type_opt {
      Some(t) => t,
      None => return (None, diags),
    }

    // Unary methods carry a fielded method_name; keyword methods carry one or
    // more unfielded objj_method_parameter_part children.
    let selector = match node.ChildByFieldName(capp.FieldMethodName) {
      Some(name_node) => ObjjMethodSelector.Unary(selector_ident_of(name_node)),
      None => {
        let mut parts: Slice<ObjjMethodParameterPart> = []
        for i in 0..node.NamedChildCount() {
          let child = node.NamedChild(i)
          if child.Kind() != capp.NodeKindObjjMethodParameterPart { continue }
          let (part_opt, ds) = self.parameter_part(child)
          diags = merge_diags(diags, ds)
          if let Some(part) = part_opt { parts = parts.append(part) }
        }
        if parts.is_empty() {
          return (
            None,
            merge_diags(diags, self.malformed(node, "method without selector")),
          )
        }
        ObjjMethodSelector.Keyword(parts)
      },
    }

    let body_node = match node.ChildByFieldName(capp.FieldBody) {
      Some(n) => n,
      None => return (
        None,
        merge_diags(diags, self.malformed(node, "method without body")),
      ),
    }
    let (body, body_diags) = self.statement_block(body_node)
    diags = merge_diags(diags, body_diags)

    let method = ObjjMethodDefinition { 
      scope,
      return_type,
      selector,
      body,
      pos,
    }
    (Some(method), diags)
  }

  fn parameter_part(self, node: capp.CSTNode) -> (Option<ObjjMethodParameterPart>, Slice<Diagnostic>) {
    let pos = node_pos(node)
    let mut diags: Slice<Diagnostic> = []

    let name_part = node
      .ChildByFieldName(capp.FieldNamePart)
      .map(selector_ident_of)

    let parameter_type = match node.ChildByFieldName(capp.FieldParameterType) {
      Some(type_node) => {
        let (type_opt, ds) = self.method_type(type_node)
        diags = merge_diags(diags, ds)
        type_opt
      },
      None => None,
    }

    let parameter_name = match node.ChildByFieldName(capp.FieldParameterName) {
      Some(n) => ident_of(n),
      None => {
        return (
          None,
          merge_diags(
            diags,
            self.malformed(node, "selector part without parameter name"),
          ),
        )
      },
    }

    let part = ObjjMethodParameterPart { 
      name_part,
      parameter_type,
      parameter_name,
      is_variadic: has_anonymous_child(node, "..."),
      pos,
    }
    (Some(part), diags)
  }

  // method_type lowers `( async? @action|void|objj_type )`.  The type field
  // holds either an anonymous token ('@action', 'void') or an objj_type node.
  fn method_type(self, node: capp.CSTNode) -> (Option<ObjjMethodType>, Slice<Diagnostic>) {
    let pos = node_pos(node)
    let is_async = has_anonymous_child(node, "async")

    let kind_node = match node.ChildByFieldName(capp.FieldType) {
      Some(n) => n,
      None => return (None, self.malformed(node, "method type without content")),
    }

    let kind_text = kind_node.Kind()
    if kind_text == "@action" {
      let method_type = ObjjMethodType { 
        is_async,
        return_kind: ObjjMethodTypeKind.Action(node_pos(kind_node)),
        pos,
      }
      return (Some(method_type), [])
    }
    if kind_text == "void" {
      let method_type = ObjjMethodType { 
        is_async,
        return_kind: ObjjMethodTypeKind.Void(node_pos(kind_node)),
        pos,
      }
      return (Some(method_type), [])
    }
    if kind_text == capp.NodeKindObjjType {
      let (type_opt, diags) = self.objj_type(kind_node)
      let Some(objj_type) = type_opt else {
        return (None, diags)
      }
      return (
        Some(
          ObjjMethodType { 
            is_async,
            return_kind: ObjjMethodTypeKind.Type(objj_type),
            pos,
          },
        ),
        diags,
      )
    }

    (None, self.unhandled(kind_node, "method type", kind_text))
  }

  // -------------------------------------------------------------------------
  // Objective-J — types
  // -------------------------------------------------------------------------

  // objj_type is a wrapper whose meaning is determined by its named children:
  //   [objj_protocol_type]            → protocol-qualified named type
  //   [objj_multi_word_type]          → C-style multi-word type
  //   [identifier]                    → plain named type
  //   [objj_protocol_reference_list]  → id<Protocols> (the 'id' is anonymous)
  //   (none)                          → bare id
  fn objj_type(self, node: capp.CSTNode) -> (Option<ObjjType>, Slice<Diagnostic>) {
    let pos = node_pos(node)

    if node.NamedChildCount() == 0 {
      return (Some(ObjjType.Id(ObjjIdType { protocols: None, pos })), [])
    }

    let child = node.NamedChild(0)
    let kind = child.Kind()

    if kind == capp.NodeKindIdentifier {
      return (Some(ObjjType.Named(ident_of(child))), [])
    }
    if kind == capp.NodeKindObjjProtocolReferenceList {
      let id_type = ObjjIdType { protocols: Some(protocol_list(child)), pos }
      return (Some(ObjjType.Id(id_type)), [])
    }
    if kind == capp.NodeKindObjjProtocolType {
      return self.protocol_type(child)
    }
    if kind == capp.NodeKindObjjMultiWordType {
      return self.multi_word_type(child)
    }

    (None, self.unhandled(child, "type", kind))
  }

  // protocol_type lowers `Name<P, Q>`: unfielded children are the name
  // identifier followed by the protocol reference list.
  fn protocol_type(self, node: capp.CSTNode) -> (Option<ObjjType>, Slice<Diagnostic>) {
    let pos = node_pos(node)
    let mut name: Option<Identifier> = None
    let mut protocols: Option<ObjjProtocolReferenceList> = None

    for i in 0..node.NamedChildCount() {
      let child = node.NamedChild(i)
      let kind = child.Kind()
      if kind == capp.NodeKindIdentifier {
        name = Some(ident_of(child))
      } else if kind == capp.NodeKindObjjProtocolReferenceList {
        protocols = Some(protocol_list(child))
      }
    }

    let Some(type_name) = name else {
      return (None, self.malformed(node, "protocol type without name"))
    }
    let Some(list) = protocols else {
      return (None, self.malformed(node, "protocol type without protocol list"))
    }
    (
      Some(ObjjType.Protocol(
        ObjjProtocolType { name: type_name, protocols: list, pos },
      )),
      [],
    )
  }

  // multi_word_type maps the C-style spellings onto their variants.  The
  // node's children are anonymous word tokens; the text is normalised to
  // single spaces before matching so source whitespace cannot affect dispatch.
  fn multi_word_type(self, node: capp.CSTNode) -> (Option<ObjjType>, Slice<Diagnostic>) {
    let pos = node_pos(node)
    let normalized = strings.Join(strings.Fields(node.Text()), " ")

    let variant = match normalized {
      "unsigned char" => Some(ObjjMultiWordType.UnsignedChar(pos)),
      "unsigned short" => Some(ObjjMultiWordType.UnsignedShort(pos)),
      "unsigned int" => Some(ObjjMultiWordType.UnsignedInt(pos)),
      "unsigned long long" => Some(ObjjMultiWordType.UnsignedLongLong(pos)),
      "unsigned long" => Some(ObjjMultiWordType.UnsignedLong(pos)),
      "signed char" => Some(ObjjMultiWordType.SignedChar(pos)),
      "signed short" => Some(ObjjMultiWordType.SignedShort(pos)),
      "signed int" => Some(ObjjMultiWordType.SignedInt(pos)),
      "signed long" => Some(ObjjMultiWordType.SignedLong(pos)),
      "long long" => Some(ObjjMultiWordType.LongLong(pos)),
      "long double" => Some(ObjjMultiWordType.LongDouble(pos)),
      "unsigned" => Some(ObjjMultiWordType.Unsigned(pos)),
      "signed" => Some(ObjjMultiWordType.Signed(pos)),
      "long" => Some(ObjjMultiWordType.Long(pos)),
      "short" => Some(ObjjMultiWordType.Short(pos)),
      "char" => Some(ObjjMultiWordType.Char(pos)),
      "int" => Some(ObjjMultiWordType.Int(pos)),
      _ => None,
    }

    let Some(multi_word) = variant else {
      return (None, self.unhandled(node, "multi-word type", normalized))
    }
    (Some(ObjjType.MultiWord(multi_word)), [])
  }
}

// ---------------------------------------------------------------------------
// Pure structural helpers
// ---------------------------------------------------------------------------

// protocol_list lowers `<P, Q, ...>`: the named children are exactly the
// protocol identifiers.  Pure by grammar; nothing to diagnose.
fn protocol_list(node: capp.CSTNode) -> ObjjProtocolReferenceList {
  let mut protocols: Slice<Identifier> = []
  for i in 0..node.NamedChildCount() {
    let child = node.NamedChild(i)
    if child.Kind() == capp.NodeKindIdentifier {
      protocols = protocols.append(ident_of(child))
    }
  }
  ObjjProtocolReferenceList { protocols, pos: node_pos(node) }
}
