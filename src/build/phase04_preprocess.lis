//
// Phase 4: PreprocessSources
//
// Identity pass-through: copies ctx.parsed into ctx.preprocessed unchanged.
// No directive handling, no condition evaluation, no branch selection.
//
// This is not a stub awaiting a future implementation. C-style preprocessing
// is being sunset: an audit of the AppKit/Foundation source tree found no
// live use of conditional compilation, and every #define resolved to either
// a class constant, a class or instance method reaching state it already
// owns, or a call site rewritten by hand. That source is being migrated
// accordingly. This phase remains in the pipeline as a deliberate, permanent
// placeholder for the rare, genuinely unrewritable site found on a
// site-specific basis in the future — not as an incomplete feature.
//
// ResolveImports (phase 5) and every phase after it read ctx.parsed
// directly; ctx.preprocessed exists so the pipeline's phase count and shape
// are correct, but nothing downstream currently consumes it.
//
// **
import "go:errors"
import "go:fmt"

// PreprocessResult is the output of phase 4.  units is a verbatim copy of
// ctx.parsed.units and diags is always empty — see the file header for why
// this is permanent, not provisional.
pub struct PreprocessResult {
  pub units: Slice<ParsedUnit>,
  pub diags: Slice<Diagnostic>,
}

pub fn run_preprocess_sources(ctx: Ref<BuildContext>) -> Result<PreprocessResult, error> {
  let parsed = match ctx.parsed {
    Some(p) => p,
    None => return Err(errors.New(
      "preprocess sources: parsed units unavailable",
    )),
  }

  let mut units: Slice<ParsedUnit> = []
  for unit in parsed.units {
    units = units.append(unit)
  }

  fmt.Println(f"✓  preprocess sources: {units.length()} units (pass-through)")

  Ok(PreprocessResult { units, diags: [] })
}
