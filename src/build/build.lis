import "go:fmt"

// ---------------------------------------------------------------------------
// BuildPhase
// ---------------------------------------------------------------------------

// The `BuildPhase` type defines the complete set of pipeline phases.
// The compiler confirms that each operation has, in fact, an implementation
// and that it is run in the correct order by the execution machinery.
// Described in ARCHITECTURE.md.
#[iterate]
pub enum BuildPhase {
  ValidateProjectStructure, // phase 1
  WalkSourceTree, // phase 2
  ParseSources, // phase 3
  ResolveImports, // phase 4
  TopologicalSort, // phase 5
  BuildSymbolTable, // phase 6
  TypeCheck, // phase 7
  Compile, // phase 8
  Archive, // phase 9
}

// Adding a variant to BuildPhase without a corresponding arm in run() is a
// compile error.  This is the binding between declaration and execution.
// variants() is synthesised by #[iterate]; run() enforces completeness.
impl BuildPhase {
  fn run(self, ctx: Ref<BuildContext>) -> Result<(), error> {
    match self {
      ValidateProjectStructure => {
        ctx.validation = Some(run_validate_project_structure(ctx)?)
        Ok(())
      },
      WalkSourceTree => {
        ctx.tree = Some(run_walk_source_tree(ctx)?)
        Ok(())
      },
      ParseSources => {
        ctx.parsed = Some(run_parse_sources(ctx)?)
        Ok(())
      },
      ResolveImports => {
        ctx.imports = Some(run_resolve_imports(ctx)?)
        Ok(())
      },
      TopologicalSort => {
        ctx.sorted = Some(run_topological_sort(ctx)?)
        Ok(())
      },
      BuildSymbolTable => {
        ctx.symbols = Some(run_build_symbol_table(ctx)?)
        Ok(())
      },
      TypeCheck => {
        ctx.type_info = Some(run_type_check(ctx)?)
        Ok(())
      },
      Compile => {
        ctx.compiled = Some(run_compile(ctx)?)
        Ok(())
      },
      Archive => {
        ctx.archived = Some(run_archive(ctx)?)
        Ok(())
      },
    }
  }
}

// ---------------------------------------------------------------------------
// BuildMode / BuildConfig / BuildResult
// ---------------------------------------------------------------------------

// Debug:   compile with source maps, no optimisation
// Release: compile with optimisation, no source maps
// Clean:   remove build artefacts without compiling
pub enum BuildMode {
  Debug,
  Release,
  Clean,
}

// The delivery context is a property of the target environment, not the
// compilation mode.  It governs phase 8 output structure independently of
// whether the build is Debug, Release, or any future mode.
//
// HTTP1: concatenated, minified output — default; works on any server
// HTTP2: per-file output — exploits multiplexing and fine-grained caching
pub enum DeliveryContext {
  HTTP1,
  HTTP2,
}

pub struct BuildConfig {
  pub mode: BuildMode,
  pub delivery: DeliveryContext,
  pub source_root: string,
  pub grammar: string,
}

pub struct BuildResult {
  pub ok: bool,
  pub message: string,
  pub diags: Slice<Diagnostic>,
}

// phase_diags returns the diagnostics produced by a phase, read from the
// ctx field that phase populates.  Exhaustive over BuildPhase: adding a
// phase without an arm here is a compile error, the same binding the
// architecture relies on for run().  A None field means the phase did not
// run (an earlier phase halted), yielding no diagnostics.
fn phase_diags(phase: BuildPhase, ctx: Ref<BuildContext>) -> Slice<Diagnostic> {
  match phase {
    ValidateProjectStructure => ctx.validation.map_or([], |r| r.diags),
    WalkSourceTree => ctx.tree.map_or([], |r| r.diags),
    ParseSources => ctx.parsed.map_or([], |r| r.diags),
    ResolveImports => ctx.imports.map_or([], |r| r.diags),
    TopologicalSort => ctx.sorted.map_or([], |r| r.diags),
    BuildSymbolTable => ctx.symbols.map_or([], |r| r.diags),
    TypeCheck => ctx.type_info.map_or([], |r| r.diags),
    Compile => ctx.compiled.map_or([], |r| r.diags),
    Archive => ctx.archived.map_or([], |r| r.diags),
  }
}

// has_error returns true when any diagnostic in the slice is Error-level.
fn has_error(diags: Slice<Diagnostic>) -> bool {
  for d in diags {
    if let DiagLevel.Error = d.level { return true }
  }
  false
}

// error_count counts Error-level diagnostics in the slice.
fn error_count(diags: Slice<Diagnostic>) -> int {
  let mut n = 0
  for d in diags {
    if let DiagLevel.Error = d.level { n += 1 }
  }
  n
}

// ---------------------------------------------------------------------------
// Build pipeline
// ---------------------------------------------------------------------------

// A phase returning Err halts the pipeline; Warning-level diagnostics do not.
// Declaration order in BuildPhase is the authoritative execution order;
// #[iterate] synthesises variants() from it.  Completeness is enforced by BuildPhase.run.
pub fn build(cfg: BuildConfig) -> Result<BuildResult, error> {
  let root = find_project_root(cfg.source_root)?

  let mut ctx = BuildContext { config: cfg, root, .. }

  for phase in BuildPhase.variants() {
    phase.run(&ctx)?
    // Gate on diagnostics: a phase that reports an Error has found the
    // project unbuildable from this point.  Halt before dependent phases
    // run on its incomplete result (REVIEW.md finding 1).  The phase has
    // already printed its own diagnostics; here we stop and report.
    let diags = phase_diags(phase, &ctx)
    if has_error(diags) {
      let n = error_count(diags)
      return Ok(
        BuildResult { 
          ok: false,
          message: f"build halted: {n} error(s) in {phase_name(phase)}",
          diags,
        },
      )
    }
  }

  let file_count = ctx.tree.map_or(0, |t| t.files.length())
  let unit_count = ctx.parsed.map_or(0, |p| p.units.length())
  let edge_count = ctx.imports.map_or(0, |i| i.edges.length())
  let dep_count = ctx.imports.map_or(0, |i| i.framework_deps.length())
  let sorted_count = ctx.sorted.map_or(0, |s| s.order.length())

  fmt.Println(
    f"  {file_count} source files  {unit_count} parsed  {edge_count} import edges  {dep_count} framework deps  {sorted_count} sorted",
  )

  Ok(BuildResult { ok: true, message: f"build complete: {ctx.root.path}", .. })
}

// phase_name renders a phase for halt messages.
fn phase_name(phase: BuildPhase) -> string {
  match phase {
    ValidateProjectStructure => "validate project structure",
    WalkSourceTree => "walk source tree",
    ParseSources => "parse sources",
    ResolveImports => "resolve imports",
    TopologicalSort => "topological sort",
    BuildSymbolTable => "build symbol table",
    TypeCheck => "type check",
    Compile => "compile",
    Archive => "archive",
  }
}
