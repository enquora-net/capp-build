import "go:fmt"

// ---------------------------------------------------------------------------
// BuildPhase
// ---------------------------------------------------------------------------

// The `BuildPhase` type defines the complete set of pipeline phases.
// The compiler confirms that each operation has, in fact, an implementation
// and that it is run in the correct order by the execution machinery.
// Described in ARCHITECTURE.md.
pub enum BuildPhase {
  ValidateProjectStructure,
  WalkSourceTree,
  ParseSources,
  ResolveImports,
  TopologicalSort,
  TypeCheck,
  CodeGenerate,
  Link,
}

// Adding a variant to BuildPhase without a corresponding arm in run() is a
// compile error.  This is the binding between declaration and execution.
// all() declares execution order; run() enforces completeness.
impl BuildPhase {
  fn all() -> Slice<BuildPhase> {
    [
      BuildPhase.ValidateProjectStructure,
      BuildPhase.WalkSourceTree,
      BuildPhase.ParseSources,
      BuildPhase.ResolveImports,
      BuildPhase.TopologicalSort,
      BuildPhase.TypeCheck,
      BuildPhase.CodeGenerate,
      BuildPhase.Link,
    ]
  }

  fn run(self, ctx: Ref<BuildContext>) -> Result<(), error> {
    match self {
      BuildPhase.ValidateProjectStructure => {
        ctx.validation = Some(run_validate_project_structure(ctx)?)
        Ok(())
      },
      BuildPhase.WalkSourceTree => {
        ctx.tree = Some(run_walk_source_tree(ctx)?)
        Ok(())
      },
      BuildPhase.ParseSources => {
        ctx.parsed = Some(run_parse_sources(ctx)?)
        Ok(())
      },
      BuildPhase.ResolveImports => {
        ctx.imports = Some(run_resolve_imports(ctx)?)
        Ok(())
      },
      BuildPhase.TopologicalSort => {
        ctx.sorted = Some(run_topological_sort(ctx)?)
        Ok(())
      },
      BuildPhase.TypeCheck => {
        ctx.type_info = Some(run_type_check(ctx)?)
        Ok(())
      },
      BuildPhase.CodeGenerate => {
        ctx.code_gen = Some(run_code_generate(ctx)?)
        Ok(())
      },
      BuildPhase.Link => {
        ctx.linked = Some(run_link(ctx)?)
        Ok(())
      },
    }
  }
}

// ---------------------------------------------------------------------------
// BuildMode / BuildConfig / BuildResult
// ---------------------------------------------------------------------------

// Debug:   compile with source maps, no optimisation
// Release: compile with optimisation, no source maps
// Clean:   remove build artefacts without compiling
pub enum BuildMode {
  Debug,
  Release,
  Clean,
}

// The delivery context is a property of the target environment, not the
// compilation mode.  It governs phase 8 output structure independently of
// whether the build is Debug, Release, or any future mode.
//
// HTTP1: concatenated, minified output — default; works on any server
// HTTP2: per-file output — exploits multiplexing and fine-grained caching
pub enum DeliveryContext {
  HTTP1,
  HTTP2,
}

pub struct BuildConfig {
  pub mode:     BuildMode,
  pub delivery: DeliveryContext,
  pub source_root: string,
  pub grammar:     string,
}

pub struct BuildResult {
  pub ok:      bool,
  pub message: string,
  pub diags:   Slice<Diagnostic>,
}

// ---------------------------------------------------------------------------
// Build pipeline
// ---------------------------------------------------------------------------

// A phase returning Err halts the pipeline; Warning-level diagnostics do not.
// The slice literal below is the single authoritative declaration of execution
// order.  Completeness is enforced by BuildPhase.run above.
pub fn build(cfg: BuildConfig) -> Result<BuildResult, error> {
  let root = find_project_root(cfg.source_root)?

  let mut ctx = BuildContext {
    config: cfg,
    root:   root,
    ..
  }

  for phase in BuildPhase.all() {
    phase.run(&ctx)?
  }

  let file_count = match ctx.tree {
    Some(t) => t.files.length(),
    None    => 0,
  }
  let unit_count = match ctx.parsed {
    Some(p) => p.units.length(),
    None    => 0,
  }
  let edge_count = match ctx.imports {
    Some(i) => i.edges.length(),
    None    => 0,
  }

  fmt.Println(f"  {file_count} source files  {unit_count} parsed  {edge_count} import edges")

  Ok(BuildResult {
    ok:      true,
    message: f"build complete: {ctx.root.path}",
    ..
  })
}
