// ---------------------------------------------------------------------------
// BuildPhase
// ---------------------------------------------------------------------------

// The `BuildPhase` type defines the complete set of pipeline phases.
// The compiler confirms that each operation has, in fact, an implementation
// and that it is run in the correct order by the execution machinery.
// Described in ARCHITECTURE.md.
pub enum BuildPhase {
  ValidateProjectStructure,
  WalkSourceTree,
  ParseSources,
  ResolveImports,
  TopologicalSort,
  TypeCheck,
  CodeGenerate,
  Link,
}

// Implements the guarantee the `BuildPhase` defines: if a ninth phase is added
// to BuildPhase and this match is not updated, the build fails.  The same
// protection applies at every other match site in the codebase — no handling
// site can be silently skipped.
pub fn phase_name(phase: BuildPhase) -> string {
  match phase {
    BuildPhase.ValidateProjectStructure => "validate project structure",
    BuildPhase.WalkSourceTree           => "walk source tree",
    BuildPhase.ParseSources             => "parse sources",
    BuildPhase.ResolveImports           => "resolve imports",
    BuildPhase.TopologicalSort          => "topological sort",
    BuildPhase.TypeCheck                => "type check",
    BuildPhase.CodeGenerate             => "code generate",
    BuildPhase.Link                     => "link",
  }
}

// ---------------------------------------------------------------------------
// BuildMode / BuildConfig / BuildResult
// ---------------------------------------------------------------------------

// Debug:   compile with source maps, no optimisation
// Release: compile with optimisation, no source maps
// Clean:   remove build artefacts without compiling
pub enum BuildMode {
  Debug,
  Release,
  Clean,
}

pub struct BuildConfig {
  pub mode:        BuildMode,
  pub source_root: string,
  pub grammar:     string,
}

pub struct BuildResult {
  pub ok:      bool,
  pub message: string,
  pub diags:   Slice<Diagnostic>,
}

// ---------------------------------------------------------------------------
// Build pipeline
// ---------------------------------------------------------------------------

// A phase returning Err halts the pipeline; Warning-level diagnostics do not.
pub fn build(cfg: BuildConfig) -> Result<BuildResult, error> {
  let root = find_project_root(cfg.source_root)?

  let mut ctx = BuildContext {
    config: cfg,
    root:   root,
    ..
  }

  // Phase 1: validate project structure
  let validation = run_validate_project_structure(&ctx)?
  ctx.validation = Some(validation)

  // Phase 2: walk source tree
  let tree = run_walk_source_tree(&ctx)?
  ctx.tree = Some(tree)

  // Phase 3: parse sources
  let parsed = run_parse_sources(&ctx)?
  ctx.parsed = Some(parsed)

  // Phase 4: resolve imports
  let imports = run_resolve_imports(&ctx)?
  ctx.imports = Some(imports)

  // Phase 5: topological sort
  let sorted = run_topological_sort(&ctx)?
  ctx.sorted = Some(sorted)

  // Phase 6: type check
  let type_info = run_type_check(&ctx)?
  ctx.type_info = Some(type_info)

  // Phase 7: code generate
  let code_gen = run_code_generate(&ctx)?
  ctx.code_gen = Some(code_gen)

  // Phase 8: link
  let linked = run_link(&ctx)?
  ctx.linked = Some(linked)

  Ok(BuildResult {
    ok:      true,
    message: f"build complete: {ctx.root.path}",
    ..
  })
}
