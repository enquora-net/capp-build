// BuildMode controls the compilation target.
pub enum BuildMode {
  Debug,
  Release,
  Clean,
}

// BuildConfig is the complete specification for a build operation.
pub struct BuildConfig {
  pub mode:        BuildMode,
  pub source_root: string,
  pub grammar:     string,
}

// BuildResult is the outcome of a build operation.
pub struct BuildResult {
  pub ok:      bool,
  pub message: string,
}

// build executes a compilation pass as described by cfg.
// Not yet implemented.
pub fn build(cfg: BuildConfig) -> Result<BuildResult, error> {
  Ok(BuildResult {
    ok: false,
    message: f"build: not yet implemented (mode={cfg.mode})",
  })
}
