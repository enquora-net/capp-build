//
// Phase 3: ParseSources
//
// Invokes capp-parse over every ObjectiveJ and Javascript file in the source
// tree, collecting import directives from each CST.  Trees are held live only
// for the duration of extraction; ParsedUnit retains the typed RawImport
// values, not the tree itself.  Parse failures are accumulated as diagnostics
// rather than aborting on the first error.
//
// **
import "go:errors"
import "go:fmt"
import "go:github.com/enquora-net/capp-parse"
import "go:strings"

// RawImport represents an @import directive before path resolution.
// Framework carries the angle-bracket form: framework name and relative path.
// Local carries the quoted form: the raw path string.
// line and col are 0-based source positions of the @import node; normalised
// to 1-based by diag_error_at and ImportEdge at their respective use sites.
pub enum RawImport {
  Framework(string, string, int, int), // framework, path, line, col
  Local(string, int, int), // path, line, col
}

pub struct ParsedUnit {
  pub source: SourceFile,
  pub imports: Slice<RawImport>,
}

pub struct ParsedUnits {
  pub units: Slice<ParsedUnit>,
  pub diags: Slice<Diagnostic>,
}

// extract_imports walks a CSTNode depth-first and returns all @import
// directives as typed RawImport values.  The node and its descendants are
// consumed transiently; only the semantic values are retained.
pub fn extract_imports(node: capp.CSTNode) -> Slice<RawImport> {
  if node.IsNull() { return [] }

  if node.Kind() == capp.NodeKindObjjImport {
    // Capture the position of the @import directive itself for diagnostics
    // and editor invocation.  StartRow/StartColumn are 0-based (tree-sitter
    // convention); callers normalise to 1-based at their use sites.
    let row = node.StartRow() as int
    let col = node.StartColumn() as int
    match node.ChildByFieldName(capp.FieldImportPath) {
      Some(path_node) => {
        let kind = path_node.Kind()
        let text = path_node.Text()
        if kind == capp.NodeKindSystemLibString && text.length() > 2 {
          // text is <Foundation/CPObject.j> — strip surrounding < >
          let inner = text.substring(1..text.length() - 1)
          match strings.Index(inner, "/") {
            Some(slash) => {
              let framework = inner.substring(0..slash)
              let path = inner.substring(slash + 1..inner.length())
              return [RawImport.Framework(framework, path, row, col)]
            },
            None => return [],
          }
        }

        if kind == capp.NodeKindString && text.length() > 2 {
          // text is "MyClass.j" — strip surrounding quotation marks
          let inner = text.substring(1..text.length() - 1)
          return [RawImport.Local(inner, row, col)]
        }
        return []
      },
      None => return [],
    }
  }
  // Not an import node — recurse into children
  let mut result: Slice<RawImport> = []
  for i in 0..node.ChildCount() {
    for imp in extract_imports(node.Child(i)) {
      result = result.append(imp)
    }
  }
  result
}

// run_parse_sources parses every ObjectiveJ and Javascript file in the source
// tree in a single parallel batch, extracts @import directives from each CST,
// and returns the typed ParsedUnits.  The CSTs are released before returning.
pub fn run_parse_sources(ctx: Ref<BuildContext>) -> Result<ParsedUnits, error> {
  let phase = BuildPhase.ParseSources
  let mut diags: Slice<Diagnostic> = []

  let tree = match ctx.tree {
    Some(t) => t,
    None => return Err(errors.New("parse sources: source tree unavailable")),
  }

  let mut paths: Slice<string> = []
  for file in tree.files {
    match file.kind {
      SourceKind.ObjectiveJ => paths = paths.append(file.path),
      SourceKind.Javascript => paths = paths.append(file.path),
      _ => (),
    }
  }

  if paths.is_empty() { return Ok(ParsedUnits { units: [], diags }) }

  let cfg = capp.ProjectConfig { 
    Root: "",
    Paths: paths,
    Mode: capp.ModeAuto,
    GrammarPath: ctx.config.grammar,
    Workers: 0,
    ..,
  }

  let pr = capp.ParseProject(cfg)?
  defer pr.Close()

  let mut units: Slice<ParsedUnit> = []

  for file_opt in pr.Files {
    match file_opt {
      None => (),
      Some(file) => {
        if file.HasError() {
          for e in file.Errors {
            diags = diags.append(diag_error_at(
              phase,
              e.Message,
              file.Path,
              e.Row as int,
              e.Column as int,
            ))
          }
        } else {
          let imports = extract_imports(file.Root())
          let source = SourceFile { path: file.Path, kind: classify(file.Path) }
          units = units.append(ParsedUnit { source, imports })
        }
      },
    }
  }

  fmt.Println(f"✓  parse sources: {units.length()} units")

  Ok(ParsedUnits { units, diags })
}
