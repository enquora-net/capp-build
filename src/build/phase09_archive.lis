//
// Phase 9: Archive
//
// Produces the build output artifact from the compiled records delivered
// by phase 8.  The form of the artifact depends on the project type:
//
//   Framework:   a .sj bundle in the static blob format, written to the
//                appropriate environment subdirectory
//                (e.g. ObjJ.environment/Foundation.sj).  Each compiled
//                record becomes a p/t pair in the bundle.
//
//   Application: an assembled deliverable directory under Build/<Mode>/<Name>/
//                containing the application's compiled .sj bundle, the
//                pre-built framework tree copied verbatim, copied resources,
//                and the index.html entry point.  The layout matches the
//                legacy jake output exactly so that existing server
//                configurations require no change.
//
// Delivery context selects the output shape, independently of build mode:
//
//   HTTP1: the per-file records are concatenated into a single .sj bundle
//          (the @STATIC;1.0; <p;t>… e; framing), written to both
//          Browser.environment/ and CommonJS.environment/.
//   HTTP2: the per-file records phase 8 wrote under
//          Build/capp-build.build/<Mode>/Sources/ are themselves the
//          deliverable; multiplexing serves them individually, so no
//          concatenation occurs.  Not yet implemented; carried as an Info
//          diagnostic until the serving infrastructure exists to verify it.
//
// Record framing follows STATIC-BLOB-FORMAT.md: p/t lengths are UTF-16
// code units (bundle_length), matching phase 8's per-file framing.
//
// Application output layout (HTTP1, matches legacy jake verbatim):
//
//   Build/<Mode>/<Name>/
//     index.html                   ← copied from project root
//     Info.plist                   ← 280NPLIST generated from source plist
//     Resources/                   ← .cib files copied from project Resources/
//     Browser.environment/
//       MHTMLTest.txt              ← constant browser MHTML capability probe
//       <Name>.sj                  ← assembled bundle from compiled records
//     CommonJS.environment/
//       <Name>.sj                  ← same assembled bundle (CommonJS target)
//     Frameworks/                  ← source Frameworks/ tree copied verbatim
//
// **
import "go:fmt"
import "go:io"
import "go:os"
import "go:path/filepath"
import "go:strings"
import "go:unicode/utf8"

pub struct ArchiveResult {
  pub output: string,
  pub diags: Slice<Diagnostic>,
}

pub fn run_archive(ctx: Ref<BuildContext>) -> Result<ArchiveResult, error> {
  let phase = BuildPhase.Archive
  let mut diags: Slice<Diagnostic> = []

  if let BuildMode.Clean = ctx.config.mode {
    diags = diags.append(diag_info(phase, "clean mode: nothing to archive"))
    fmt.Println("✓  archive: clean mode, nothing to archive")
    print_archive_diags(diags)
    return Ok(ArchiveResult { output: ctx.root.path, diags })
  }

  let compiled = match ctx.compiled {
    Some(c) => c,
    None => {
      diags = diags.append(diag_info(
        phase,
        "no compiled output; nothing to archive",
      ))
      fmt.Println("✓  archive: no compiled output, nothing to archive")
      print_archive_diags(diags)
      return Ok(ArchiveResult { output: ctx.root.path, diags })
    },
  }

  let project = match ctx.project {
    Some(p) => p,
    None => {
      diags = diags.append(diag_info(
        phase,
        "no validated project; nothing to archive",
      ))
      fmt.Println("✓  archive: no validated project, nothing to archive")
      print_archive_diags(diags)
      return Ok(ArchiveResult { output: ctx.root.path, diags })
    },
  }

  // Each arm returns (output_path, arm_diags).  arm_diags are merged into
  // the phase accumulator below; the arms do not touch the outer diags
  // directly, which avoids double-appending on the Theme path.
  let (output, arm_diags) = match project.details {
    Application(app) => {
      archive_application(ctx, compiled, project.meta, app, phase)?
    },
    Framework => {
      archive_framework(ctx, compiled, project.meta, phase)?
    },
    Theme => {
      // TODO: Theme archive strategy not yet defined.  Themes share the
      // framework environment layout but their resource handling differs;
      // defer until a Theme project exists as a test corpus.
      fmt.Println("✓  archive: theme (not yet implemented)")
      (ctx.root.path, [diag_info(phase, "theme archive: not yet implemented")])
    },
  }

  for d in arm_diags {
    diags = diags.append(d)
  }

  print_archive_diags(diags)
  Ok(ArchiveResult { output, diags })
}

// ---------------------------------------------------------------------------
// Application archive
// ---------------------------------------------------------------------------

// archive_application assembles the full deliverable directory for an
// Application project under Build/<Mode>/<Name>/, matching the legacy jake
// output layout exactly.
//
// Returns the output directory path and the diagnostics accumulated during
// assembly; the caller merges them into its own diagnostic slice.
fn archive_application(
  ctx: Ref<BuildContext>,
  compiled: CompileOutput,
  meta: PlistMeta,
  app: ApplicationDetails,
  phase: BuildPhase,
) -> Result<(string, Slice<Diagnostic>), error> {
  let mut diags: Slice<Diagnostic> = []
  let out_dir = app_output_dir(ctx, meta)
  os.MkdirAll(out_dir, os.ModePerm)?

  match ctx.config.delivery {
    HTTP1 => {
      let http1_diags = archive_application_http1(
        ctx,
        compiled,
        meta,
        app,
        out_dir,
        phase,
      )?
      for d in http1_diags {
        diags = diags.append(d)
      }
    },
    HTTP2 => {
      // TODO: HTTP2 application delivery — serve per-file records from
      // Build/capp-build.build/<Mode>/Sources/ via multiplexing.  Deferred
      // until an HTTP2-capable serving environment is available for
      // verification.
      diags = diags.append(diag_info(
        phase,
        "http2 application delivery: not yet implemented",
      ))
      fmt.Println(
        "✓  archive: http2 application delivery (not yet implemented)",
      )
    },
  }

  Ok((out_dir, diags))
}

// archive_application_http1 writes the HTTP1 application deliverable.
// Returns diagnostics accumulated during assembly.
fn archive_application_http1(
  ctx: Ref<BuildContext>,
  compiled: CompileOutput,
  meta: PlistMeta,
  app: ApplicationDetails,
  out_dir: string,
  phase: BuildPhase,
) -> Result<Slice<Diagnostic>, error> {
  let mut diags: Slice<Diagnostic> = []

  // Assemble the bundle from the compiled records.
  let bundle = assemble_bundle(compiled.records)

  // Browser.environment/<Name>.sj
  let browser_env = filepath.Join(out_dir, "Browser.environment")
  os.MkdirAll(browser_env, os.ModePerm)?
  let browser_sj = filepath.Join(browser_env, f"{meta.name}.sj")
  write_bundle(browser_sj, bundle)?

  // Measure the written bundle size for CPApplicationSize.  The runtime uses
  // this to drive the loading progress bar; it is measured in bytes.
  // TODO: CPApplicationSize.executable in the legacy build reflects the total
  // bytes of all loaded executables (application .sj + all framework .sj
  // files).  capp-build currently reports only the application bundle size.
  // The progress bar will reach 100% later than with the legacy value; this
  // will be corrected when framework compilation produces bundles whose sizes
  // are known at archive time.
  let sj_size = file_byte_size(browser_sj)

  // Browser.environment/MHTMLTest.txt — constant browser MHTML capability
  // probe written by the legacy build system.  Content is invariant.
  write_file_str(filepath.Join(browser_env, "MHTMLTest.txt"), mhtml_test_stub())?

  // CommonJS.environment/<Name>.sj — same bundle content, CommonJS target.
  // The legacy toolchain writes an identical copy rather than a symlink.
  // TODO: investigate whether a hard link would be safe here; the runtime
  // loader reads both paths independently so deduplication is an
  // optimisation, not a correctness concern.
  let commonjs_env = filepath.Join(out_dir, "CommonJS.environment")
  os.MkdirAll(commonjs_env, os.ModePerm)?
  write_bundle(filepath.Join(commonjs_env, f"{meta.name}.sj"), bundle)?

  // index.html — copied from project root.
  copy_file(
    filepath.Join(ctx.root.path, "index.html"),
    filepath.Join(out_dir, "index.html"),
  )?

  // Info.plist — generated in 280NPLIST format from the source XML plist.
  // The Cappuccino runtime sniffs the magic number "280NPLIST" and dispatches
  // to its 280North deserialiser; it does not require a DOM parser and works
  // in all load contexts including file://.
  let src_plist_path = filepath.Join(ctx.root.path, "Info.plist")
  let dst_plist_path = filepath.Join(out_dir, "Info.plist")
  write_app_info_plist(src_plist_path, dst_plist_path, meta, sj_size)?

  // Resources/ — copy deployment artifacts from the project Resources/
  // directory.  .xib sources are excluded: they are inputs to the nib2cib
  // compilation step, which is not yet implemented as a phase.
  // TODO: implement .xib → .cib compilation and integrate it here or as a
  // separate phase ahead of archive.
  let src_resources = filepath.Join(ctx.root.path, "Resources")
  let dst_resources = filepath.Join(out_dir, "Resources")
  copy_resources(src_resources, dst_resources)?

  // Frameworks/ — copy the source Frameworks/ tree verbatim.  The legacy
  // build copies the entire tree (release and Debug/ variants both) regardless
  // of build mode, so we do the same.
  // TODO: the Debug/ subtree under Frameworks/ contains debug-build framework
  // bundles.  A future optimisation could omit it from release builds, but
  // matching the legacy layout takes precedence until the community explicitly
  // adopts the new toolchain.
  let src_frameworks = filepath.Join(ctx.root.path, "Frameworks")
  let dst_frameworks = filepath.Join(out_dir, "Frameworks")
  copy_dir_recursive(src_frameworks, dst_frameworks)?

  // app carries ApplicationDetails (FrameworkRoots) for the future path where
  // framework bundles are built from source rather than copied from the source
  // tree.  Currently the Frameworks/ copy above serves both roles.
  // TODO: when framework compilation is implemented, use app.frameworks to
  // locate build outputs rather than copying from the source tree.
  let _ = app

  let n = compiled.records.length()
  diags = diags.append(diag_info(
    phase,
    f"http1 application: {n} records → {out_dir}",
  ))
  fmt.Println(f"✓  archive: http1 application, {n} records → {out_dir}")
  Ok(diags)
}

// ---------------------------------------------------------------------------
// Info.plist generation
// ---------------------------------------------------------------------------

// write_app_info_plist generates the application Info.plist in 280NPLIST
// format and writes it to dst_path.
//
// The generated plist carries the keys the Cappuccino runtime requires to
// locate and load the application bundle:
//
//   CPBundlePackageType        from PlistMeta (always "APPL" for Application)
//   CPBundleIdentifier         from PlistMeta
//   CPBundleName               from PlistMeta
//   CPBundleVersion            from source plist, or "1.0" if absent
//   CPHumanReadableCopyright   from source plist, or "" if absent
//   Main cib file base name    from source plist, or "" if absent
//   CPBundleInfoDictionaryVersion  6  (fixed; the runtime expects this)
//   CPBundleEnvironments       ["Browser", "CommonJS"]
//   CPBundleExecutable         "<Name>.sj"
//   CPBundleEnvironmentsWithImageSprites  []  (no sprites in app bundle)
//   CPApplicationSize          { executable: <sj_byte_size>, data: 0, mhtml: 0 }
//
// sj_byte_size is the byte length of the assembled .sj file, used by the
// runtime's loading progress bar.
fn write_app_info_plist(
  src_path: string,
  dst_path: string,
  meta: PlistMeta,
  sj_byte_size: int,
) -> Result<(), error> {
  // Read the source XML plist to extract passthrough keys.  Failure to read
  // is non-fatal: the generated plist proceeds with fallback values and the
  // runtime's required keys are always present.
  let xml_content = os.ReadFile(src_path).map_or("", |b| b as string)

  let version = plist_xml_string(xml_content, "CPBundleVersion").unwrap_or(
    "1.0",
  )
  let copyright = plist_xml_string(xml_content, "CPHumanReadableCopyright").unwrap_or(
    "",
  )
  let cib_name = plist_xml_string(xml_content, "Main cib file base name").unwrap_or(
    "",
  )

  let executable = f"{meta.name}.sj"

  let mut pairs: Slice<Plist280NPair> = []
  pairs = pairs.append(
    Plist280NPair { 
      key: "CPBundlePackageType",
      value: Plist280NValue.PString(meta.package_type),
    },
  )
  pairs = pairs.append(
    Plist280NPair { 
      key: "CPBundleIdentifier",
      value: Plist280NValue.PString(meta.identifier),
    },
  )
  pairs = pairs.append(
    Plist280NPair { 
      key: "CPBundleName",
      value: Plist280NValue.PString(meta.name),
    },
  )
  pairs = pairs.append(
    Plist280NPair { 
      key: "CPBundleVersion",
      value: Plist280NValue.PString(version),
    },
  )
  if !copyright.is_empty() {
    pairs = pairs.append(
      Plist280NPair { 
        key: "CPHumanReadableCopyright",
        value: Plist280NValue.PString(copyright),
      },
    )
  }
  if !cib_name.is_empty() {
    pairs = pairs.append(
      Plist280NPair { 
        key: "Main cib file base name",
        value: Plist280NValue.PString(cib_name),
      },
    )
  }
  // CPBundleInfoDictionaryVersion is always the integer 6; the runtime
  // expects this key to be present.
  pairs = pairs.append(
    Plist280NPair { 
      key: "CPBundleInfoDictionaryVersion",
      value: Plist280NValue.PInteger(6),
    },
  )
  pairs = pairs.append(
    Plist280NPair { 
      key: "CPBundleEnvironments",
      value: Plist280NValue.PArray([
        Plist280NValue.PString("Browser"),
        Plist280NValue.PString("CommonJS"),
      ]),
    },
  )
  pairs = pairs.append(
    Plist280NPair { 
      key: "CPBundleExecutable",
      value: Plist280NValue.PString(executable),
    },
  )
  // CPBundleEnvironmentsWithImageSprites: empty array — the application
  // bundle itself has no sprites.  Framework sprite entries live in the
  // respective framework Info.plists, which are copied verbatim.
  pairs = pairs.append(
    Plist280NPair { 
      key: "CPBundleEnvironmentsWithImageSprites",
      value: Plist280NValue.PArray([]),
    },
  )
  // CPApplicationSize drives the loading progress bar.  The executable size
  // is the assembled .sj byte count; data and mhtml are zero for this bundle
  // (sprites belong to the frameworks, not the application bundle itself).
  let size_pairs: Slice<Plist280NPair> = [
    Plist280NPair { 
      key: "executable",
      value: Plist280NValue.PInteger(sj_byte_size),
    },
    Plist280NPair { key: "data", value: Plist280NValue.PInteger(0) },
    Plist280NPair { key: "mhtml", value: Plist280NValue.PInteger(0) },
  ]
  pairs = pairs.append(
    Plist280NPair { 
      key: "CPApplicationSize",
      value: Plist280NValue.PDict(size_pairs),
    },
  )

  let content = encode_plist280n(Plist280NValue.PDict(pairs))
  write_file_str(dst_path, content)
}

// plist_xml_string extracts a string value from an XML plist by key.
// Duplicated from phase01_validate.lis; consolidate into a shared plist
// utility module when the plist surface grows further.
// TODO: consolidate plist_string / plist_xml_string into a shared module.
fn plist_xml_string(content: string, key: string) -> Option<string> {
  let key_tag = f"<key>{key}</key>"
  let key_idx = strings.Index(content, key_tag)?
  let after_key = content.substring((key_idx + key_tag.length())..)
  let open_idx = strings.Index(after_key, "<string>")?
  let after_open = after_key.substring((open_idx + 8)..)
  let close_idx = strings.Index(after_open, "</string>")?
  Some(strings.TrimSpace(after_open.substring(..close_idx)))
}

// file_byte_size returns the byte size of a file on disk, or 0 if the stat
// fails.  Used to populate CPApplicationSize.executable.
// os.Stat returns Result<FileInfo, error> in Lisette; map_or is the
// demanded idiom for a two-arm value-producing match.
fn file_byte_size(path: string) -> int {
  os.Stat(path).map_or(0, |info| info.Size() as int)
}

// ---------------------------------------------------------------------------
// Framework archive
// ---------------------------------------------------------------------------

// archive_framework writes the compiled bundle for a Framework project.
// The destination is <project>/<Name>/ObjJ.environment/<Name>.sj, the layout
// the ObjJ runtime loader expects when resolving framework bundles.
//
// Returns the output path and the diagnostics accumulated during assembly;
// the caller merges them into its own diagnostic slice.
fn archive_framework(
  ctx: Ref<BuildContext>,
  compiled: CompileOutput,
  meta: PlistMeta,
  phase: BuildPhase,
) -> Result<(string, Slice<Diagnostic>), error> {
  let mut diags: Slice<Diagnostic> = []

  match ctx.config.delivery {
    HTTP1 => {
      let env_dir = filepath.Join(ctx.root.path, meta.name, "ObjJ.environment")
      os.MkdirAll(env_dir, os.ModePerm)?
      let out_path = filepath.Join(env_dir, f"{meta.name}.sj")
      let bundle = assemble_bundle(compiled.records)
      write_bundle(out_path, bundle)?
      let n = compiled.records.length()
      diags = diags.append(diag_info(
        phase,
        f"http1 framework: {n} records → {out_path}",
      ))
      fmt.Println(f"✓  archive: http1 framework, {n} records → {out_path}")
      Ok((out_path, diags))
    },
    HTTP2 => {
      // TODO: HTTP2 framework delivery — per-file records as the deliverable.
      // Deferred until an HTTP2-capable serving environment is available for
      // verification.
      diags = diags.append(diag_info(
        phase,
        "http2 framework delivery: not yet implemented",
      ))
      fmt.Println("✓  archive: http2 framework delivery (not yet implemented)")
      Ok((ctx.root.path, diags))
    },
  }
}

// ---------------------------------------------------------------------------
// Path helpers
// ---------------------------------------------------------------------------

// app_output_dir returns Build/<Mode>/<Name>/ inside the project root —
// the root of the assembled application deliverable, matching the legacy
// jake output layout.
fn app_output_dir(ctx: Ref<BuildContext>, meta: PlistMeta) -> string {
  let mode_dir = match ctx.config.mode {
    Debug => "Debug",
    Release => "Release",
    Clean => "Clean",
  }
  filepath.Join(ctx.root.path, "Build", mode_dir, meta.name)
}

// ---------------------------------------------------------------------------
// File system helpers
// ---------------------------------------------------------------------------

// copy_file copies src to dst, creating parent directories as needed.
// Uses io.Copy for streaming rather than reading the whole file into memory —
// relevant for large framework bundles.
fn copy_file(src: string, dst: string) -> Result<(), error> {
  os.MkdirAll(filepath.Dir(dst), os.ModePerm)?
  let src_file = os.Open(src)?
  let dst_file = os.Create(dst)?
  let copied = io.Copy(dst_file, src_file)
  let src_closed = src_file.Close()
  let dst_closed = dst_file.Close()
  match copied {
    Ok(_) => (),
    Err(e) => return Err(e),
    Both(_, e) => return Err(e),
  }
  src_closed?
  dst_closed
}

// copy_resources copies files from src_dir to dst_dir.  Only files whose
// extension is in the allowed set are copied; .xib sources are excluded
// (they are inputs to nib2cib, not deployment artifacts).
// Non-existence of src_dir is silently tolerated — projects with no
// Resources/ directory are valid.
fn copy_resources(src_dir: string, dst_dir: string) -> Result<(), error> {
  if let Err(_) = os.Stat(src_dir) { return Ok(()) }
  // os.ReadDir returns ([]DirEntry, error) — surfaces as Partial in Lisette.
  // Both means a partial listing was returned before an error; treat as error,
  // matching the io.Copy convention in copy_file above.
  let entries = match os.ReadDir(src_dir) {
    Ok(e) => e,
    Err(e) => return Err(e),
    Both(_, e) => return Err(e),
  }
  for entry in entries {
    if entry.IsDir() { continue }
    let name = entry.Name()
    if !is_resource_file(name) { continue }
    copy_file(filepath.Join(src_dir, name), filepath.Join(dst_dir, name))?
  }
  Ok(())
}

// is_resource_file returns true for file extensions that are deployment
// artifacts copied to the Resources/ output directory.  .xib is excluded:
// it is a source file compiled to .cib by nib2cib, which is not yet
// implemented as a phase.
fn is_resource_file(name: string) -> bool {
  let ext = strings.ToLower(filepath.Ext(name))
  match ext {
    ".cib" => true,
    ".png" => true,
    ".jpg" => true,
    ".jpeg" => true,
    ".gif" => true,
    ".pdf" => true,
    ".css" => true,
    ".ttf" => true,
    ".otf" => true,
    ".woff" => true,
    ".woff2" => true,
    _ => false,
  }
}

// copy_dir_recursive copies the entire directory tree rooted at src into dst,
// creating directories as needed.  Symlinks at any level are followed: the
// directory-vs-file branch uses os.Stat on the resolved path rather than
// entry.IsDir(), which reflects only the type of the link entry itself and
// returns false for a symlink whose target is a directory.  The destination
// always receives regular files and concrete directories, never symlinks.
// Used to copy the Frameworks/ tree verbatim; individual frameworks may be
// concrete directories or symlinks to directories.
fn copy_dir_recursive(src: string, dst: string) -> Result<(), error> {
  if let Err(_) = os.Stat(src) { return Ok(()) }
  os.MkdirAll(dst, os.ModePerm)?
  // os.ReadDir returns ([]DirEntry, error) — surfaces as Partial in Lisette.
  // Both means a partial listing was returned before an error; treat as error.
  let entries = match os.ReadDir(src) {
    Ok(e) => e,
    Err(e) => return Err(e),
    Both(_, e) => return Err(e),
  }
  for entry in entries {
    let name = entry.Name()
    let src_path = filepath.Join(src, name)
    let dst_path = filepath.Join(dst, name)
    // entry.IsDir() is false for symlinks regardless of the target type.
    // os.Stat follows the symlink; IsDir() on the resulting FileInfo is
    // authoritative for the resolved target.
    let is_dir = os.Stat(src_path).map_or(false, |info| info.IsDir())
    if is_dir {
      copy_dir_recursive(src_path, dst_path)?
    } else {
      copy_file(src_path, dst_path)?
    }
  }
  Ok(())
}

// write_file_str writes a string to a file, creating parent directories as
// needed.  Used for constant-content files (MHTMLTest.txt, Info.plist).
fn write_file_str(path: string, content: string) -> Result<(), error> {
  os.MkdirAll(filepath.Dir(path), os.ModePerm)?
  let file = os.Create(path)?
  let written = file.WriteString(content)
  let closed = file.Close()
  match written {
    Ok(_) => closed,
    Err(e) => Err(e),
    Both(_, e) => Err(e),
  }
}

// mhtml_test_stub returns the constant browser MHTML capability probe written
// by the legacy build system into every application's Browser.environment/.
// The content is invariant across projects and build modes.
fn mhtml_test_stub() -> string {
  "/*\nContent-Type: multipart/related; boundary=\"_SEPARATOR_\"\n\n--_SEPARATOR_\nContent-Location:test\nContent-Transfer-Encoding:base64\n\nR0lGODlhAQABAIAAAMc9BQAAACH5BAAAAAAALAAAAAABAAEAAAICRAEAOw==\n*/"
}

// ---------------------------------------------------------------------------
// Bundle assembly
// ---------------------------------------------------------------------------

// assemble_bundle concatenates per-file records into a single @STATIC;1.0;
// bundle stream: a p (path) record then a t (text) record per compiled
// file, in delivered order, terminated by e;.  The framing is the bundle
// level of STATIC-BLOB-FORMAT.md; the t content is the complete per-file
// record string phase 8 produced (itself @STATIC;1.0;-framed).
fn assemble_bundle(records: Slice<CompiledRecord>) -> string {
  let mut out = "@STATIC;1.0;"
  for compiled in records {
    out += f"p;{bundle_length(compiled.name)};{compiled.name}"
    out += f"t;{bundle_length(compiled.record)};{compiled.record}"
  }
  out += "e;"
  out
}

// bundle_length is the record-framing length: UTF-16 code units, counted as
// code points (exact across the BMP; supplementary-plane characters would
// each need one more unit, none exist in any observed corpus, and
// payload_oracle.py check exposes the case).  Mirrors phase 8's
// record_length so the two framing levels agree.
fn bundle_length(content: string) -> int {
  utf8.RuneCountInString(content)
}

// write_bundle materialises the assembled bundle.  WriteString returns a
// partial result; a short write is an error, and a write error takes
// precedence over a close error (the phase 8 write_record_file convention).
fn write_bundle(out_path: string, bundle: string) -> Result<(), error> {
  os.MkdirAll(filepath.Dir(out_path), os.ModePerm)?
  let file = os.Create(out_path)?
  let written = file.WriteString(bundle)
  let closed = file.Close()
  match written {
    Ok(_) => closed,
    Err(e) => Err(e),
    Both(_, e) => Err(e),
  }
}

// ---------------------------------------------------------------------------
// Diagnostic output
// ---------------------------------------------------------------------------

// print_archive_diags surfaces each archive diagnostic in the build output,
// mirroring phase 3's print_lowering_diag: phases print their own
// diagnostics directly rather than relying on the orchestrator, which
// discards them.  Info diagnostics carry no position; message only.
fn print_archive_diags(diags: Slice<Diagnostic>) {
  for d in diags {
    fmt.Println(f"   {d.message}")
  }
}
