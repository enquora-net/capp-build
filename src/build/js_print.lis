//**
// build/js_print.lis
// capp-build
//
// Created by David Richardson on Friday, June 12, 2026.
// Copyright (c) 2026 David Richardson. All rights reserved.
//
// Phase 8, tier A: the JavaScript printer.  Typed AST (cst.lis) in,
// legacy-byte-exact JavaScript text out.
//
// The emitter law is not designed here — it is transcribed.  The legacy
// code generator ships inside Frameworks/Objective-J/Objective-J.js (the
// acorn-based ObjJAcornCompiler); its visitor table was beautified and
// read directly, and PHASE-8-BRIEF.md ("The emitter law") records every
// template, quirk, and the P/T parenthesization tables reproduced below.
// Where the legacy generator is quirky (for-of without indentation,
// `switch(` without a space, un-indented `default:`, labels without
// indentation, `await (x)` always parenthesized, `(a) ?? (b)` always
// parenthesized), the quirk is the law: the oracle is byte equality
// against legacy output (payload_oracle.py).
//
// The global-escape rewrite: static-blob builds run the legacy compiler
// with transformNamedFunctionDeclarationToAssignment enabled (the runtime
// defaults it on), so every named function — declaration or expression,
// top level or nested — prints as `name = function(...)`.  This printer
// applies the same rewrite unconditionally.
//
// Tier B (same day) adds the ObjJ structure scaffolds — class
// implementations and categories, method wrappers with type arrays,
// ivars, synthesized accessor bodies, protocols, typedefs, conformance —
// transcribed from the legacy ClassDeclarationStatement /
// MethodDeclarationStatement / ProtocolDeclarationStatement emitters
// (PHASE-8-BRIEF.md, "The emitter law, tier B"), plus the ivar ->
// self.ivar rewrite with its scope machinery.
//
// Recorded deviations from the legacy mechanics (all corpus-invisible):
//   - Object-literal and class methods print with the rewrite OFF.  The
//     legacy emitter with the transform enabled would produce `name = (...)`
//     inside braces -- invalid JavaScript.  No corpus file contains either
//     form; the valid-JS reading is taken.  (PROGRESS-SNAPSHOT.md.)
//   - `using` / `await using` declarations have no legacy emitter; they
//     print mechanically in variable-declaration shape.
//   - Scope pre-scan: locals are collected once per function scope (all
//     block depths), where the legacy registers in visit order and
//     retroactively unprefixes hoisted vars by buffer surgery.  Output
//     differs only for an ivar-shadowing local declared in a different
//     block of the same function -- none exist in any corpus, and the
//     legacy warns on the pattern anyway.
//
// Deferred constructs route through named catch-all diagnostics, per the
// house pattern: message sends and the @accessors(copy) setter (tier C),
// ObjJ expression literals -- @"...", @[...], @{...}, @selector, @protocol
// expressions, @ref/@deref (tier D), and #if blocks (pending the
// build-feature environment, PHASE-8-BRIEF.md decision 4).  Each deferral
// emits no text, so payloads for files containing them are incomplete by
// construction; the diagnostics say exactly what is missing.
//
// Text accumulation: every printer method takes a buf: Ref<strings.Builder>
// and writes directly to it, returning only Slice<Diagnostic>.  A single
// Builder threads from print_js_program through every recursive call;
// strings.Builder.String() is called once at the top to produce the payload.
// This replaces the prior += accumulation pattern, which went quadratic as
// output grew.  The public JsPrinted struct is retained as the boundary type
// for phase08_compile.lis, which is unchanged.
//
// Everything here is pure: typed values in, JsPrinted out.  Indentation
// is an explicit parameter (4-space unit); a block prints its braces one
// step shallower than its contents, exactly as the legacy indentation
// bookkeeping does.
//
// **
import "go:strings"

// JsPrinted is the printer's output type at the phase boundary.
// Internally all text is written through a shared strings.Builder;
// this struct is only constructed once, at the top of print_js_program.
pub struct JsPrinted {
  pub text: string,
  pub diags: Slice<Diagnostic>,
}

pub fn print_js_program(
  program: Program,
  file: string,
  symbols: Option<SymbolTable>,
  debug_dispatch: bool,
) -> JsPrinted {
  let mut known_classes = Map.new<string, bool>()
  if let Some(table) = symbols {
    for class_symbol in table.classes {
      known_classes[class_symbol.name] = true
    }
    for forward in table.forwards {
      known_classes[forward.name] = true
    }
  }
  let mut top_receivers = ReceiverState { .. }
  let p = JsPrint {
    file,
    symbols,
    known_classes,
    debug_dispatch,
    receivers: Some(&top_receivers),
    ..,
  }
  let mut buf = strings.Builder { .. }
  if let Some(hash_bang) = program.hash_bang {
    write(&buf, hash_bang.text)
    write(&buf, "\n")
  }
  let prologue = directive_prologue_len(program.body)
  let mut diags: Slice<Diagnostic> = []
  for i in 0..program.body.length() {
    diags = merge_diags(
      diags,
      p.statement(&buf, program.body[i], "", i < prologue),
    )
  }
  JsPrinted { text: buf.String(), diags }
}

struct JsPrint {
  file: string,
  symbols: Option<SymbolTable>,
  known_classes: Map<string, bool>,
  debug_dispatch: bool,
  current_class: Option<ClassContext>,
  in_instance_method: bool,
  self_assigned: bool,
  locals: Slice<string>,
  receivers: Option<Ref<ReceiverState>>,
}

struct ClassContext { name: string, ivars: Map<string, bool> }

struct ReceiverState { level: int, max: int }

// write appends s to buf, discarding the Partial return that
// strings.Builder.WriteString always resolves to Ok.
fn write(buf: Ref<strings.Builder>, s: string) {
  let _ = buf.WriteString(s)
}

fn indent_step() -> string {
  "    "
}

fn outdent(ind: string) -> string {
  if ind.length() >= 4 { ind.substring(4..ind.length()) } else { "" }
}

fn expr_prec(e: Expression) -> int {
  match e {
    Primary(primary) => primary_prec(primary),
    Assignment(_) => 8,
    AugmentedAssignment(_) => 8,
    Await(_) => -1,
    Unary(_) => 4,
    Binary(binary) => {
      if binary_op_is_logical(binary.operator) { 6 } else { 5 }
    },
    Ternary(_) => 7,
    Update(_) => 4,
    New(_) => 1,
    Yield(_) => -1,
  }
}

fn primary_prec(primary: PrimaryExpression) -> int {
  match primary {
    Subscript(_) | Member(_) | Call(_) => 1,
    Function(_) | Generator(_) | Arrow(_) => 3,
    _ => -1,
  }
}

fn binary_op_t(op: BinaryOp) -> int {
  match op {
    Mul | Div | Mod => 3,
    Add | Sub => 4,
    ShiftLeft | ShiftRight | UnsignedShiftRight => 5,
    LessThan | LessEqual | GreaterThan | GreaterEqual | In | Instanceof => 6,
    Equal | NotEqual | StrictEqual | StrictNotEqual => 7,
    BitAnd => 8,
    BitXor => 9,
    BitOr => 10,
    LogicalAnd => 11,
    LogicalOr => 12,
    NullishCoalesce => 13,
    Exp => 0,
  }
}

fn binary_op_is_logical(op: BinaryOp) -> bool {
  match op {
    LogicalAnd | LogicalOr | NullishCoalesce => true,
    _ => false,
  }
}

fn binary_op_text(op: BinaryOp) -> string {
  match op {
    LogicalAnd => "&&",
    LogicalOr => "||",
    ShiftRight => ">>",
    UnsignedShiftRight => ">>>",
    ShiftLeft => "<<",
    BitAnd => "&",
    BitXor => "^",
    BitOr => "|",
    Add => "+",
    Sub => "-",
    Mul => "*",
    Div => "/",
    Mod => "%",
    Exp => "**",
    LessThan => "<",
    LessEqual => "<=",
    Equal => "==",
    StrictEqual => "===",
    NotEqual => "!=",
    StrictNotEqual => "!==",
    GreaterEqual => ">=",
    GreaterThan => ">",
    NullishCoalesce => "??",
    Instanceof => "instanceof",
    In => "in",
  }
}

fn unary_op_text(op: UnaryOp) -> string {
  match op {
    Not => "!",
    BitNot => "~",
    Negate => "-",
    Plus => "+",
    Typeof => "typeof",
    Void => "void",
    Delete => "delete",
  }
}

fn unary_op_is_word(op: UnaryOp) -> bool {
  match op {
    Typeof | Void | Delete => true,
    _ => false,
  }
}

fn update_op_text(op: UpdateOp) -> string {
  match op {
    Increment => "++",
    Decrement => "--",
  }
}

fn augmented_op_text(op: AugmentedAssignmentOp) -> string {
  match op {
    Add => "+=",
    Sub => "-=",
    Mul => "*=",
    Div => "/=",
    Mod => "%=",
    BitXor => "^=",
    BitAnd => "&=",
    BitOr => "|=",
    ShiftRight => ">>=",
    UnsignedShiftRight => ">>>=",
    ShiftLeft => "<<=",
    Exp => "**=",
    LogicalAnd => "&&=",
    LogicalOr => "||=",
    NullishCoalesce => "??=",
  }
}

fn lexical_kind_text(kind: LexicalKind) -> string {
  match kind {
    Let => "let",
    Const => "const",
  }
}

fn variable_kind_text(kind: VariableKind) -> string {
  match kind {
    Var => "var",
    Let => "let",
    Const => "const",
    Using => "using",
    AwaitUsing => "await using",
  }
}

fn operand_needs_parens(
  parent_prec: int,
  parent_t: int,
  parent_is_operator: bool,
  e: Expression,
  is_right: bool,
) -> bool {
  let child_prec = expr_prec(e)
  if parent_prec < child_prec { return true }
  if parent_prec != child_prec || !parent_is_operator { return false }
  let child_t = match e {
    Binary(binary) => binary_op_t(binary.operator),
    _ => 0,
  }
  if parent_t == 0 || child_t == 0 { return false }
  parent_t < child_t || (is_right && parent_t == child_t)
}

fn directive_prologue_len(body: Slice<Statement>) -> int {
  let mut n = 0
  for st in body {
    let is_directive = match st {
      Expression(es) => match es.expression.* {
        Single(e) => expression_is_string(e),
        Sequence(_) => false,
      },
      _ => false,
    }
    if !is_directive { return n }
    n += 1
  }
  n
}

fn expression_is_string(e: Expression) -> bool {
  match e {
    Primary(String(_)) => true,
    _ => false,
  }
}

fn is_use_strict(literal: StringLiteral) -> bool {
  literal.text == "\"use strict\"" || literal.text == "'use strict'"
}

impl JsPrint {
  fn statement(
    self,
    buf: Ref<strings.Builder>,
    st: Statement,
    ind: string,
    is_directive: bool,
  ) -> Slice<Diagnostic> {
    match st {
      Expression(es) => self.expression_statement(buf, es, ind, is_directive),
      Declaration(declaration) => self.declaration(buf, declaration, ind),
      BlockScope(block) => self.block(buf, block, ind, false, true, false),
      If(if_st) => self.if_statement(buf, if_st, ind, false),
      Switch(switch_st) => self.switch_statement(buf, switch_st, ind),
      For(for_st) => self.for_statement(buf, for_st, ind),
      ForIn(for_in) => self.for_in_statement(buf, for_in, ind),
      While(while_st) => self.while_statement(buf, while_st, ind),
      Do(do_st) => self.do_statement(buf, do_st, ind),
      Try(try_st) => self.try_statement(buf, try_st, ind),
      With(with_st) => self.with_statement(buf, with_st, ind),
      Break(break_st) => {
        let label = break_st.label.map_or(
          "",
          |identifier| f" {identifier.text}",
        )
        write(buf, f"{ind}break{label};\n")
        []
      },
      Continue(continue_st) => {
        let label = continue_st.label.map_or(
          "",
          |identifier| f" {identifier.text}",
        )
        write(buf, f"{ind}continue{label};\n")
        []
      },
      Return(return_st) => {
        write(buf, ind + "return")
        let mut diags: Slice<Diagnostic> = []
        if let Some(value) = return_st.value {
          write(buf, " ")
          diags = self.expressions(buf, value, ind)
        }
        write(buf, ";\n")
        diags
      },
      Throw(throw_st) => {
        write(buf, ind + "throw ")
        let diags = self.expressions(buf, throw_st.value.*, ind)
        write(buf, ";\n")
        diags
      },
      Empty(_) => {
        write(buf, ";\n")
        []
      },
      Labeled(labeled) => {
        write(buf, labeled.label.text + ": ")
        self.statement(buf, labeled.body.*, ind, false)
      },
      Debugger(_) => {
        write(buf, ind + "debugger;\n")
        []
      },
      Import(import_st) => self.es_import(buf, import_st),
      Export(export_st) => self.es_export(buf, export_st, ind),
      ObjjImport(import_directive) => self.objj_import(buf, import_directive),
      ObjjGlobal(_) => [],
      ObjjClassForward(_) => [],
      ObjjTypedef(typedef) => {
        objj_typedef_write(buf, typedef.name.text)
        []
      },
      ObjjProtocol(protocol) => self.objj_protocol(buf, protocol),
      ObjjClassImpl(implementation) => self.objj_class_implementation(
        buf,
        implementation,
      ),
      PreprocIf(preproc) => self.deferred(
        "#if block",
        "build-feature environment (PHASE-8-BRIEF.md decision 4)",
        preproc.pos,
      ),
      PreprocDirective(directive) => self.deferred(
        "#preproc directive",
        "build-feature environment (PHASE-8-BRIEF.md decision 4)",
        directive.pos,
      ),
    }
  }

  fn deferred(self, what: string, pending: string, pos: Position) -> Slice<Diagnostic> {
    [
      diag_warn_at(
        BuildPhase.Compile,
        f"codegen: {what} deferred pending {pending}",
        self.file,
        pos.row,
        pos.col,
      ),
    ]
  }

  fn expression_statement(
    self,
    buf: Ref<strings.Builder>,
    st: ExpressionStatement,
    ind: string,
    is_directive: bool,
  ) -> Slice<Diagnostic> {
    write(buf, ind)
    let diags = match st.expression.* {
      Sequence(sequence) => self.sequence(buf, sequence, ind),
      Single(e) => {
        if statement_needs_parens(e, is_directive) {
          self.wrapped(buf, e, ind)
        } else {
          self.expression(buf, e, ind)
        }
      },
    }
    write(buf, ";\n")
    diags
  }

  fn block(
    self,
    buf: Ref<strings.Builder>,
    block: StatementBlock,
    content_ind: string,
    skip_indent: bool,
    trailing_newline: bool,
    end_of_scope: bool,
  ) -> Slice<Diagnostic> {
    if !skip_indent { write(buf, outdent(content_ind)) }
    write(buf, "{\n")
    let prologue = directive_prologue_len(block.body)
    let mut diags: Slice<Diagnostic> = []
    for i in 0..block.body.length() {
      let st = block.body[i]
      match st {
        BlockScope(inner) => diags = merge_diags(
          diags,
          self.block(
            buf,
            inner,
            content_ind + indent_step(),
            false,
            true,
            false,
          ),
        ),
        _ => diags = merge_diags(
          diags,
          self.statement(buf, st, content_ind, i < prologue),
        ),
      }
    }
    if end_of_scope {
      if let Some(state) = self.receivers {
        if state.max > 0 {
          write(buf, content_ind + "var ")
          for i in 0..state.max {
            if i > 0 { write(buf, ", ") }
            write(buf, f"___r{i + 1}")
          }
          write(buf, ";\n")
        }
      }
    }
    write(buf, outdent(content_ind))
    write(buf, "}")
    if trailing_newline { write(buf, "\n") }
    diags
  }

  fn if_statement(
    self,
    buf: Ref<strings.Builder>,
    st: IfStatement,
    ind: string,
    as_else: bool,
  ) -> Slice<Diagnostic> {
    if !as_else { write(buf, ind) }
    write(buf, "if (")
    let mut diags = self.expressions(buf, st.condition.expression.*, ind)
    write(buf, ")")
    let consequent_empty = match st.consequence.* {
      Empty(_) => true,
      _ => false,
    }
    if !consequent_empty { write(buf, "\n") }
    diags = merge_diags(
      diags,
      self.statement(buf, st.consequence.*, ind + indent_step(), false),
    )
    if let Some(alternative) = st.alternative {
      match alternative.body.* {
        If(nested) => {
          write(buf, ind + "else ")
          diags = merge_diags(diags, self.if_statement(buf, nested, ind, true))
        },
        Empty(_) => write(buf, ind + "else;\n"),
        _ => {
          write(buf, ind + "else\n")
          diags = merge_diags(
            diags,
            self.statement(buf, alternative.body.*, ind + indent_step(), false),
          )
        },
      }
    }
    diags
  }

  fn switch_statement(
    self,
    buf: Ref<strings.Builder>,
    st: SwitchStatement,
    ind: string,
  ) -> Slice<Diagnostic> {
    write(buf, ind + "switch(")
    let mut diags = self.expressions(buf, st.value.expression.*, ind)
    write(buf, ") {\n")
    let case_ind = ind + indent_step()
    for entry in st.body.entries {
      match entry {
        Case(case) => {
          write(buf, case_ind + "case ")
          diags = merge_diags(
            diags,
            self.expressions(buf, case.value.*, case_ind),
          )
          write(buf, ":\n")
          for body_st in case.body {
            diags = merge_diags(
              diags,
              self.statement(buf, body_st, case_ind + indent_step(), false),
            )
          }
        },
        Default(default) => {
          write(buf, "default:\n")
          for body_st in default.body {
            diags = merge_diags(
              diags,
              self.statement(buf, body_st, case_ind + indent_step(), false),
            )
          }
        },
      }
    }
    write(buf, ind + "}\n")
    diags
  }

  fn for_statement(
    self,
    buf: Ref<strings.Builder>,
    st: ForStatement,
    ind: string,
  ) -> Slice<Diagnostic> {
    write(buf, ind + "for (")
    let mut diags: Slice<Diagnostic> = []
    match st.initializer {
      Lexical(lexical) => diags = merge_diags(
        diags,
        self.declarators_inline(
          buf,
          lexical_kind_text(lexical.kind),
          lexical.declarators,
          ind,
        ),
      ),
      Variable(variable) => diags = merge_diags(
        diags,
        self.declarators_inline(buf, "var", variable.declarators, ind),
      ),
      Expression(exprs) => diags = merge_diags(
        diags,
        self.for_init_expression(buf, exprs.*, ind),
      ),
      Empty(_) => (),
    }
    write(buf, "; ")
    if let ForCondition.Expression(exprs) = st.condition {
      diags = merge_diags(diags, self.expressions(buf, exprs.*, ind))
    }
    write(buf, "; ")
    if let Some(increment) = st.increment {
      diags = merge_diags(diags, self.expressions(buf, increment, ind))
    }
    write(buf, ")")
    let body_empty = match st.body.* {
      Empty(_) => true,
      _ => false,
    }
    if !body_empty { write(buf, "\n") }
    merge_diags(
      diags,
      self.statement(buf, st.body.*, ind + indent_step(), false),
    )
  }

  fn for_init_expression(
    self,
    buf: Ref<strings.Builder>,
    exprs: Expressions,
    ind: string,
  ) -> Slice<Diagnostic> {
    match exprs {
      Single(e) => {
        let bare_in = match e {
          Binary(binary) => match binary.operator {
            In => true,
            _ => false,
          },
          _ => false,
        }
        if bare_in {
          self.wrapped(buf, e, ind)
        } else {
          self.expression(buf, e, ind)
        }
      },
      Sequence(sequence) => self.sequence(buf, sequence, ind),
    }
  }

  fn for_in_statement(
    self,
    buf: Ref<strings.Builder>,
    st: ForInStatement,
    ind: string,
  ) -> Slice<Diagnostic> {
    let is_of = match st.header.operator {
      Of => true,
      In => false,
    }
    if is_of {
      write(buf, "for")
      if st.is_await { write(buf, " await ") }
      write(buf, "(")
    } else {
      write(buf, ind + "for (")
    }
    let mut diags = self.for_binding(buf, st.header.binding, ind)
    let of_or_in = if is_of { " of " } else { " in " }
    write(buf, of_or_in)
    diags = merge_diags(diags, self.expressions(buf, st.header.right.*, ind))
    write(buf, ")\n")
    merge_diags(
      diags,
      self.statement(buf, st.body.*, ind + indent_step(), false),
    )
  }

  fn for_binding(
    self,
    buf: Ref<strings.Builder>,
    binding: ForBinding,
    ind: string,
  ) -> Slice<Diagnostic> {
    match binding {
      Plain(plain) => match plain.left {
        Lhs(lhs) => self.lhs_expression_value(buf, lhs, ind),
        Parenthesized(parenthesized) => self.parenthesized(
          buf,
          parenthesized,
          ind,
        ),
      },
      Declared(declared) => {
        write(buf, variable_kind_text(declared.kind) + " ")
        let mut diags: Slice<Diagnostic> = []
        match declared.left {
          Identifier(identifier) => write(buf, identifier.text),
          Destructuring(pattern) => diags = self.destructuring(
            buf,
            pattern,
            ind,
          ),
        }
        if let Some(initializer) = declared.initializer {
          write(buf, " = ")
          diags = merge_diags(
            diags,
            self.expression(buf, initializer.value.*, ind),
          )
        }
        diags
      },
    }
  }

  fn while_statement(
    self,
    buf: Ref<strings.Builder>,
    st: WhileStatement,
    ind: string,
  ) -> Slice<Diagnostic> {
    write(buf, ind + "while (")
    let diags = self.expressions(buf, st.condition.expression.*, ind)
    write(buf, ")")
    let body_empty = match st.body.* {
      Empty(_) => true,
      _ => false,
    }
    if !body_empty { write(buf, "\n") }
    merge_diags(
      diags,
      self.statement(buf, st.body.*, ind + indent_step(), false),
    )
  }

  fn do_statement(self, buf: Ref<strings.Builder>, st: DoStatement, ind: string) -> Slice<Diagnostic> {
    write(buf, ind + "do\n")
    let mut diags = self.statement(buf, st.body.*, ind + indent_step(), false)
    write(buf, ind + "while (")
    diags = merge_diags(
      diags,
      self.expressions(buf, st.condition.expression.*, ind),
    )
    write(buf, ");\n")
    diags
  }

  fn with_statement(
    self,
    buf: Ref<strings.Builder>,
    st: WithStatement,
    ind: string,
  ) -> Slice<Diagnostic> {
    write(buf, ind + "with(")
    let diags = self.expressions(buf, st.object.expression.*, ind)
    write(buf, ")\n")
    merge_diags(
      diags,
      self.statement(buf, st.body.*, ind + indent_step(), false),
    )
  }

  fn try_statement(
    self,
    buf: Ref<strings.Builder>,
    st: TryStatement,
    ind: string,
  ) -> Slice<Diagnostic> {
    write(buf, ind + "try ")
    let mut diags = self.block(
      buf,
      st.body,
      ind + indent_step(),
      true,
      false,
      false,
    )
    if let Some(handler) = st.handler {
      write(buf, "\n" + ind + "catch")
      if let Some(parameter) = handler.parameter {
        write(buf, "(")
        match parameter {
          Identifier(identifier) => write(buf, identifier.text),
          Destructuring(pattern) => diags = merge_diags(
            diags,
            self.destructuring(buf, pattern, ind),
          ),
        }
        write(buf, ") ")
      }
      diags = merge_diags(
        diags,
        self.block(buf, handler.body, ind + indent_step(), true, false, false),
      )
    }
    if let Some(finalizer) = st.finalizer {
      write(buf, "\n" + ind + "finally ")
      diags = merge_diags(
        diags,
        self.block(buf, finalizer.body, ind + indent_step(), true, false, false),
      )
    }
    write(buf, "\n")
    diags
  }

  fn declaration(
    self,
    buf: Ref<strings.Builder>,
    declaration: Declaration,
    ind: string,
  ) -> Slice<Diagnostic> {
    match declaration {
      Function(function) => self.function_like(
        buf,
        ind,
        Some(function.name),
        function.is_async,
        false,
        function.parameters,
        function.body,
        true,
      ),
      GeneratorFunction(generator) => self.function_like(
        buf,
        ind,
        Some(generator.name),
        generator.is_async,
        true,
        generator.parameters,
        generator.body,
        true,
      ),
      Class(class) => self.class_like(
        buf,
        Some(class.name),
        class.heritage,
        class.body,
        ind,
        false,
      ),
      Lexical(lexical) => self.variable_declaration(
        buf,
        lexical_kind_text(lexical.kind),
        lexical.declarators,
        ind,
      ),
      Variable(variable) => self.variable_declaration(
        buf,
        "var",
        variable.declarators,
        ind,
      ),
      Using(using) => {
        let kind = if using.is_await { "await using" } else { "using" }
        self.variable_declaration(buf, kind, using.declarators, ind)
      },
    }
  }

  fn variable_declaration(
    self,
    buf: Ref<strings.Builder>,
    kind: string,
    declarators: Slice<VariableDeclarator>,
    ind: string,
  ) -> Slice<Diagnostic> {
    write(buf, ind + kind + " ")
    let mut diags: Slice<Diagnostic> = []
    let mut first = true
    for declarator in declarators {
      if !first { write(buf, ",\n" + ind + "    ") }
      diags = merge_diags(diags, self.declarator(buf, declarator, ind))
      first = false
    }
    write(buf, ";\n")
    diags
  }

  fn declarators_inline(
    self,
    buf: Ref<strings.Builder>,
    kind: string,
    declarators: Slice<VariableDeclarator>,
    ind: string,
  ) -> Slice<Diagnostic> {
    write(buf, kind + " ")
    let mut diags: Slice<Diagnostic> = []
    let mut first = true
    for declarator in declarators {
      if !first { write(buf, ", ") }
      diags = merge_diags(diags, self.declarator(buf, declarator, ind))
      first = false
    }
    diags
  }

  fn declarator(
    self,
    buf: Ref<strings.Builder>,
    declarator: VariableDeclarator,
    ind: string,
  ) -> Slice<Diagnostic> {
    let mut diags: Slice<Diagnostic> = []
    match declarator.name {
      Identifier(identifier) => write(buf, identifier.text),
      Destructuring(pattern) => diags = self.destructuring(buf, pattern, ind),
    }
    if let Some(initializer) = declarator.initializer {
      write(buf, " = ")
      diags = merge_diags(diags, self.expression(buf, initializer.value.*, ind))
    }
    diags
  }

  fn function_like(
    self,
    buf: Ref<strings.Builder>,
    ind: string,
    name: Option<Identifier>,
    is_async: bool,
    is_generator: bool,
    parameters: FormalParameters,
    body: StatementBlock,
    is_declaration: bool,
  ) -> Slice<Diagnostic> {
    write(buf, ind)
    if let Some(identifier) = name { write(buf, identifier.text + " = ") }
    let mut keywords: Slice<string> = []
    if is_async { keywords = keywords.append("async") }
    keywords = keywords.append("function")
    if is_generator { keywords = keywords.append("*") }
    write(buf, strings.Join(keywords, " "))
    write(buf, "(")
    let diags = self.formal_parameters(buf, parameters, ind)
    write(buf, ")\n")
    let mut inner = &self
    let mut dispatch_state = ReceiverState { .. }
    inner.receivers = Some(&dispatch_state)
    inner.locals = function_scope_locals(self.locals, name, parameters, body)
    merge_diags(
      diags,
      inner.block(buf, body, ind + indent_step(), false, is_declaration, true),
    )
  }

  fn formal_parameters(
    self,
    buf: Ref<strings.Builder>,
    parameters: FormalParameters,
    ind: string,
  ) -> Slice<Diagnostic> {
    let mut diags: Slice<Diagnostic> = []
    let mut first = true
    for parameter in parameters.parameters {
      if !first { write(buf, ", ") }
      match parameter {
        Pattern(pattern) => diags = merge_diags(
          diags,
          self.pattern(buf, pattern, ind),
        ),
        Assignment(assignment) => diags = merge_diags(
          diags,
          self.assignment_pattern(buf, assignment, ind),
        ),
      }
      first = false
    }
    diags
  }

  fn class_like(
    self,
    buf: Ref<strings.Builder>,
    name: Option<Identifier>,
    heritage: Option<ClassHeritage>,
    body: ClassBody,
    ind: string,
    is_expression: bool,
  ) -> Slice<Diagnostic> {
    if is_expression { write(buf, "(") }
    write(buf, "class ")
    if let Some(identifier) = name { write(buf, identifier.text) }
    let mut diags: Slice<Diagnostic> = []
    if let Some(parent) = heritage {
      write(buf, " extends ")
      diags = self.expression(buf, parent.parent.*, ind)
    }
    diags = merge_diags(diags, self.class_body(buf, body, ind + indent_step()))
    if is_expression { write(buf, ")") }
    diags
  }

  fn class_body(self, buf: Ref<strings.Builder>, body: ClassBody, ind: string) -> Slice<Diagnostic> {
    write(buf, " {\n")
    let mut diags: Slice<Diagnostic> = []
    for member in body.members {
      match member {
        Method(method) => diags = merge_diags(
          diags,
          self.class_method(buf, method, ind),
        ),
        Field(field) => diags = merge_diags(
          diags,
          self.field_definition(buf, field, ind),
        ),
        StaticBlock(static_block) => diags = merge_diags(
          diags,
          self.static_block(buf, static_block, ind),
        ),
      }
      write(buf, "\n")
    }
    write(buf, "}\n")
    diags
  }

  fn class_method(
    self,
    buf: Ref<strings.Builder>,
    method: MethodDefinition,
    ind: string,
  ) -> Slice<Diagnostic> {
    let mut keywords: Slice<string> = []
    if method.is_static { keywords = keywords.append("static") }
    let mut is_generator = false
    if let Some(accessor) = method.accessor {
      match accessor {
        Get => keywords = keywords.append("get"),
        Set => keywords = keywords.append("set"),
        Generator => is_generator = true,
      }
    }
    if method.is_async { keywords = keywords.append("async") }
    if is_generator { keywords = keywords.append("*") }
    write(buf, ind)
    write(buf, strings.Join(keywords, " "))
    write(buf, " ")
    let mut diags = self.property_name(buf, method.name, ind)
    write(buf, "(")
    diags = merge_diags(
      diags,
      self.formal_parameters(buf, method.parameters, ind),
    )
    write(buf, ")\n")
    let mut inner = &self
    let mut dispatch_state = ReceiverState { .. }
    inner.receivers = Some(&dispatch_state)
    inner.locals = function_scope_locals(
      self.locals,
      None,
      method.parameters,
      method.body,
    )
    merge_diags(
      diags,
      inner.block(buf, method.body, ind + indent_step(), false, false, true),
    )
  }

  fn field_definition(
    self,
    buf: Ref<strings.Builder>,
    field: FieldDefinition,
    ind: string,
  ) -> Slice<Diagnostic> {
    write(buf, ind)
    if field.is_static { write(buf, "static ") }
    let mut diags = self.property_name(buf, field.property, ind)
    if let Some(initializer) = field.initializer {
      write(buf, " = ")
      diags = merge_diags(diags, self.expression(buf, initializer.value.*, ind))
    }
    write(buf, ";")
    diags
  }

  fn static_block(
    self,
    buf: Ref<strings.Builder>,
    static_block: ClassStaticBlock,
    ind: string,
  ) -> Slice<Diagnostic> {
    write(buf, ind + "static{")
    let mut diags: Slice<Diagnostic> = []
    for st in static_block.body.body {
      diags = merge_diags(diags, self.statement(buf, st, ind, false))
    }
    write(buf, "}")
    diags
  }

  fn es_import(self, buf: Ref<strings.Builder>, st: ImportStatement) -> Slice<Diagnostic> {
    write(buf, "import ")
    let mut diags: Slice<Diagnostic> = []
    if let Some(clause) = st.clause {
      match clause {
        Namespace(namespace) => write(buf, f"* as {namespace.alias.text}"),
        Named(named) => diags = self.named_imports(buf, named),
        Default(default) => {
          write(buf, default.name.text)
          if let Some(extra) = default.extra {
            write(buf, ", ")
            match extra {
              Namespace(namespace) => write(buf, f"* as {namespace.alias.text}"),
              Named(named) => diags = merge_diags(
                diags,
                self.named_imports(buf, named),
              ),
            }
          }
        },
      }
      write(buf, " from ")
    }
    write(buf, st.source.text)
    write(buf, "\n")
    if let Some(attribute) = st.attribute {
      diags = merge_diags(diags, [
        diag_warn_at(
          BuildPhase.Compile,
          "codegen: import attribute deferred -- no legacy emitter",
          self.file,
          attribute.pos.row,
          attribute.pos.col,
        ),
      ])
    }
    diags
  }

  fn named_imports(self, buf: Ref<strings.Builder>, named: NamedImports) -> Slice<Diagnostic> {
    write(buf, "{")
    let mut first = true
    for specifier in named.specifiers {
      if !first { write(buf, ", ") }
      write(buf, module_export_name_text(specifier.name))
      if let Some(alias) = specifier.alias { write(buf, f" as {alias.text}") }
      first = false
    }
    write(buf, "}")
    []
  }

  fn es_export(
    self,
    buf: Ref<strings.Builder>,
    st: ExportStatement,
    ind: string,
  ) -> Slice<Diagnostic> {
    match st {
      All(all) => {
        write(buf, f"export *  from {all.source.text}\n")
        []
      },
      Namespace(namespace) => {
        let name = module_export_name_text(namespace.name)
        write(buf, f"export * as {name} from {namespace.source.text}\n")
        []
      },
      Named(named) => {
        write(buf, "export {")
        let mut first = true
        for specifier in named.clause.specifiers {
          if !first { write(buf, ", ") }
          write(buf, module_export_name_text(specifier.name))
          if let Some(alias) = specifier.alias {
            write(buf, f" as {module_export_name_text(alias)}")
          }
          first = false
        }
        write(buf, "}")
        if let Some(source) = named.source {
          write(buf, f" from {source.text}")
        }
        write(buf, "\n")
        []
      },
      Declaration(declaration) => {
        write(buf, "export ")
        self.declaration(buf, declaration, ind)
      },
      DefaultDeclaration(declaration) => {
        write(buf, "export default ")
        self.declaration(buf, declaration, ind)
      },
      DefaultValue(e) => {
        write(buf, "export default ")
        self.expression(buf, e, ind)
      },
    }
  }

  fn objj_import(self, buf: Ref<strings.Builder>, st: ObjjImport) -> Slice<Diagnostic> {
    match st.path {
      System(lib) => {
        let length = lib.text.length()
        let inner = if length > 2 {
          lib.text.substring(1..length - 1)
        } else {
          ""
        }
        write(buf, "objj_executeFile(\"" + inner + "\", NO);")
      },
      Local(literal) => {
        let inner = string_literal_inner(literal)
        write(buf, "objj_executeFile(\"" + inner + "\", YES);")
      },
    }
    []
  }

  fn expressions(
    self,
    buf: Ref<strings.Builder>,
    exprs: Expressions,
    ind: string,
  ) -> Slice<Diagnostic> {
    match exprs {
      Single(e) => self.expression(buf, e, ind),
      Sequence(sequence) => self.sequence(buf, sequence, ind),
    }
  }

  fn sequence(
    self,
    buf: Ref<strings.Builder>,
    sequence: SequenceExpression,
    ind: string,
  ) -> Slice<Diagnostic> {
    write(buf, "(")
    let mut diags: Slice<Diagnostic> = []
    let mut first = true
    for item in sequence.items {
      if !first { write(buf, ", ") }
      diags = merge_diags(diags, self.expression(buf, item, ind))
      first = false
    }
    write(buf, ")")
    diags
  }

  fn expression(self, buf: Ref<strings.Builder>, e: Expression, ind: string) -> Slice<Diagnostic> {
    match e {
      Primary(primary) => self.primary(buf, primary, ind),
      Assignment(assignment) => self.assignment(buf, assignment, ind),
      AugmentedAssignment(augmented) => self.augmented_assignment(
        buf,
        augmented,
        ind,
      ),
      Await(await_expr) => {
        write(buf, "await (")
        let diags = self.expression(buf, await_expr.argument.*, ind)
        write(buf, ")")
        diags
      },
      Unary(unary) => {
        write(buf, unary_op_text(unary.operator))
        if unary_op_is_word(unary.operator) { write(buf, " ") }
        self.operand(buf, 4, 0, false, unary.argument.*, false, ind)
      },
      Binary(binary) => self.binary(buf, binary, ind),
      Ternary(ternary) => {
        let mut diags = self.operand(
          buf,
          7,
          0,
          false,
          ternary.condition.*,
          false,
          ind,
        )
        write(buf, " ? ")
        diags = merge_diags(
          diags,
          self.expression(buf, ternary.consequence.*, ind),
        )
        write(buf, " : ")
        merge_diags(diags, self.expression(buf, ternary.alternative.*, ind))
      },
      Update(update) => {
        if let Some(deref) = expression_as_deref(update.argument.*) {
          self.deref_update(buf, deref, update.operator, update.is_prefix, ind)
        } else if update.is_prefix {
          write(buf, update_op_text(update.operator))
          self.operand(buf, 4, 0, false, update.argument.*, false, ind)
        } else {
          let diags = self.operand(
            buf,
            4,
            0,
            false,
            update.argument.*,
            false,
            ind,
          )
          write(buf, update_op_text(update.operator))
          diags
        }
      },
      New(new_expr) => self.new_expression(buf, new_expr, ind),
      Yield(yield_expr) => {
        write(buf, "yield")
        if yield_expr.is_delegate { write(buf, "*") }
        if let Some(argument) = yield_expr.argument {
          write(buf, " ")
          self.expression(buf, argument.*, ind)
        } else {
          []
        }
      },
    }
  }

  fn operand(
    self,
    buf: Ref<strings.Builder>,
    parent_prec: int,
    parent_t: int,
    parent_is_operator: bool,
    e: Expression,
    is_right: bool,
    ind: string,
  ) -> Slice<Diagnostic> {
    if operand_needs_parens(
      parent_prec,
      parent_t,
      parent_is_operator,
      e,
      is_right,
    ) {
      self.wrapped(buf, e, ind)
    } else {
      self.expression(buf, e, ind)
    }
  }

  fn wrapped(self, buf: Ref<strings.Builder>, e: Expression, ind: string) -> Slice<Diagnostic> {
    write(buf, "(")
    let diags = self.expression(buf, e, ind)
    write(buf, ")")
    diags
  }

  fn binary(
    self,
    buf: Ref<strings.Builder>,
    binary: BinaryExpression,
    ind: string,
  ) -> Slice<Diagnostic> {
    let parent_prec = if binary_op_is_logical(binary.operator) { 6 } else { 5 }
    let parent_t = binary_op_t(binary.operator)
    let nullish = match binary.operator {
      NullishCoalesce => true,
      _ => false,
    }
    let exponent = match binary.operator {
      Exp => true,
      _ => false,
    }
    let mut diags: Slice<Diagnostic> = []
    match binary.left {
      PrivateProperty(private) => write(buf, f"#{private.text}"),
      Expression(left) => {
        let left_is_arrow = match left.* {
          Primary(Arrow(_)) => true,
          _ => false,
        }
        if nullish || exponent || left_is_arrow {
          diags = self.wrapped(buf, left.*, ind)
        } else {
          diags = self.operand(
            buf,
            parent_prec,
            parent_t,
            true,
            left.*,
            false,
            ind,
          )
        }
      },
    }
    write(buf, f" {binary_op_text(binary.operator)} ")
    if nullish {
      merge_diags(diags, self.wrapped(buf, binary.right.*, ind))
    } else {
      merge_diags(
        diags,
        self.operand(
          buf,
          parent_prec,
          parent_t,
          true,
          binary.right.*,
          true,
          ind,
        ),
      )
    }
  }

  fn assignment(
    self,
    buf: Ref<strings.Builder>,
    assignment: AssignmentExpression,
    ind: string,
  ) -> Slice<Diagnostic> {
    match assignment {
      Standard(standard) => {
        let diags = self.assignment_target(buf, standard.left, ind)
        write(buf, " = ")
        merge_diags(
          diags,
          self.operand(buf, 8, 0, false, standard.right.*, true, ind),
        )
      },
      ObjjDeref(deref) => {
        write(buf, "(")
        let mut diags = self.expression(buf, deref.left.argument.*, ind)
        write(buf, ")(")
        if deref.operator == AssignmentOp.Assign {
          diags = merge_diags(diags, self.expression(buf, deref.right.*, ind))
        } else {
          diags = merge_diags(
            diags,
            self.expression(buf, deref.left.argument.*, ind),
          )
          write(buf, "() " + assignment_op_char(deref.operator) + " ")
          diags = merge_diags(diags, self.expression(buf, deref.right.*, ind))
        }
        write(buf, ")")
        diags
      },
    }
  }

  fn assignment_target(
    self,
    buf: Ref<strings.Builder>,
    target: AssignmentTarget,
    ind: string,
  ) -> Slice<Diagnostic> {
    match target {
      Parenthesized(parenthesized) => self.parenthesized(
        buf,
        parenthesized.*,
        ind,
      ),
      Lhs(lhs) => self.lhs_expression_value(buf, lhs.*, ind),
    }
  }

  fn lhs_expression_value(
    self,
    buf: Ref<strings.Builder>,
    lhs: LhsExpression,
    ind: string,
  ) -> Slice<Diagnostic> {
    match lhs {
      Identifier(identifier) => self.identifier(buf, identifier),
      _ => self.lhs_expression(buf, lhs, ind),
    }
  }

  fn identifier(self, buf: Ref<strings.Builder>, identifier: Identifier) -> Slice<Diagnostic> {
    if self.in_instance_method && !reserved_identifier(identifier.text) &&
    !self.is_local(identifier.text) {
      if let Some(context) = self.current_class {
        if context.ivars[identifier.text] {
          write(buf, f"self.{identifier.text}")
          return []
        }
      }
    }
    write(buf, identifier.text)
    []
  }

  fn is_local(self, name: string) -> bool {
    for local in self.locals {
      if local == name { return true }
    }
    false
  }

  fn augmented_assignment(
    self,
    buf: Ref<strings.Builder>,
    augmented: AugmentedAssignmentExpression,
    ind: string,
  ) -> Slice<Diagnostic> {
    let diags = match augmented.left {
      Member(member) => self.member(buf, member.*, ind),
      Subscript(subscript) => self.subscript(buf, subscript.*, ind),
      Identifier(identifier) => self.identifier(buf, identifier),
      Parenthesized(parenthesized) => self.parenthesized(
        buf,
        parenthesized.*,
        ind,
      ),
    }
    write(buf, f" {augmented_op_text(augmented.operator)} ")
    merge_diags(
      diags,
      self.operand(buf, 8, 0, false, augmented.right.*, true, ind),
    )
  }

  fn new_expression(
    self,
    buf: Ref<strings.Builder>,
    new_expr: NewExpression,
    ind: string,
  ) -> Slice<Diagnostic> {
    write(buf, "new ")
    let mut diags: Slice<Diagnostic> = []
    match new_expr.constructor {
      Primary(primary) => {
        if 1 < primary_prec(primary.*) {
          write(buf, "(")
          diags = self.primary(buf, primary.*, ind)
          write(buf, ")")
        } else {
          diags = self.primary(buf, primary.*, ind)
        }
      },
      New(nested) => diags = self.new_expression(buf, nested.*, ind),
    }
    write(buf, "(")
    if let Some(arguments) = new_expr.arguments {
      diags = merge_diags(diags, self.arguments(buf, arguments, ind))
    }
    write(buf, ")")
    diags
  }

  fn primary(
    self,
    buf: Ref<strings.Builder>,
    primary: PrimaryExpression,
    ind: string,
  ) -> Slice<Diagnostic> {
    match primary {
      Subscript(subscript) => self.subscript(buf, subscript, ind),
      Member(member) => self.member(buf, member, ind),
      Parenthesized(parenthesized) => self.parenthesized(
        buf,
        parenthesized,
        ind,
      ),
      Identifier(identifier) => self.identifier(buf, identifier),
      Undefined(_) => {
        write(buf, "undefined")
        []
      },
      This(_) => {
        write(buf, "this")
        []
      },
      Super(_) => {
        write(buf, "super")
        []
      },
      Number(number) => {
        write(buf, number.text)
        []
      },
      String(literal) => {
        write(buf, literal.text)
        []
      },
      Template(template) => self.template(buf, template, ind),
      Regex(regex) => {
        let flags = regex.flags.map_or("", |regex_flags| regex_flags.text)
        write(buf, f"/{regex.pattern.text}/{flags}")
        []
      },
      True(_) => {
        write(buf, "true")
        []
      },
      False(_) => {
        write(buf, "false")
        []
      },
      Null(_) => {
        write(buf, "null")
        []
      },
      Object(object) => self.object_literal(buf, object, ind),
      Function(function) => self.function_like(
        buf,
        ind,
        function.name,
        function.is_async,
        false,
        function.parameters,
        function.body,
        false,
      ),
      Arrow(arrow) => self.arrow(buf, arrow, ind),
      Generator(generator) => self.function_like(
        buf,
        ind,
        generator.name,
        generator.is_async,
        true,
        generator.parameters,
        generator.body,
        false,
      ),
      Class(class) => self.class_like(
        buf,
        class.name,
        class.heritage,
        class.body,
        ind,
        true,
      ),
      MetaProperty(meta) => match meta {
        NewTarget(_) => {
          write(buf, "new.target")
          []
        },
        ImportMeta(_) => {
          write(buf, "import.meta")
          []
        },
      },
      Call(call) => self.call(buf, call, ind),
      NativeArray(array) => self.array_literal(buf, array, ind),
      ObjjDictionary(dictionary) => self.objj_dictionary(buf, dictionary, ind),
      ObjjArray(array_literal) => self.objj_array(buf, array_literal, ind),
      ObjjString(literal) => {
        write(buf, literal.value.text)
        []
      },
      ObjjSelector(selector) => {
        write(buf, "sel_getUid(\"" + selector.name.selector_string() + "\")")
        []
      },
      ObjjProtocol(protocol) => {
        write(buf, "objj_getProtocol(\"" + protocol.protocol.text + "\")")
        []
      },
      ObjjMessage(message) => self.objj_message(buf, message, ind),
      ObjjRef(reference) => {
        write(buf, "function(__input) { if (arguments.length) return ")
        let diags = self.expression(buf, reference.argument.*, ind)
        write(buf, " = __input; return ")
        let diags2 = self.expression(buf, reference.argument.*, ind)
        write(buf, "; }")
        merge_diags(diags, diags2)
      },
      ObjjDeref(dereference) => {
        let diags = self.expression(buf, dereference.argument.*, ind)
        write(buf, "()")
        diags
      },
    }
  }

  fn subscript(
    self,
    buf: Ref<strings.Builder>,
    subscript: SubscriptExpression,
    ind: string,
  ) -> Slice<Diagnostic> {
    let diags = self.operand(buf, 1, 0, false, subscript.object.*, false, ind)
    let bracket = if subscript.optional_chain { "?.[" } else { "[" }
    write(buf, bracket)
    let diags2 = self.expressions(buf, subscript.index.*, ind)
    write(buf, "]")
    merge_diags(diags, diags2)
  }

  fn member(
    self,
    buf: Ref<strings.Builder>,
    member: MemberExpression,
    ind: string,
  ) -> Slice<Diagnostic> {
    let diags = match member.object {
      Expression(object) => self.operand(buf, 1, 0, false, object.*, false, ind),
      Import(_) => {
        write(buf, "import")
        []
      },
    }
    let accessor = if member.optional_chain { "?." } else { "." }
    write(buf, accessor)
    match member.property {
      Private(private) => write(buf, f"#{private.text}"),
      Property(identifier) => write(buf, identifier.text),
    }
    diags
  }

  fn parenthesized(
    self,
    buf: Ref<strings.Builder>,
    parenthesized: ParenthesizedExpression,
    ind: string,
  ) -> Slice<Diagnostic> {
    write(buf, "(")
    let diags = self.expressions(buf, parenthesized.expression.*, ind)
    write(buf, ")")
    diags
  }

  fn template(
    self,
    buf: Ref<strings.Builder>,
    template: TemplateString,
    ind: string,
  ) -> Slice<Diagnostic> {
    write(buf, "`")
    let mut diags: Slice<Diagnostic> = []
    for part in template.parts {
      match part {
        Fragment(fragment) => write(buf, fragment.text),
        Escape(escape) => write(buf, escape.text),
        Substitution(substitution) => {
          write(buf, "${")
          diags = merge_diags(
            diags,
            self.expressions(buf, substitution.expression, ind),
          )
          write(buf, "}")
        },
      }
    }
    write(buf, "`")
    diags
  }

  fn object_literal(
    self,
    buf: Ref<strings.Builder>,
    object: Object,
    ind: string,
  ) -> Slice<Diagnostic> {
    write(buf, "{")
    let mut diags: Slice<Diagnostic> = []
    let mut first = true
    for member in object.members {
      if !first { write(buf, ", ") }
      match member {
        Pair(pair) => {
          diags = merge_diags(diags, self.property_name(buf, pair.key, ind))
          write(buf, ": ")
          diags = merge_diags(diags, self.expression(buf, pair.value.*, ind))
        },
        Spread(spread) => {
          write(buf, "...")
          diags = merge_diags(
            diags,
            self.expression(buf, spread.argument.*, ind),
          )
        },
        Method(method) => diags = merge_diags(
          diags,
          self.object_method(buf, method, ind),
        ),
        Shorthand(identifier) => write(buf, identifier.text),
      }
      first = false
    }
    write(buf, "}")
    diags
  }

  fn object_method(
    self,
    buf: Ref<strings.Builder>,
    method: MethodDefinition,
    ind: string,
  ) -> Slice<Diagnostic> {
    let mut prefix = " "
    let mut is_generator = false
    if let Some(accessor) = method.accessor {
      match accessor {
        Get => prefix = "get ",
        Set => prefix = "set ",
        Generator => is_generator = true,
      }
    }
    let mut keywords: Slice<string> = []
    if method.is_async { keywords = keywords.append("async") }
    if is_generator { keywords = keywords.append("*") }
    write(buf, prefix + ind)
    write(buf, strings.Join(keywords, " "))
    write(buf, " ")
    let mut diags = self.property_name(buf, method.name, ind)
    write(buf, "(")
    diags = merge_diags(
      diags,
      self.formal_parameters(buf, method.parameters, ind),
    )
    write(buf, ")\n")
    let mut inner = &self
    let mut dispatch_state = ReceiverState { .. }
    inner.receivers = Some(&dispatch_state)
    inner.locals = function_scope_locals(
      self.locals,
      None,
      method.parameters,
      method.body,
    )
    merge_diags(
      diags,
      inner.block(buf, method.body, ind + indent_step(), false, false, true),
    )
  }

  fn property_name(
    self,
    buf: Ref<strings.Builder>,
    name: PropertyName,
    ind: string,
  ) -> Slice<Diagnostic> {
    match name {
      Identifier(identifier) => {
        write(buf, identifier.text)
        []
      },
      Private(private) => {
        write(buf, f"#{private.text}")
        []
      },
      String(literal) => {
        write(buf, literal.text)
        []
      },
      Number(number) => {
        write(buf, number.text)
        []
      },
      Computed(computed) => {
        write(buf, "[")
        let diags = self.expression(buf, computed.expression.*, ind)
        write(buf, "]")
        diags
      },
      ObjjString(literal) => self.deferred(
        "@\"...\" property name",
        "tier D",
        literal.pos,
      ),
    }
  }

  fn array_literal(
    self,
    buf: Ref<strings.Builder>,
    array: NativeArray,
    ind: string,
  ) -> Slice<Diagnostic> {
    write(buf, "[")
    let mut diags: Slice<Diagnostic> = []
    let mut first = true
    for element in array.elements {
      if !first { write(buf, ", ") }
      match element {
        Expression(e) => diags = merge_diags(
          diags,
          self.expression(buf, e.*, ind),
        ),
        Spread(spread) => {
          write(buf, "...")
          diags = merge_diags(
            diags,
            self.expression(buf, spread.argument.*, ind),
          )
        },
      }
      first = false
    }
    write(buf, "]")
    diags
  }

  fn arrow(self, buf: Ref<strings.Builder>, arrow: ArrowFunction, ind: string) -> Slice<Diagnostic> {
    if arrow.is_async { write(buf, "async ") }
    let mut diags: Slice<Diagnostic> = []
    match arrow.parameters {
      Single(identifier) => write(buf, identifier.text),
      List(parameters) => {
        let bare = parameters.parameters.length() == 1 &&
        formal_parameter_is_plain_identifier(parameters.parameters[0])
        if bare {
          diags = self.formal_parameters(buf, parameters, ind)
        } else {
          write(buf, "(")
          diags = self.formal_parameters(buf, parameters, ind)
          write(buf, ")")
        }
      },
    }
    write(buf, " => ")
    let mut inner = &self
    let mut dispatch_state = ReceiverState { .. }
    inner.receivers = Some(&dispatch_state)
    inner.locals = arrow_scope_locals(self.locals, arrow.parameters, arrow.body)
    match arrow.body {
      Expression(e) => {
        if arrow_body_needs_parens(e.*) {
          merge_diags(diags, inner.wrapped(buf, e.*, ind))
        } else {
          merge_diags(diags, inner.expression(buf, e.*, ind))
        }
      },
      Block(block) => merge_diags(
        diags,
        inner.block(buf, block, ind + indent_step(), true, false, true),
      ),
    }
  }

  fn call(self, buf: Ref<strings.Builder>, call: CallExpression, ind: string) -> Slice<Diagnostic> {
    match call {
      Call(plain) => {
        let mut diags = match plain.callee {
          Expression(callee) => self.operand(
            buf,
            1,
            0,
            false,
            callee.*,
            false,
            ind,
          ),
          Import(_) => {
            write(buf, "import")
            []
          },
        }
        write(buf, "(")
        diags = merge_diags(diags, self.arguments(buf, plain.arguments, ind))
        write(buf, ")")
        diags
      },
      OptionalCall(optional) => {
        let mut diags: Slice<Diagnostic> = []
        if 1 < primary_prec(optional.callee.*) {
          write(buf, "(")
          diags = self.primary(buf, optional.callee.*, ind)
          write(buf, ")")
        } else {
          diags = self.primary(buf, optional.callee.*, ind)
        }
        write(buf, "?.(")
        diags = merge_diags(diags, self.arguments(buf, optional.arguments, ind))
        write(buf, ")")
        diags
      },
      TemplateCall(template_call) => {
        let diags = match template_call.callee {
          Primary(callee) => self.primary(buf, callee.*, ind),
          New(callee) => self.new_expression(buf, callee.*, ind),
        }
        merge_diags(diags, self.template(buf, template_call.arguments, ind))
      },
    }
  }

  fn arguments(
    self,
    buf: Ref<strings.Builder>,
    arguments: Arguments,
    ind: string,
  ) -> Slice<Diagnostic> {
    let mut diags: Slice<Diagnostic> = []
    let mut first = true
    for item in arguments.items {
      if !first { write(buf, ", ") }
      match item {
        Expression(e) => diags = merge_diags(
          diags,
          self.expression(buf, e.*, ind),
        ),
        Spread(spread) => {
          write(buf, "...")
          diags = merge_diags(
            diags,
            self.expression(buf, spread.argument.*, ind),
          )
        },
      }
      first = false
    }
    diags
  }

  fn lhs_expression(
    self,
    buf: Ref<strings.Builder>,
    lhs: LhsExpression,
    ind: string,
  ) -> Slice<Diagnostic> {
    match lhs {
      Member(member) => self.member(buf, member.*, ind),
      Subscript(subscript) => self.subscript(buf, subscript.*, ind),
      Identifier(identifier) => {
        write(buf, identifier.text)
        []
      },
      Undefined(_) => {
        write(buf, "undefined")
        []
      },
      Destructuring(pattern) => self.destructuring(buf, pattern.*, ind),
    }
  }

  fn pattern(self, buf: Ref<strings.Builder>, pattern: Pattern, ind: string) -> Slice<Diagnostic> {
    match pattern {
      Lhs(lhs) => self.lhs_expression(buf, lhs, ind),
      Rest(rest) => {
        write(buf, "...")
        self.lhs_expression(buf, rest.argument.*, ind)
      },
    }
  }

  fn assignment_pattern(
    self,
    buf: Ref<strings.Builder>,
    pattern: AssignmentPattern,
    ind: string,
  ) -> Slice<Diagnostic> {
    let diags = self.pattern(buf, pattern.left.*, ind)
    write(buf, " = ")
    merge_diags(diags, self.expression(buf, pattern.right.*, ind))
  }

  fn destructuring(
    self,
    buf: Ref<strings.Builder>,
    pattern: DestructuringPattern,
    ind: string,
  ) -> Slice<Diagnostic> {
    match pattern {
      Object(object) => self.object_pattern(buf, object, ind),
      Array(array) => self.array_pattern(buf, array, ind),
    }
  }

  fn object_pattern(
    self,
    buf: Ref<strings.Builder>,
    pattern: ObjectPattern,
    ind: string,
  ) -> Slice<Diagnostic> {
    write(buf, "{")
    let mut diags: Slice<Diagnostic> = []
    let mut first = true
    for member in pattern.members {
      if !first { write(buf, ", ") }
      match member {
        Pair(pair) => {
          diags = merge_diags(diags, self.property_name(buf, pair.key, ind))
          write(buf, ": ")
          match pair.value {
            Pattern(value) => diags = merge_diags(
              diags,
              self.pattern(buf, value.*, ind),
            ),
            Assignment(value) => diags = merge_diags(
              diags,
              self.assignment_pattern(buf, value.*, ind),
            ),
          }
        },
        Rest(rest) => {
          write(buf, "...")
          diags = merge_diags(
            diags,
            self.lhs_expression(buf, rest.argument.*, ind),
          )
        },
        Assignment(assignment) => {
          match assignment.left {
            Shorthand(identifier) => write(buf, identifier.text),
            Destructuring(nested) => diags = merge_diags(
              diags,
              self.destructuring(buf, nested.*, ind),
            ),
          }
          write(buf, " = ")
          diags = merge_diags(
            diags,
            self.expression(buf, assignment.right.*, ind),
          )
        },
        Shorthand(identifier) => write(buf, identifier.text),
      }
      first = false
    }
    write(buf, "}")
    diags
  }

  fn array_pattern(
    self,
    buf: Ref<strings.Builder>,
    pattern: ArrayPattern,
    ind: string,
  ) -> Slice<Diagnostic> {
    write(buf, "[")
    let mut diags: Slice<Diagnostic> = []
    let mut first = true
    for element in pattern.elements {
      if !first { write(buf, ", ") }
      match element {
        Pattern(value) => diags = merge_diags(
          diags,
          self.pattern(buf, value.*, ind),
        ),
        Assignment(value) => diags = merge_diags(
          diags,
          self.assignment_pattern(buf, value.*, ind),
        ),
      }
      first = false
    }
    write(buf, "]")
    diags
  }

  fn objj_class_implementation(
    self,
    buf: Ref<strings.Builder>,
    implementation: ObjjClassImplementation,
  ) -> Slice<Diagnostic> {
    let class_name = implementation.name.text
    let p = JsPrint {
      current_class: Some(
        ClassContext {
          name: class_name,
          ivars: self.class_ivar_universe(implementation),
        },
      ),
      ..self,
    }
    let mut diags: Slice<Diagnostic> = []

    match implementation.category {
      Some(_) => {
        write(buf, "{\nvar the_class = objj_getClass(\"" + class_name + "\")\n")
        write(
          buf,
          "if(!the_class) throw new SyntaxError(\"*** Could not find definition for class \\\"" +
          class_name +
          "\\\"\");\n",
        )
        write(buf, "var meta_class = the_class.isa;")
      },
      None => match implementation.superclass {
        Some(superclass) => {
          write(
            buf,
            "\n{var the_class = objj_allocateClassPair(" + superclass.text +
            ", \"" +
            class_name +
            "\"),\nmeta_class = the_class.isa;",
          )
        },
        None => {
          write(
            buf,
            "{var the_class = objj_allocateClassPair(Nil, \"" + class_name +
            "\"),\nmeta_class = the_class.isa;",
          )
        },
      },
    }

    if let Some(list) = implementation.protocols {
      for protocol in list.protocols {
        write(
          buf,
          "\nvar aProtocol = objj_getProtocol(\"" + protocol.text + "\");",
        )
        write(
          buf,
          "\nif (!aProtocol) throw new SyntaxError(\"*** Could not find definition for protocol \\\"" +
          protocol.text +
          "\\\"\");",
        )
        write(buf, "\nclass_addProtocol(the_class, aProtocol);")
      }
    }

    let mut occupied = Map.new<string, bool>()
    for member in implementation.members {
      if let ObjjImplementationMember.Method(method) = member {
        if method.scope == ObjjMethodScope.Instance {
          occupied[method.selector.selector_string()] = true
        }
      }
    }

    let mut im_buf = strings.Builder { .. }
    let mut im_diags: Slice<Diagnostic> = []
    let mut im_any = false
    let mut cm_buf = strings.Builder { .. }
    let mut cm_diags: Slice<Diagnostic> = []
    let mut cm_any = false
    let mut first_ivar = true

    if let Some(instance_variables) = implementation.ivars {
      for member in instance_variables.members {
        match member {
          Variable(variable) => {
            if let ObjjInstanceVariable.Field(field) = variable {
              if first_ivar {
                write(buf, "class_addIvars(the_class, [")
              } else {
                write(buf, ", ")
              }
              first_ivar = false
              let type_name = codegen_type(field.field_type)
              write(
                buf,
                "new objj_ivar(\"" + field.name.text + "\", \"" + type_name +
                "\")",
              )
              let synth_diags = p.synthesized_accessor_entries(
                &im_buf,
                field,
                class_name,
                type_name,
                occupied,
                im_any,
              )
              if im_buf.Len() > 0 { im_any = true }
              im_diags = merge_diags(im_diags, synth_diags)
            }
          },
          PreprocIf(preproc) => diags = merge_diags(
            diags,
            self.deferred(
              "#if block among ivars",
              "build-feature environment (PHASE-8-BRIEF.md decision 4)",
              preproc.pos,
            ),
          ),
        }
      }
    }
    if !first_ivar { write(buf, "]);") }

    for member in implementation.members {
      match member {
        Method(method) => {
          match method.scope {
            Instance => {
              if im_any { let _ = im_buf.WriteString(", ") }
              im_diags = merge_diags(
                im_diags,
                p.objj_method_entry(&im_buf, method, class_name),
              )
              im_any = true
            },
            Class => {
              if cm_any { let _ = cm_buf.WriteString(", ") }
              cm_diags = merge_diags(
                cm_diags,
                p.objj_method_entry(&cm_buf, method, class_name),
              )
              cm_any = true
            },
          }
        },
        Global(_) => (),
        Empty(_) => write(buf, ";\n"),
        Variable(variable) => diags = merge_diags(
          diags,
          p.variable_declaration(buf, "var", variable.declarators, ""),
        ),
        Function(function) => diags = merge_diags(
          diags,
          p.function_like(
            buf,
            "",
            Some(function.name),
            function.is_async,
            false,
            function.parameters,
            function.body,
            true,
          ),
        ),
        GeneratorFunction(generator) => diags = merge_diags(
          diags,
          p.function_like(
            buf,
            "",
            Some(generator.name),
            generator.is_async,
            true,
            generator.parameters,
            generator.body,
            true,
          ),
        ),
        PreprocDirective(directive) => diags = merge_diags(
          diags,
          self.deferred(
            "#preproc directive in implementation",
            "build-feature environment (PHASE-8-BRIEF.md decision 4)",
            directive.pos,
          ),
        ),
      }
    }

    if implementation.category.is_none() {
      write(buf, "objj_registerClassPair(the_class);\n")
    }
    if im_any {
      write(buf, "class_addMethods(the_class, [")
      write(buf, im_buf.String())
      write(buf, "]);\n")
      diags = merge_diags(diags, im_diags)
    }
    if cm_any {
      write(buf, "class_addMethods(meta_class, [")
      write(buf, cm_buf.String())
      write(buf, "]);\n")
      diags = merge_diags(diags, cm_diags)
    }
    write(buf, "}\n")
    diags
  }

  fn class_ivar_universe(self, implementation: ObjjClassImplementation) -> Map<string, bool> {
    let mut ivars = Map.new<string, bool>()
    if let Some(instance_variables) = implementation.ivars {
      for member in instance_variables.members {
        if let ObjjIvarMember.Variable(ObjjInstanceVariable.Field(field)) = member {
          ivars[field.name.text] = true
        }
      }
    }
    let Some(table) = self.symbols else {
      return ivars
    }
    let mut current = implementation.superclass.map_or(
      "",
      |identifier| identifier.text,
    )
    for _ in 0..64 {
      if current.is_empty() { break }
      let mut found = false
      let mut next = ""
      for class_symbol in table.classes {
        if class_symbol.name != current { continue }
        if class_symbol.category.is_some() { continue }
        found = true
        for ivar in class_symbol.ivars {
          ivars[ivar.name] = true
        }
        next = class_symbol.superclass.unwrap_or("")
        break
      }
      if !found { break }
      current = next
    }
    ivars
  }

  // synthesized_accessor_entries writes the getter (and setter unless
  // readonly) objj_method entries for one @accessors directive directly
  // into im_buf.  Naming reuses phase 6's rules; an explicit method with
  // the same selector wins silently.  The copy setter variant embeds a
  // message send and is deferred with tier C.
  fn synthesized_accessor_entries(
    self,
    im_buf: Ref<strings.Builder>,
    field: ObjjFieldDefinition,
    class_name: string,
    type_name: string,
    mut occupied: Map<string, bool>,
    mut any: bool,
  ) -> Slice<Diagnostic> {
    let Some(directive) = field.accessors else {
      return []
    }
    let mut property = field.name.text
    let mut getter = ""
    let mut setter = ""
    let mut readonly = false
    let mut copy = false
    for attribute in directive.attributes {
      match attribute {
        KeyValue(pair) => {
          let value = accessor_name_string(pair.value)
          if pair.key.text == "property" { property = value }
          if pair.key.text == "getter" { getter = value }
          if pair.key.text == "setter" { setter = value }
        },
        Flag(flag) => {
          if flag.text == "readonly" { readonly = true }
          if flag.text == "copy" { copy = true }
        },
      }
    }
    if getter.is_empty() { getter = property }
    if setter.is_empty() { setter = default_setter_selector(property) }

    if !occupied[getter] {
      occupied[getter] = true
      if any { let _ = im_buf.WriteString(", ") }
      any = true
      let _ = im_buf.WriteString(
        "new objj_method(sel_getUid(\"" + getter + "\"), function $" +
        class_name +
        "__" +
        getter +
        "(self, _cmd)\n",
      )
      let _ = im_buf.WriteString(
        "{\n    return self." + field.name.text + ";\n}\n\n",
      )
      let _ = im_buf.WriteString(",[\"" + type_name + "\"])")
    }
    if readonly { return [] }
    if occupied[setter] { return [] }
    occupied[setter] = true
    if copy {
      return [
        diag_warn_at(
          BuildPhase.Compile,
          "codegen: @accessors(copy) setter deferred pending tier C dispatch",
          self.file,
          field.pos.row,
          field.pos.col,
        ),
      ]
    }
    if any { let _ = im_buf.WriteString(", ") }
    let mangled = strings.ReplaceAll(setter, ":", "_")
    let _ = im_buf.WriteString(
      "new objj_method(sel_getUid(\"" + setter + "\"), function $" + class_name +
      "__" +
      mangled +
      "(self, _cmd, newValue)\n",
    )
    let _ = im_buf.WriteString(
      "{\n    self." + field.name.text + " = newValue;\n}\n\n",
    )
    let _ = im_buf.WriteString(",[\"void\",\"" + type_name + "\"])")
    []
  }

  fn objj_method_entry(
    self,
    buf: Ref<strings.Builder>,
    method: ObjjMethodDefinition,
    class_name: string,
  ) -> Slice<Diagnostic> {
    let selector = method.selector.selector_string()
    let mut types: Slice<string> = [codegen_return_type(method.return_type)]
    let mut params: Slice<string> = []
    if let ObjjMethodSelector.Keyword(parts) = method.selector {
      for part in parts {
        types = types.append(codegen_param_type(part.parameter_type))
        params = params.append(part.parameter_name.text)
      }
    }
    let mut inner = &self
    let mut dispatch_state = ReceiverState { .. }
    inner.receivers = Some(&dispatch_state)
    inner.in_instance_method = match method.scope {
      Instance => true,
      Class => false,
    }
    inner.self_assigned = body_assigns_self(method.body)
    inner.locals = scope_locals([], params, block_declared_names(method.body))

    write(buf, "new objj_method(sel_getUid(\"" + selector + "\"), ")
    if method.return_type.is_async { write(buf, "async ") }
    write(
      buf,
      "function $" + class_name + "__" + strings.ReplaceAll(selector, ":", "_"),
    )
    write(buf, "(self, _cmd")
    for param in params {
      write(buf, ", " + param)
    }
    write(buf, ")\n")
    let diags = inner.block(buf, method.body, indent_step(), false, true, true)
    write(buf, "\n,[")
    write(buf, quoted_type_list(types))
    write(buf, "])")
    diags
  }

  fn objj_protocol(
    self,
    buf: Ref<strings.Builder>,
    declaration: ObjjProtocolDeclaration,
  ) -> Slice<Diagnostic> {
    let protocol_name = declaration.name.text
    write(
      buf,
      "{var the_protocol = objj_allocateProtocol(\"" + protocol_name + "\");",
    )
    if let Some(list) = declaration.protocols {
      for inherited in list.protocols {
        write(
          buf,
          "\nvar aProtocol = objj_getProtocol(\"" + inherited.text + "\");",
        )
        write(
          buf,
          "\nif (!aProtocol) throw new SyntaxError(\"*** Could not find definition for protocol \\\"" +
          protocol_name +
          "\\\"\");",
        )
        write(buf, "\nprotocol_addProtocol(the_protocol, aProtocol);")
      }
    }
    let mut im = ""
    let mut cm = ""
    let mut required = true
    for member in declaration.members {
      match member {
        Optional(_) => required = false,
        Required(_) => required = true,
        Method(method) => {
          if !required { continue }
          let description = objj_method_description(method)
          match method.scope {
            Instance => {
              if !im.is_empty() { im += ", " }
              im += description
            },
            Class => {
              if !cm.is_empty() { cm += ", " }
              cm += description
            },
          }
        },
      }
    }
    write(buf, "\nobjj_registerProtocol(the_protocol);\n")
    if !im.is_empty() {
      write(
        buf,
        "protocol_addMethodDescriptions(the_protocol, [" + im +
        "], true, true);\n",
      )
    }
    if !cm.is_empty() {
      write(
        buf,
        "protocol_addMethodDescriptions(the_protocol, [" + cm +
        "], true, false);\n",
      )
    }
    write(buf, "}")
    []
  }

  fn objj_message(
    self,
    buf: Ref<strings.Builder>,
    message: ObjjMessageExpression,
    ind: string,
  ) -> Slice<Diagnostic> {
    let selector = message.selector.selector_string()
    let arguments = message_arguments(message.selector)

    if let Some(super_form) = self.super_receiver_text(message.receiver.*) {
      write(
        buf,
        "(" + super_form + ".method_dtable[\"" + selector +
        "\"] || _objj_forward)(self, \"" +
        selector +
        "\"",
      )
      let diags = self.trailing_arguments(buf, arguments, ind)
      write(buf, ")")
      return diags
    }

    let receiver_is_identifier = expression_identifier_name(message.receiver.*).is_some()

    if self.receiver_is_simple(message.receiver.*) {
      let mut r_buf = strings.Builder { .. }
      let r_diags = self.expression(&r_buf, message.receiver.*, ind)
      let r = r_buf.String()
      let guard = self.simple_receiver_guarded(message.receiver.*)
      if guard { write(buf, "(" + r + " == null ? " + r + " : ") }
      write(
        buf,
        "(" + r + ".isa.method_msgSend[\"" + selector + "\"] || _objj_forward)(" +
        r +
        ", ",
      )
      write(buf, self.selector_argument(r, receiver_is_identifier, selector))
      let diags = merge_diags(
        r_diags,
        self.trailing_arguments(buf, arguments, ind),
      )
      write(buf, ")")
      if guard { write(buf, ")") }
      return diags
    }

    let n = self.receiver_enter()
    let temp = f"___r{n}"
    let mut r_buf = strings.Builder { .. }
    let r_diags = self.expression(&r_buf, message.receiver.*, ind)
    let r_text = r_buf.String()
    write(
      buf,
      "((" + temp + " = " + r_text + "), " + temp + " == null ? " + temp + " : ",
    )
    write(
      buf,
      "(" + temp + ".isa.method_msgSend[\"" + selector +
      "\"] || _objj_forward)(" +
      temp +
      ", ",
    )
    write(buf, self.selector_argument(r_text, receiver_is_identifier, selector))
    let diags = merge_diags(
      r_diags,
      self.trailing_arguments(buf, arguments, ind),
    )
    write(buf, "))")
    self.receiver_exit()
    diags
  }

  fn selector_argument(
    self,
    receiver_text: string,
    receiver_is_identifier: bool,
    selector: string,
  ) -> string {
    if !self.debug_dispatch || !receiver_is_identifier {
      return "\"" + selector + "\""
    }
    let parts = selector_part_count(selector)
    let mut lookups = ""
    for _ in 0..parts {
      lookups += receiver_text + ".isa.method_dtable[\"" + selector + "\"], "
    }
    "(" + lookups + "\"" + selector + "\")"
  }

  fn trailing_arguments(
    self,
    buf: Ref<strings.Builder>,
    arguments: Slice<Expression>,
    ind: string,
  ) -> Slice<Diagnostic> {
    let mut diags: Slice<Diagnostic> = []
    for argument in arguments {
      write(buf, ", ")
      diags = merge_diags(diags, self.expression(buf, argument, ind))
    }
    diags
  }

  fn super_receiver_text(self, receiver: Expression) -> Option<string> {
    let is_super = match receiver {
      Primary(Super(_)) => true,
      _ => false,
    }
    if !is_super { return None }
    let Some(context) = self.current_class else {
      return Some("Nil.super_class")
    }
    if self.in_instance_method {
      Some("objj_getClass(\"" + context.name + "\").super_class")
    } else {
      Some("objj_getMetaClass(\"" + context.name + "\").super_class")
    }
  }

  fn receiver_is_simple(self, receiver: Expression) -> bool {
    let Some(name) = expression_identifier_name(receiver) else {
      return false
    }
    if self.in_instance_method && !reserved_identifier(name) &&
    !self.is_local(name) {
      if let Some(context) = self.current_class {
        if context.ivars[name] { return false }
      }
    }
    true
  }

  fn simple_receiver_guarded(self, receiver: Expression) -> bool {
    let Some(name) = expression_identifier_name(receiver) else {
      return true
    }
    if name == "self" { return self.self_assigned }
    self.is_local(name) || !self.known_classes[name]
  }

  fn receiver_enter(self) -> int {
    let Some(state) = self.receivers else {
      return 1
    }
    state.level += 1
    if state.level > state.max { state.max = state.level }
    state.level
  }

  fn receiver_exit(self) {
    if let Some(state) = self.receivers { state.level -= 1 }
  }

  fn objj_array(
    self,
    buf: Ref<strings.Builder>,
    literal: ObjjArrayLiteral,
    ind: string,
  ) -> Slice<Diagnostic> {
    let elements = literal.array.elements
    let n = self.receiver_enter()
    let temp = f"___r{n}"
    self.alloc_head_write(buf, temp, "CPArray")
    let diags = if elements.is_empty() {
      write(buf, self.init_send(temp, "init", ""))
      []
    } else {
      let mut items_buf = strings.Builder { .. }
      let mut items_diags: Slice<Diagnostic> = []
      let mut first = true
      for element in elements {
        if !first { let _ = items_buf.WriteString(", ") }
        match element {
          Expression(e) => items_diags = merge_diags(
            items_diags,
            self.expression(&items_buf, e.*, ind),
          ),
          Spread(spread) => {
            let _ = items_buf.WriteString("...")
            items_diags = merge_diags(
              items_diags,
              self.expression(&items_buf, spread.argument.*, ind),
            )
          },
        }
        first = false
      }
      write(
        buf,
        self.init_send(
          temp,
          "initWithObjects:count:",
          "[" + items_buf.String() + "], " + f"{elements.length()}",
        ),
      )
      items_diags
    }
    write(buf, ")")
    self.receiver_exit()
    diags
  }

  fn objj_dictionary(
    self,
    buf: Ref<strings.Builder>,
    literal: ObjjDictionaryLiteral,
    ind: string,
  ) -> Slice<Diagnostic> {
    let n = self.receiver_enter()
    let temp = f"___r{n}"
    self.alloc_head_write(buf, temp, "CPDictionary")
    let diags = if literal.pairs.is_empty() {
      write(buf, self.init_send(temp, "init", ""))
      []
    } else {
      let mut values_buf = strings.Builder { .. }
      let mut keys_buf = strings.Builder { .. }
      let mut all_diags: Slice<Diagnostic> = []
      let mut first = true
      for pair in literal.pairs {
        if !first {
          let _ = values_buf.WriteString(", ")
          let _ = keys_buf.WriteString(", ")
        }
        all_diags = merge_diags(
          all_diags,
          self.expression(&values_buf, pair.value.*, ind),
        )
        all_diags = merge_diags(
          all_diags,
          self.expression(&keys_buf, pair.key.*, ind),
        )
        first = false
      }
      write(
        buf,
        self.init_send(
          temp,
          "initWithObjects:forKeys:",
          "[" + values_buf.String() + "], [" + keys_buf.String() + "]",
        ),
      )
      all_diags
    }
    write(buf, ")")
    self.receiver_exit()
    diags
  }

  fn alloc_head_write(
    self,
    buf: Ref<strings.Builder>,
    temp: string,
    class_name: string,
  ) {
    write(
      buf,
      "(" + temp + " = (" + class_name +
      ".isa.method_msgSend[\"alloc\"] || _objj_forward)(" +
      class_name +
      ", \"alloc\"), " +
      temp +
      " == null ? " +
      temp +
      " : ",
    )
  }

  fn init_send(self, temp: string, selector: string, args: string) -> string {
    let mut out = "(" + temp + ".isa.method_msgSend[\"" + selector +
    "\"] || _objj_forward)(" +
    temp +
    ", \"" +
    selector +
    "\""
    if !args.is_empty() { out += ", " + args }
    out
  }

  fn deref_update(
    self,
    buf: Ref<strings.Builder>,
    deref: ObjjDerefExpression,
    operator: UpdateOp,
    is_prefix: bool,
    ind: string,
  ) -> Slice<Diagnostic> {
    let op = match operator {
      Increment => "+",
      Decrement => "-",
    }
    let core_open = if is_prefix { "(" } else { "((" }
    write(buf, core_open)
    write(buf, "(")
    let mut diags = self.expression(buf, deref.argument.*, ind)
    write(buf, ")(")
    diags = merge_diags(diags, self.expression(buf, deref.argument.*, ind))
    write(buf, "() " + op + " 1)")
    if !is_prefix {
      let undo = match operator {
        Increment => " - 1)",
        Decrement => " + 1)",
      }
      write(buf, undo)
    }
    diags
  }
}

fn statement_needs_parens(e: Expression, is_directive: bool) -> bool {
  match e {
    Primary(primary) => match primary {
      Object(_) | Function(_) | Generator(_) => true,
      String(literal) => !is_directive && is_use_strict(literal),
      _ => false,
    },
    Assignment(assignment) => match assignment {
      Standard(standard) => assignment_left_is_object_pattern(standard),
      ObjjDeref(_) => false,
    },
    Binary(binary) => match binary.left {
      Expression(left) => match left.* {
        Primary(Function(_)) | Primary(Generator(_)) => true,
        _ => false,
      },
      PrivateProperty(_) => false,
    },
    _ => false,
  }
}

fn arrow_body_needs_parens(e: Expression) -> bool {
  match e {
    Primary(primary) => match primary {
      Object(_) | Function(_) | Generator(_) => true,
      _ => false,
    },
    Assignment(assignment) => match assignment {
      Standard(standard) => assignment_left_is_object_pattern(standard),
      ObjjDeref(_) => false,
    },
    _ => false,
  }
}

fn assignment_left_is_object_pattern(standard: StandardAssignment) -> bool {
  match standard.left {
    Lhs(lhs) => match lhs.* {
      Destructuring(pattern) => match pattern.* {
        Object(_) => true,
        Array(_) => false,
      },
      _ => false,
    },
    Parenthesized(_) => false,
  }
}

fn formal_parameter_is_plain_identifier(parameter: FormalParameter) -> bool {
  match parameter {
    Pattern(pattern) => match pattern {
      Lhs(lhs) => match lhs {
        Identifier(_) => true,
        _ => false,
      },
      Rest(_) => false,
    },
    Assignment(_) => false,
  }
}

fn module_export_name_text(name: ModuleExportName) -> string {
  match name {
    Identifier(identifier) => identifier.text,
    String(literal) => literal.text,
    Default(_) => "default",
  }
}

fn string_literal_inner(literal: StringLiteral) -> string {
  let mut out = ""
  for part in literal.parts {
    match part {
      Fragment(fragment) => out += fragment.text,
      Escape(escape) => out += escape.text,
    }
  }
  out
}

fn reserved_identifier(name: string) -> bool {
  name == "self" || name == "_cmd" || name == "__filename" ||
  name == "undefined" ||
  name == "localStorage" ||
  name == "arguments"
}

fn objj_typedef_write(buf: Ref<strings.Builder>, name: string) {
  write(
    buf,
    "{var the_typedef = objj_allocateTypeDef(\"" + name +
    "\");\nobjj_registerTypeDef(the_typedef);\n}",
  )
}

fn codegen_type(objj_type: ObjjType) -> string {
  match objj_type {
    Protocol(protocol_type) => protocol_type.name.text,
    MultiWord(multi_word) => multi_word.render(),
    Id(_) => "id",
    Named(identifier) => identifier.text,
  }
}

fn codegen_return_type(method_type: ObjjMethodType) -> string {
  match method_type.return_kind {
    Action(_) => "void",
    Void(_) => "void",
    Type(objj_type) => codegen_type(objj_type),
  }
}

fn codegen_param_type(parameter_type: Option<ObjjMethodType>) -> string {
  parameter_type.map_or("id", codegen_return_type)
}

fn quoted_type_list(types: Slice<string>) -> string {
  "\"" + strings.Join(types, "\",\"") + "\""
}

fn assignment_op_char(op: AssignmentOp) -> string {
  match op {
    Assign => "=",
    Add => "+",
    Sub => "-",
    Mul => "*",
    Div => "/",
    Mod => "%",
    BitAnd => "&",
    BitOr => "|",
    BitXor => "^",
    ShiftLeft => "<<",
    ShiftRight => ">>",
    UnsignedShiftRight => ">>>",
  }
}

fn message_arguments(selector: ObjjMessageSelector) -> Slice<Expression> {
  let mut out: Slice<Expression> = []
  if let ObjjMessageSelector.Keyword(keywords) = selector {
    for keyword in keywords {
      for argument in keyword.arguments {
        out = out.append(argument)
      }
    }
  }
  out
}

fn selector_part_count(selector: string) -> int {
  let count = strings.Count(selector, ":")
  if count == 0 { 1 } else { count }
}

fn expression_identifier_name(e: Expression) -> Option<string> {
  if let Expression.Primary(PrimaryExpression.Identifier(identifier)) = e {
    return Some(identifier.text)
  }
  None
}

fn expression_as_deref(e: Expression) -> Option<ObjjDerefExpression> {
  if let Expression.Primary(PrimaryExpression.ObjjDeref(deref)) = e {
    return Some(deref)
  }
  None
}

fn body_assigns_self(body: StatementBlock) -> bool {
  for st in body.body {
    if statement_assigns_self(st) { return true }
  }
  false
}

fn statement_assigns_self(st: Statement) -> bool {
  match st {
    Expression(es) => expressions_assign_self(es.expression.*),
    Return(return_st) => return_st.value.map_or(false, expressions_assign_self),
    Declaration(declaration) => match declaration {
      Variable(variable) => declarators_assign_self(variable.declarators),
      Lexical(lexical) => declarators_assign_self(lexical.declarators),
      _ => false,
    },
    BlockScope(inner) => block_assigns_self(inner),
    If(if_st) => {
      if expressions_assign_self(if_st.condition.expression.*) { return true }
      if statement_assigns_self(if_st.consequence.*) { return true }
      if_st.alternative.map_or(false, |alternative| statement_assigns_self(
        alternative.body.*,
      ))
    },
    For(for_st) => statement_assigns_self(for_st.body.*),
    ForIn(for_in) => statement_assigns_self(for_in.body.*),
    While(while_st) => statement_assigns_self(while_st.body.*),
    Do(do_st) => statement_assigns_self(do_st.body.*),
    With(with_st) => statement_assigns_self(with_st.body.*),
    Labeled(labeled) => statement_assigns_self(labeled.body.*),
    Switch(switch_st) => {
      for entry in switch_st.body.entries {
        let body = match entry {
          Case(case) => case.body,
          Default(default) => default.body,
        }
        for body_st in body {
          if statement_assigns_self(body_st) { return true }
        }
      }
      false
    },
    Try(try_st) => {
      if block_assigns_self(try_st.body) { return true }
      if let Some(handler) = try_st.handler {
        if block_assigns_self(handler.body) { return true }
      }
      try_st.finalizer.map_or(false, |finalizer| block_assigns_self(
        finalizer.body,
      ))
    },
    Throw(throw_st) => expressions_assign_self(throw_st.value.*),
    _ => false,
  }
}

fn block_assigns_self(block: StatementBlock) -> bool {
  for st in block.body {
    if statement_assigns_self(st) { return true }
  }
  false
}

fn declarators_assign_self(declarators: Slice<VariableDeclarator>) -> bool {
  for declarator in declarators {
    if let Some(initializer) = declarator.initializer {
      if expression_assigns_self(initializer.value.*) { return true }
    }
  }
  false
}

fn expressions_assign_self(exprs: Expressions) -> bool {
  match exprs {
    Single(e) => expression_assigns_self(e),
    Sequence(sequence) => {
      for item in sequence.items {
        if expression_assigns_self(item) { return true }
      }
      false
    },
  }
}

fn expression_assigns_self(e: Expression) -> bool {
  match e {
    Assignment(assignment) => match assignment {
      Standard(standard) => {
        let left_is_self = match standard.left {
          Lhs(lhs) => match lhs.* {
            Identifier(identifier) => identifier.text == "self",
            _ => false,
          },
          Parenthesized(_) => false,
        }
        left_is_self || expression_assigns_self(standard.right.*)
      },
      ObjjDeref(deref) => expression_assigns_self(deref.right.*),
    },
    _ => false,
  }
}

fn objj_method_description(method: ObjjMethodDeclaration) -> string {
  let selector = method.selector.selector_string()
  let mut types: Slice<string> = [codegen_return_type(method.return_type)]
  if let ObjjMethodSelector.Keyword(parts) = method.selector {
    for part in parts {
      types = types.append(codegen_param_type(part.parameter_type))
    }
  }
  "new objj_method(sel_getUid(\"" + selector + "\"), Nil\n,[" +
  quoted_type_list(types) +
  "])"
}

fn scope_locals(
  base: Slice<string>,
  names: Slice<string>,
  hoisted: Slice<string>,
) -> Slice<string> {
  let mut out: Slice<string> = []
  for name in base {
    out = out.append(name)
  }
  for name in names {
    out = out.append(name)
  }
  for name in hoisted {
    out = out.append(name)
  }
  out
}

fn function_scope_locals(
  base: Slice<string>,
  name: Option<Identifier>,
  parameters: FormalParameters,
  body: StatementBlock,
) -> Slice<string> {
  let mut names = collect_parameter_names(parameters)
  if let Some(identifier) = name { names = names.append(identifier.text) }
  scope_locals(base, names, block_declared_names(body))
}

fn arrow_scope_locals(
  base: Slice<string>,
  parameters: ArrowParameters,
  body: ArrowBody,
) -> Slice<string> {
  let names = match parameters {
    Single(identifier) => [identifier.text],
    List(list) => collect_parameter_names(list),
  }
  let hoisted = match body {
    Block(block) => block_declared_names(block),
    Expression(_) => [],
  }
  scope_locals(base, names, hoisted)
}

fn collect_parameter_names(parameters: FormalParameters) -> Slice<string> {
  let mut names: Slice<string> = []
  for parameter in parameters.parameters {
    match parameter {
      Pattern(pattern) => names = pattern_declared_names(pattern, names),
      Assignment(assignment) => names = pattern_declared_names(
        assignment.left.*,
        names,
      ),
    }
  }
  names
}

fn block_declared_names(block: StatementBlock) -> Slice<string> {
  let mut names: Slice<string> = []
  for st in block.body {
    names = statement_declared_names(st, names)
  }
  names
}

fn statement_declared_names(st: Statement, mut names: Slice<string>) -> Slice<string> {
  match st {
    Declaration(declaration) => match declaration {
      Function(function) => names.append(function.name.text),
      GeneratorFunction(generator) => names.append(generator.name.text),
      Class(class) => names.append(class.name.text),
      Lexical(lexical) => declarator_names(lexical.declarators, names),
      Variable(variable) => declarator_names(variable.declarators, names),
      Using(using) => declarator_names(using.declarators, names),
    },
    BlockScope(inner) => {
      for nested in inner.body {
        names = statement_declared_names(nested, names)
      }
      names
    },
    If(if_st) => {
      names = statement_declared_names(if_st.consequence.*, names)
      if let Some(alternative) = if_st.alternative {
        names = statement_declared_names(alternative.body.*, names)
      }
      names
    },
    Switch(switch_st) => {
      for entry in switch_st.body.entries {
        match entry {
          Case(case) => {
            for nested in case.body {
              names = statement_declared_names(nested, names)
            }
          },
          Default(default) => {
            for nested in default.body {
              names = statement_declared_names(nested, names)
            }
          },
        }
      }
      names
    },
    For(for_st) => {
      match for_st.initializer {
        Lexical(lexical) => names = declarator_names(lexical.declarators, names),
        Variable(variable) => names = declarator_names(
          variable.declarators,
          names,
        ),
        Expression(_) => (),
        Empty(_) => (),
      }
      statement_declared_names(for_st.body.*, names)
    },
    ForIn(for_in) => {
      if let ForBinding.Declared(declared) = for_in.header.binding {
        match declared.left {
          Identifier(identifier) => names = names.append(identifier.text),
          Destructuring(pattern) => names = destructuring_declared_names(
            pattern,
            names,
          ),
        }
      }
      statement_declared_names(for_in.body.*, names)
    },
    While(while_st) => statement_declared_names(while_st.body.*, names),
    Do(do_st) => statement_declared_names(do_st.body.*, names),
    With(with_st) => statement_declared_names(with_st.body.*, names),
    Labeled(labeled) => statement_declared_names(labeled.body.*, names),
    Try(try_st) => {
      for nested in try_st.body.body {
        names = statement_declared_names(nested, names)
      }
      if let Some(handler) = try_st.handler {
        if let Some(parameter) = handler.parameter {
          match parameter {
            Identifier(identifier) => names = names.append(identifier.text),
            Destructuring(pattern) => names = destructuring_declared_names(
              pattern,
              names,
            ),
          }
        }
        for nested in handler.body.body {
          names = statement_declared_names(nested, names)
        }
      }
      if let Some(finalizer) = try_st.finalizer {
        for nested in finalizer.body.body {
          names = statement_declared_names(nested, names)
        }
      }
      names
    },
    _ => names,
  }
}

fn declarator_names(
  declarators: Slice<VariableDeclarator>,
  mut names: Slice<string>,
) -> Slice<string> {
  for declarator in declarators {
    match declarator.name {
      Identifier(identifier) => names = names.append(identifier.text),
      Destructuring(pattern) => names = destructuring_declared_names(
        pattern,
        names,
      ),
    }
  }
  names
}

fn pattern_declared_names(pattern: Pattern, mut names: Slice<string>) -> Slice<string> {
  match pattern {
    Lhs(lhs) => match lhs {
      Identifier(identifier) => names.append(identifier.text),
      Destructuring(nested) => destructuring_declared_names(nested.*, names),
      Member(_) => names,
      Subscript(_) => names,
      Undefined(_) => names,
    },
    Rest(rest) => match rest.argument.* {
      Identifier(identifier) => names.append(identifier.text),
      Destructuring(nested) => destructuring_declared_names(nested.*, names),
      _ => names,
    },
  }
}

fn destructuring_declared_names(
  pattern: DestructuringPattern,
  mut names: Slice<string>,
) -> Slice<string> {
  match pattern {
    Object(object) => {
      for member in object.members {
        match member {
          Pair(pair) => match pair.value {
            Pattern(value) => names = pattern_declared_names(value.*, names),
            Assignment(value) => names = pattern_declared_names(
              value.left.*,
              names,
            ),
          },
          Rest(rest) => {
            if let LhsExpression.Identifier(identifier) = rest.argument.* {
              names = names.append(identifier.text)
            }
          },
          Assignment(assignment) => match assignment.left {
            Shorthand(identifier) => names = names.append(identifier.text),
            Destructuring(nested) => names = destructuring_declared_names(
              nested.*,
              names,
            ),
          },
          Shorthand(identifier) => names = names.append(identifier.text),
        }
      }
      names
    },
    Array(array) => {
      for element in array.elements {
        match element {
          Pattern(value) => names = pattern_declared_names(value.*, names),
          Assignment(value) => names = pattern_declared_names(
            value.left.*,
            names,
          ),
        }
      }
      names
    },
  }
}
