//
// Host environment reporting and launch checks, so that a support case starts
// from facts.
//
// The grammar library is found by searching capp-parse's grammar.Locations()
// in order; the first library found is the one loaded. Every library found is
// classified into a Finding. Libraries other than the one in use are inspected
// in a separate capp-build process (the hidden probe-grammar command), because
// one process cannot reliably hold two copies of the same library.
// **
import "go:crypto/sha256"
import "go:encoding/json"
import "go:fmt"
import "go:github.com/enquora-net/capp-parse/grammar"
import "go:github.com/enquora-net/capp-parse/host"
import "go:os"
import "go:os/exec"
import "go:path/filepath"
import "go:runtime"
import "go:runtime/debug"
import "go:strings"

// The oldest grammar release capp-build accepts, as reported by tree-sitter's
// language metadata (major.minor.patch only).
pub const MIN_GRAMMAR_MAJOR: int = 1

pub const MIN_GRAMMAR_MINOR: int = 0

pub const MIN_GRAMMAR_PATCH: int = 0

// Name of the hidden command that inspects one library in its own process.
pub const PROBE_COMMAND: string = "probe-grammar"

// ---------------------------------------------------------------------------
// Grammar library findings
// ---------------------------------------------------------------------------

// What a search location holds. A location holding several accepted file
// names yields one finding per file.
pub enum Finding {
  // No library in this location.
  Absent,
  // A library is present but cannot be loaded or inspected.
  LoadFailed { path: string, file: FileFacts, reason: string },
  // A library that loads but is older than capp-build accepts.
  Outdated { path: string, file: FileFacts, info: grammar.Info, reason: string },
  // A library capp-build accepts.
  Supported { path: string, file: FileFacts, info: grammar.Info },
}

pub struct FileFacts {
  pub size: int,
  pub modified: string,
  pub sha256: string,
}

pub struct LocationReport {
  pub dir: string,
  pub scope: string,
  pub findings: Slice<Finding>,
}

pub struct GrammarReport {
  // Set when --grammar names a library explicitly, bypassing the search.
  pub override: Option<Finding>,
  pub locations: Slice<LocationReport>,
}

// classify decides whether a library capp-build can use, from what the
// library reports about itself.
pub fn classify(path: string, file: FileFacts, info: grammar.Info) -> Finding {
  if !info.HasRelease {
    return Finding.Outdated {
      path,
      file,
      info,
      reason: "no release version: generated before tree-sitter 0.25",
    }
  }
  if release_below_minimum(info) {
    let release = release_string(info)
    return Finding.Outdated {
      path,
      file,
      info,
      reason: f"release {release} is older than {minimum_release()}",
    }
  }
  if !info.HasBuild {
    return Finding.Outdated {
      path,
      file,
      info,
      reason: "no build version: built before 1.0.0-beta.2",
    }
  }
  Finding.Supported { path, file, info }
}

fn release_below_minimum(info: grammar.Info) -> bool {
  if info.Major != MIN_GRAMMAR_MAJOR { return info.Major < MIN_GRAMMAR_MAJOR }
  if info.Minor != MIN_GRAMMAR_MINOR { return info.Minor < MIN_GRAMMAR_MINOR }
  info.Patch < MIN_GRAMMAR_PATCH
}

pub fn release_string(info: grammar.Info) -> string {
  f"{info.Major}.{info.Minor}.{info.Patch}"
}

pub fn minimum_release() -> string {
  f"{MIN_GRAMMAR_MAJOR}.{MIN_GRAMMAR_MINOR}.{MIN_GRAMMAR_PATCH}"
}

fn file_facts(path: string) -> Result<FileFacts, error> {
  let fi = os.Stat(path)?
  let data = os.ReadFile(path)?
  let sum = sha256.Sum256(data)
  Ok(
    FileFacts {
      size: fi.Size() as int,
      modified: fi.ModTime().Format("2006-01-02 15:04:05 MST"),
      sha256: fmt.Sprintf("%x", sum),
    },
  )
}

// inspect_here loads the library into this process. Use it only for the
// library this process will use anyway.
pub fn inspect_here(path: string) -> Finding {
  let file = match file_facts(path) {
    Ok(f) => f,
    Err(e) => {
      return Finding.LoadFailed { path, file: FileFacts { .. }, reason: f"{e}" }
    },
  }
  match grammar.Inspect(path) {
    Ok(info) => classify(path, file, info),
    Err(e) => Finding.LoadFailed { path, file, reason: f"{e}" },
  }
}

// Output of the probe-grammar command.
#[json]
pub struct ProbeResult {
  pub ok: bool,
  pub error: string,
  pub info: grammar.Info,
}

// probe_main implements the hidden probe-grammar command: inspect one
// library and print the result as JSON.
pub fn probe_main(path: string) {
  let result = match grammar.Inspect(path) {
    Ok(info) => ProbeResult { ok: true, error: "", info },
    Err(e) => ProbeResult {
      ok: false,
      error: f"{e}",
      info: grammar.Info { Path: path, .. },
    },
  }
  match json.Marshal(result) {
    Ok(b) => fmt.Println(b as string),
    Err(e) => fmt.Println(f"{{\"ok\":false,\"error\":\"{e}\"}}"),
  }
}

// inspect_apart inspects a library in a separate capp-build process.
fn inspect_apart(path: string) -> Finding {
  let file = match file_facts(path) {
    Ok(f) => f,
    Err(e) => {
      return Finding.LoadFailed { path, file: FileFacts { .. }, reason: f"{e}" }
    },
  }
  let exe = match os.Executable() {
    Ok(p) => p,
    Err(e) => {
      return Finding.LoadFailed {
        path,
        file,
        reason: f"cannot locate capp-build: {e}",
      }
    },
  }
  let mut cmd = exec.Command(exe, PROBE_COMMAND, path)
  let out = match cmd.Output() {
    Ok(o) => o,
    Err(e) => {
      return Finding.LoadFailed {
        path,
        file,
        reason: f"inspection process failed: {e}",
      }
    },
  }
  let mut result = ProbeResult {
    ok: false,
    error: "",
    info: grammar.Info { Path: path, .. },
  }
  if let Err(e) = json.Unmarshal(out, &result) {
    return Finding.LoadFailed {
      path,
      file,
      reason: f"unreadable inspection result: {e}",
    }
  }
  if !result.ok {
    return Finding.LoadFailed { path, file, reason: result.error }
  }
  classify(path, file, result.info)
}

// grammar_report searches every location and inspects every library found.
pub fn search_grammar(override_path: string) -> GrammarReport {
  let override = if override_path != "" {
    Some(inspect_apart(override_path))
  } else {
    None
  }
  let mut locations: Slice<LocationReport> = []
  for loc in grammar.Locations() {
    let mut findings: Slice<Finding> = []
    for name in grammar.LibraryNames() {
      let path = filepath.Join(loc.Dir, name)
      if let Ok(fi) = os.Stat(path) {
        if fi.Mode().IsRegular() {
          findings = findings.append(inspect_apart(path))
        }
      }
    }
    if findings.is_empty() { findings = findings.append(Finding.Absent) }
    locations = locations.append(
      LocationReport { dir: loc.Dir, scope: loc.Scope as string, findings },
    )
  }
  GrammarReport { override, locations }
}

// ---------------------------------------------------------------------------
// Launch checks
// ---------------------------------------------------------------------------

// preflight refuses to continue under architecture translation, or when the
// grammar library that would be used is missing, unloadable or outdated.
// Returns the message to show and stop with.
pub fn preflight(grammar_override: string) -> Result<(), string> {
  let facts = host.Detect()
  if facts.TranslationKnown && facts.Translated {
    return Err(translation_message(facts))
  }

  let path = if grammar_override != "" {
    grammar_override
  } else {
    grammar.FindLibrary()
  }
  if path == "" {
    let dirs = grammar.SearchPaths().map(|d| f"  {d}") |> join_lines
    return Err(
      f"grammar library not found\nsearched:\n{dirs}\nRun `capp-build env` for details.",
    )
  }

  match inspect_here(path) {
    Finding.Supported { .. } => Ok(()),
    Finding.Outdated { path, reason, .. } => Err(
      f"grammar library is outdated: {path}\n  {reason}\nInstall the current tree-sitter-objj release. Run `capp-build env` for details.",
    ),
    Finding.LoadFailed { path, reason, .. } => Err(
      f"grammar library cannot be loaded: {path}\n  {reason}\nRun `capp-build env` for details.",
    ),
    Finding.Absent => Err(
      "grammar library not found. Run `capp-build env` for details.",
    ),
  }
}

fn translation_message(facts: host.Facts) -> string {
  f"capp-build is a {facts.OS}/{facts.BinaryArch} binary running under {facts.Translator} on a {facts.HostArch} machine.\nTranslation is not supported. Install the native {facts.OS}/{facts.HostArch} release of capp-build instead."
}

fn join_lines(lines: Slice<string>) -> string {
  strings.Join(lines, "\n")
}

// ---------------------------------------------------------------------------
// capp-build build facts
// ---------------------------------------------------------------------------

pub struct BuildFacts {
  pub version: string,
  pub go_version: string,
  pub commit: string,
  pub commit_time: string,
  pub modified: bool,
}

pub fn collect_build_facts(version: string) -> BuildFacts {
  let mut facts = BuildFacts { version, go_version: runtime.Version(), .. }
  if let Some(info) = debug.ReadBuildInfo() {
    for s in info.Settings {
      match s.Key {
        "vcs.revision" => facts.commit = s.Value,
        "vcs.time" => facts.commit_time = s.Value,
        "vcs.modified" => facts.modified = s.Value == "true",
        _ => (),
      }
    }
  }
  facts
}
