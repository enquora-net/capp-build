//**
// env.lis
// capp-build
//
// Copyright (c) 2026 David Richardson. All rights reserved.
//
// Host environment facts and launch checks, so that a support case starts
// from facts.
//
// Why this module exists
//
// capp-build does not contain the Objective-J grammar. It loads the
// tree-sitter-objj library at run time from one of several install locations
// (capp-parse's grammar package defines them), and that library is
// installed, upgraded and versioned separately from capp-build. Two problems
// follow from that:
//
//   - A stale library goes unnoticed. An old copy left in an earlier search
//     location hides a newer one, and an outdated grammar produces parse
//     errors on valid source. Those errors look like compiler defects, and
//     nothing in them points at the library.
//   - A support case has nothing to start from. Which capp-build build is
//     running, on which operating system and architecture, and which library
//     it loaded, are invisible both to the user and to whoever helps them.
//
// A third problem is architecture translation: an amd64 capp-build running
// under Rosetta 2 on Apple silicon, or under x64 emulation on Windows on ARM.
// It is slower, adds a variable to every support case, and needs a grammar
// library built for the emulated architecture. Native releases exist for
// every platform, so translation is never useful.
//
// The module answers these problems in two ways:
//
//   - Launch checks stop capp-build before it starts work, with a message
//     naming the problem and the fix, instead of letting it fail later in a
//     way that looks unrelated.
//   - `capp-build env` reports every relevant fact, as text for people or as
//     JSON to attach to a support request. It never stops: it is the command
//     to run when something is wrong.
//
// How it works
//
// This module has two entry points, both in this file:
//
//   survey()     gathers the Environment that `capp-build env` reports.
//   preflight()  gathers the LaunchFacts and runs the launch checks before
//                build and the grammar-loading smoke commands.
//
// Facts are gathered first and only then reported or checked, so every
// decision reads from one value rather than from the order of statements.
//
//   capp-build env                        launch checks (build, smoke)
//   --------------                        ----------------------------
//   survey() gathers an Environment:      preflight() gathers LaunchFacts:
//     capp-build's own BuildFacts           host.Detect()
//     host.Detect()                         the library in use, inspected
//     search(): every location and            InThisProcess
//       every library in it, inspected    then runs each LaunchCheck in
//       InSeparateProcess                   declaration order; the first
//   then renders it as text or JSON.        failure stops capp-build.
//
// Where the rest lives:
//
//   library.lis  grammar libraries: which one is in use, searching the
//                install locations, inspecting a library, and the
//                Requirements that decide whether it is current.
//   launch.lis   the LaunchCheck steps.
//   probe.lis    the hidden probe-grammar command, which inspects one library
//                in a separate process.
//   report.lis   renders the Environment as text or JSON; decides nothing.
// **
import "go:github.com/enquora-net/capp-parse/host"
import "go:runtime"
import "go:runtime/debug"

// ---------------------------------------------------------------------------
// `capp-build env`
// ---------------------------------------------------------------------------

// Everything `capp-build env` reports.
pub struct Environment {
  pub build: BuildFacts,
  pub host: Host,
  pub grammar: GrammarSearch,
}

// survey gathers everything `capp-build env` reports.
pub fn survey(version: string, grammar_override: string) -> Environment {
  Environment {
    build: collect_build_facts(version),
    host: Host.detect(),
    grammar: search(grammar_override),
  }
}

// ---------------------------------------------------------------------------
// Launch checks
// ---------------------------------------------------------------------------

// What the launch checks decide from, gathered before any check runs.
pub struct LaunchFacts {
  pub host: Host,
  // The library in use, inspected InThisProcess; Absent when none is found.
  pub grammar: Finding,
}

// preflight gathers the LaunchFacts and runs every LaunchCheck in declaration
// order. Returns the message to show and stop with.
pub fn preflight(grammar_override: string) -> Result<(), string> {
  let in_use = library_in_use(grammar_override).map_or(
    Finding.Absent,
    |path| inspect(path, Inspection.InThisProcess),
  )
  let facts = LaunchFacts { host: Host.detect(), grammar: in_use }
  for check in LaunchCheck.variants() {
    check.run(facts)?
  }
  Ok(())
}

// ---------------------------------------------------------------------------
// The host
// ---------------------------------------------------------------------------

// The machine and the running process.
pub struct Host {
  pub os: string, // GOOS, e.g. "darwin"
  pub os_name: string, // e.g. "macOS", "Ubuntu 24.04.1 LTS", "Windows 11"
  pub os_version: string,
  // The architecture capp-build was built for.
  pub binary_arch: string,
  // The machine's own architecture. On Linux it is what the kernel reports,
  // which an emulator can disguise.
  pub machine_arch: string,
  pub translation: Translation,
}

// Whether capp-build runs under architecture translation.
pub enum Translation {
  Native,
  // Running under the named translator, e.g. "Rosetta 2".
  Translated(string),
  // Cannot be detected on this platform: on Linux, qemu-user reports the
  // emulated architecture, and nothing reliably reveals it to the process.
  Undetectable,
}

impl Host {
  // detect converts capp-parse's host facts, whose flags guard other fields.
  fn detect() -> Host {
    let f = host.Detect()
    let translation = match (f.TranslationKnown, f.Translated) {
      (false, _) => Translation.Undetectable,
      (true, true) => Translation.Translated(f.Translator),
      (true, false) => Translation.Native,
    }
    Host {
      os: f.OS,
      os_name: f.OSName,
      os_version: f.OSVersion,
      binary_arch: f.BinaryArch,
      machine_arch: f.HostArch,
      translation,
    }
  }
}

// ---------------------------------------------------------------------------
// capp-build's own build facts
// ---------------------------------------------------------------------------

pub struct BuildFacts {
  pub version: string,
  pub go_version: string,
  pub commit: string,
  pub commit_time: string,
  // The binary was built from a working tree with uncommitted changes.
  pub modified: bool,
}

// collect_build_facts reads capp-build's own version and the Go build
// information recorded in the binary.
fn collect_build_facts(version: string) -> BuildFacts {
  let settings = debug.ReadBuildInfo().map_or([], |info| info.Settings)
  BuildFacts {
    version,
    go_version: runtime.Version(),
    commit: build_setting(settings, "vcs.revision"),
    commit_time: build_setting(settings, "vcs.time"),
    modified: build_setting(settings, "vcs.modified") == "true",
  }
}

fn build_setting(settings: Slice<debug.BuildSetting>, key: string) -> string {
  settings.find(|s| s.Key == key).map_or("", |s| s.Value)
}
