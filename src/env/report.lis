//
// Renders the Environment gathered by survey() (env.lis) as text or JSON.
//
// The text report is for people: a user reading it, or pasting it into a
// support request. The JSON report carries the same facts for scripts and
// other tools, and is the form to attach when a support request is filed by
// a tool rather than by hand. Its field names are a published format; change
// them only deliberately.
//
// Rendering decides nothing: which library is in use, and what state each
// library is in, are already facts in the Environment.
// **
import "go:encoding/json"
import "go:fmt"
import "go:path/filepath"

// ---------------------------------------------------------------------------
// Text
// ---------------------------------------------------------------------------

// The sections of the text report, printed in declaration order. Adding a
// variant without an arm in print() is a compile error.
#[iterate]
enum Section {
  CappBuild,
  Host,
  Grammar,
}

impl Section {
  fn print(self, e: Environment) {
    match self {
      CappBuild => print_build(e.build),
      Host => print_host(e.host),
      Grammar => print_grammar(e.grammar),
    }
  }
}

// print_text implements `capp-build env`.
pub fn print_text(version: string, grammar_override: string) {
  let e = survey(version, grammar_override)
  for (i, section) in Section.variants().enumerate() {
    if i > 0 { fmt.Println("") }
    section.print(e)
  }
}

fn print_build(b: BuildFacts) {
  fmt.Println("capp-build")
  row("version", b.version)
  if b.commit != "" {
    let dirty = if b.modified { "  (uncommitted changes)" } else { "" }
    row("commit", f"{b.commit}  {b.commit_time}{dirty}")
  }
  row("go", b.go_version)
}

fn print_host(h: Host) {
  fmt.Println("host")
  row("os", f"{h.os_name} {h.os_version}")
  row("binary", f"{h.os}/{h.binary_arch}")
  row("machine", h.machine_arch)
  let translation = match h.translation {
    Translation.Native => "none",
    Translation.Translated(translator) => f"{translator}: not supported",
    Translation.Undetectable => "not detectable on this platform",
  }
  row("translation", translation)
}

fn print_grammar(g: GrammarSearch) {
  fmt.Println(
    f"grammar  (minimum release {Release.minimum().display()}; the first library found is used)",
  )
  if let Some(finding) = g.override {
    fmt.Println("  --grammar override")
    print_finding(finding, g.in_use)
  }
  for (i, loc) in g.locations.enumerate() {
    fmt.Println(f"  {i + 1}. {pad(loc.scope.display(), 10)} {loc.dir}")
    for finding in loc.findings {
      print_finding(finding, g.in_use)
    }
  }
  if g.in_use.is_none() {
    fmt.Println("")
    fmt.Println("  no grammar library found")
  }
}

fn print_finding(finding: Finding, in_use: Option<string>) {
  let marker = if is_in_use(finding, in_use) { ", in use" } else { "" }
  let name = finding.library_path().map_or("", filepath.Base)
  let indent = "                "
  match finding {
    Finding.Absent => fmt.Println(f"{indent}no library"),
    Finding.LoadFailed { file, failure, .. } => {
      fmt.Println(f"{indent}{name}: cannot load{marker}")
      detail("reason", failure.describe())
      if let Some(f) = file { print_file(f) }
    },
    Finding.Outdated { file, versions, unmet, .. } => {
      fmt.Println(f"{indent}{name}: outdated{marker}")
      detail("reason", unmet.explain(versions))
      print_versions(versions)
      print_file(file)
    },
    Finding.Supported { file, versions, .. } => {
      fmt.Println(f"{indent}{name}: supported{marker}")
      print_versions(versions)
      print_file(file)
    },
  }
}

fn print_versions(v: Versions) {
  detail("release", v.release.map_or("none", |r| r.display()))
  detail("build", v.build.unwrap_or("none"))
  detail("abi", f"{v.abi}")
}

fn print_file(file: FileFacts) {
  detail("size", f"{file.size} bytes")
  detail("modified", file.modified)
  detail("sha256", file.sha256)
}

fn row(label: string, value: string) {
  fmt.Println(f"  {pad(label, 12)} {value}")
}

fn detail(label: string, value: string) {
  fmt.Println(f"                  {pad(label, 9)} {value}")
}

fn pad(s: string, width: int) -> string {
  let mut out = s
  while out.length() < width {
    out += " "
  }
  out
}

fn is_in_use(finding: Finding, in_use: Option<string>) -> bool {
  match (finding.library_path(), in_use) {
    (Some(path), Some(used)) => path == used,
    _ => false,
  }
}

// ---------------------------------------------------------------------------
// JSON
// ---------------------------------------------------------------------------

#[json]
pub struct JsonReport {
  pub capp_build: JsonBuild,
  pub host: JsonHost,
  pub grammar: JsonGrammar,
}

#[json]
pub struct JsonBuild {
  pub version: string,
  pub commit: string,
  pub commit_time: string,
  pub modified: bool,
  pub go_version: string,
}

#[json]
pub struct JsonHost {
  pub os: string,
  pub os_name: string,
  pub os_version: string,
  pub binary_arch: string,
  pub host_arch: string,
  pub translation_known: bool,
  pub translated: bool,
  pub translator: string,
}

#[json]
pub struct JsonGrammar {
  pub minimum_release: string,
  pub override: Option<JsonLibrary>,
  pub locations: Slice<JsonLocation>,
}

#[json]
pub struct JsonLocation {
  pub dir: string,
  pub scope: string,
  // Empty when the location holds no library.
  pub libraries: Slice<JsonLibrary>,
}

#[json]
pub struct JsonLibrary {
  pub path: string,
  // "supported", "outdated" or "load_failed"
  pub state: string,
  pub in_use: bool,
  pub reason: string,
  pub has_release: bool,
  pub release: string,
  pub has_build: bool,
  pub build: string,
  pub abi_version: int,
  pub size: int,
  pub modified: string,
  pub sha256: string,
}

// print_json implements `capp-build env --json`.
pub fn print_json(version: string, grammar_override: string) {
  match json.MarshalIndent(
    json_report(survey(version, grammar_override)),
    "",
    "  ",
  ) {
    Ok(out) => fmt.Println(out as string),
    Err(e) => fmt.Println(f"error: {e}"),
  }
}

fn json_report(e: Environment) -> JsonReport {
  let g = e.grammar
  JsonReport {
    capp_build: JsonBuild {
      version: e.build.version,
      commit: e.build.commit,
      commit_time: e.build.commit_time,
      modified: e.build.modified,
      go_version: e.build.go_version,
    },
    host: json_host(e.host),
    grammar: JsonGrammar {
      minimum_release: Release.minimum().display(),
      override: g.override.and_then(|finding| json_library(finding, g.in_use)),
      locations: g.locations.map(|loc| JsonLocation {
        dir: loc.dir,
        scope: loc.scope.display(),
        libraries: loc.findings.fold(
          [],
          |libs: Slice<JsonLibrary>, finding: Finding| json_library(
              finding,
              g.in_use,
            ).map_or(
            libs,
            |lib| libs.append(lib),
          ),
        ),
      }),
    },
  }
}

fn json_host(h: Host) -> JsonHost {
  let base = JsonHost {
    os: h.os,
    os_name: h.os_name,
    os_version: h.os_version,
    binary_arch: h.binary_arch,
    host_arch: h.machine_arch,
    ..,
  }
  match h.translation {
    Translation.Native => JsonHost { translation_known: true, ..base },
    Translation.Translated(translator) => JsonHost {
      translation_known: true,
      translated: true,
      translator,
      ..base,
    },
    Translation.Undetectable => base,
  }
}

// json_library converts one finding; Absent has no library to convert.
fn json_library(finding: Finding, in_use: Option<string>) -> Option<JsonLibrary> {
  let path = finding.library_path()?
  let base = JsonLibrary { path, in_use: is_in_use(finding, in_use), .. }
  let lib = match finding {
    Finding.Absent => base,
    Finding.LoadFailed { file, failure, .. } => with_file(
      JsonLibrary { state: "load_failed", reason: failure.describe(), ..base },
      file,
    ),
    Finding.Outdated { file, versions, unmet, .. } => with_file(
      with_versions(
        JsonLibrary {
          state: "outdated",
          reason: unmet.explain(versions),
          ..base,
        },
        versions,
      ),
      Some(file),
    ),
    Finding.Supported { file, versions, .. } => with_file(
      with_versions(JsonLibrary { state: "supported", ..base }, versions),
      Some(file),
    ),
  }
  Some(lib)
}

fn with_versions(lib: JsonLibrary, v: Versions) -> JsonLibrary {
  JsonLibrary {
    has_release: v.release.is_some(),
    release: v.release.map_or("", |r| r.display()),
    has_build: v.build.is_some(),
    build: v.build.unwrap_or(""),
    abi_version: v.abi,
    ..lib,
  }
}

fn with_file(lib: JsonLibrary, file: Option<FileFacts>) -> JsonLibrary {
  file.map_or(lib, |f| JsonLibrary {
    size: f.size,
    modified: f.modified,
    sha256: f.sha256,
    ..lib,
  })
}
